{
  "id": "title",
  "name": "Benchmark Launcher",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "heading",
      "rect": {
        "x": 4,
        "y": 2,
        "w": 24,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "THESTRA SCENE LAB"
        }
      ]
    },
    {
      "id": "benchmarks",
      "rect": {
        "x": 6,
        "y": 7,
        "w": 20,
        "h": 9
      },
      "style": "list",
      "visibleRows": 3,
      "content": [
        {
          "type": "list",
          "listId": "term:title.options",
          "cursor": "v.idx"
        }
      ]
    },
    {
      "id": "help_primary",
      "rect": {
        "x": 4,
        "y": 17,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Arrows choose   Enter play"
        }
      ]
    },
    {
      "id": "help_back",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B returns from a specimen"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "idx",
            "value": 1
          },
          {
            "name": "_guard",
            "value": 0
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "idx",
        "value": "v.idx == 1 and 8 or v.idx - 1"
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "idx",
        "value": "v.idx == 8 and 1 or v.idx + 1"
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "a003_snake"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 2",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "d002_sokoban"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 8",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "QUIT_GAME"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 4",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "b001_fishing"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 3",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "d003_breakout_rpg"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 5",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "a001_pong"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 6",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "b002_argument"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 7",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "a002_breakout"
          }
        ]
      },
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      }
    ]
  },
  "config": {}
}