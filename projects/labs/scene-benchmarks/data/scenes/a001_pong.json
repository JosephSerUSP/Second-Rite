{
  "id": "a001_pong",
  "name": "A001 — Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 5,
        "y": 1,
        "w": 22,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "A001 — Pong   Score: {sceneState.scoreLeft} - {sceneState.scoreRight}"
        }
      ]
    },
    {
      "id": "board_outline",
      "rect": {
        "x": 5,
        "y": 5,
        "w": 22,
        "h": 15
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "paddleLeft",
      "rect": {
        "x": "5 + 1",
        "y": "5 + 1 + sceneState.paddleLeftY",
        "w": 1,
        "h": "sceneState.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddleRight",
      "rect": {
        "x": "5 + sceneState.gridW",
        "y": "5 + 1 + sceneState.paddleRightY",
        "w": 1,
        "h": "sceneState.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball",
      "rect": {
        "x": "5 + 1 + sceneState.ballX",
        "y": "5 + 1 + sceneState.ballY",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "UP/DOWN move   Enter restart   B back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "gridW",
            "value": 20
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddleH",
            "value": 3
          },
          {
            "name": "scoreLeft",
            "value": 0
          },
          {
            "name": "scoreRight",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "trigger",
        "event": "reset_round"
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "paddleLeftY",
            "value": "max(0, min(sceneState.gridH - sceneState.paddleH, sceneState.paddleLeftY + sceneState.inputY * 15.0 * sceneState.time.dt))"
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "aiCenter",
            "value": "sceneState.paddleRightY + sceneState.paddleH / 2"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.aiCenter < sceneState.ballY - 0.5",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "paddleRightY",
            "value": "min(sceneState.gridH - sceneState.paddleH, sceneState.paddleRightY + 8.0 * sceneState.time.dt)"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.aiCenter > sceneState.ballY + 0.5",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "paddleRightY",
            "value": "max(0, sceneState.paddleRightY - 8.0 * sceneState.time.dt)"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ballX",
            "value": "sceneState.ballX + sceneState.ballVX * sceneState.time.dt"
          },
          {
            "name": "ballY",
            "value": "sceneState.ballY + sceneState.ballVY * sceneState.time.dt"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ballY <= 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ballY",
                "value": 0
              },
              {
                "name": "ballVY",
                "value": "-sceneState.ballVY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ballY >= sceneState.gridH - 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ballY",
                "value": "sceneState.gridH - 1"
              },
              {
                "name": "ballVY",
                "value": "-sceneState.ballVY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ballX <= 1 and sceneState.ballX >= 0 and sceneState.ballVX < 0 and sceneState.ballY >= sceneState.paddleLeftY and sceneState.ballY <= sceneState.paddleLeftY + sceneState.paddleH",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ballX",
                "value": 1
              },
              {
                "name": "ballVX",
                "value": "-sceneState.ballVX * 1.1"
              },
              {
                "name": "ballVY",
                "value": "sceneState.ballVY + (sceneState.ballY - (sceneState.paddleLeftY + sceneState.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ballX >= sceneState.gridW - 2 and sceneState.ballX <= sceneState.gridW - 1 and sceneState.ballVX > 0 and sceneState.ballY >= sceneState.paddleRightY and sceneState.ballY <= sceneState.paddleRightY + sceneState.paddleH",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ballX",
                "value": "sceneState.gridW - 2"
              },
              {
                "name": "ballVX",
                "value": "-sceneState.ballVX * 1.1"
              },
              {
                "name": "ballVY",
                "value": "sceneState.ballVY + (sceneState.ballY - (sceneState.paddleRightY + sceneState.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ballX < 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "scoreRight",
            "value": "sceneState.scoreRight + 1"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "trigger",
            "event": "reset_round"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ballX >= sceneState.gridW",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "scoreLeft",
            "value": "sceneState.scoreLeft + 1"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "trigger",
            "event": "reset_round"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "scoreLeft",
            "value": 0
          },
          {
            "name": "scoreRight",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "trigger",
        "event": "reset_round"
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "reset_round": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "paddleLeftY",
            "value": 6
          },
          {
            "name": "paddleRightY",
            "value": 6
          },
          {
            "name": "ballX",
            "value": 10
          },
          {
            "name": "ballY",
            "value": 6
          },
          {
            "name": "ballVX",
            "value": "sceneState.scoreLeft > sceneState.scoreRight and 10 or -10"
          },
          {
            "name": "ballVY",
            "value": 6
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ]
  },
  "scripts": {},
  "goldenScript": [
    {
      "key": "down"
    },
    {
      "key": "down"
    },
    {
      "key": "up"
    },
    {
      "key": "return"
    },
    {
      "key": "escape"
    }
  ]
}