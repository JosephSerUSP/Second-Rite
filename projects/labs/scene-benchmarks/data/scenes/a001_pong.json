{
  "id": "a001_pong",
  "name": "A001 \u2014 Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 5,
        "y": 1,
        "w": 22,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "A001 \u2014 Pong   Score: {sceneState.score1} - {sceneState.score2}"
        }
      ]
    },
    {
      "id": "board_outline",
      "rect": {
        "x": 5,
        "y": 5,
        "w": 22,
        "h": 15
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "paddle1",
      "rect": {
        "x": "5 + 1",
        "y": "5 + 1 + sceneState.paddle1Y",
        "w": 1,
        "h": "sceneState.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle2",
      "rect": {
        "x": "5 + sceneState.gridW",
        "y": "5 + 1 + sceneState.paddle2Y",
        "w": 1,
        "h": "sceneState.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball",
      "rect": {
        "x": "5 + 1 + sceneState.ballX",
        "y": "5 + 1 + sceneState.ballY",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "UP/DOWN move   Enter restart   B back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "_guard",
            "value": "0"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "gridW",
            "value": "20"
          },
          {
            "name": "gridH",
            "value": "13"
          },
          {
            "name": "paddle1Y",
            "value": "6"
          },
          {
            "name": "paddle2Y",
            "value": "6"
          },
          {
            "name": "paddleH",
            "value": "3"
          },
          {
            "name": "ballX",
            "value": "10"
          },
          {
            "name": "ballY",
            "value": "6"
          },
          {
            "name": "ballVX",
            "value": "-10"
          },
          {
            "name": "ballVY",
            "value": "6"
          },
          {
            "name": "score1",
            "value": "sceneState.score1 or 0"
          },
          {
            "name": "score2",
            "value": "sceneState.score2 or 0"
          },
          {
            "name": "inputY",
            "value": "0"
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "nbx",
            "value": "sceneState.ballX + sceneState.ballVX * v.time.dt"
          },
          {
            "name": "nby",
            "value": "sceneState.ballY + sceneState.ballVY * v.time.dt"
          },
          {
            "name": "hit_top",
            "value": "v.nby <= 0"
          },
          {
            "name": "hit_bot",
            "value": "v.nby >= sceneState.gridH - 1"
          },
          {
            "name": "p1_hit",
            "value": "v.nbx <= 1 and v.nbx >= 0 and sceneState.ballVX < 0 and v.nby >= sceneState.paddle1Y and v.nby <= sceneState.paddle1Y + sceneState.paddleH"
          },
          {
            "name": "p2_hit",
            "value": "v.nbx >= sceneState.gridW - 2 and v.nbx <= sceneState.gridW - 1 and sceneState.ballVX > 0 and v.nby >= sceneState.paddle2Y and v.nby <= sceneState.paddle2Y + sceneState.paddleH"
          },
          {
            "name": "score2_hit",
            "value": "v.nbx < 0"
          },
          {
            "name": "score1_hit",
            "value": "v.nbx >= sceneState.gridW"
          },
          {
            "name": "center2",
            "value": "sceneState.paddle2Y + sceneState.paddleH / 2"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "paddle1Y",
            "value": "clamp(sceneState.paddle1Y + sceneState.inputY * 15 * v.time.dt, 0, sceneState.gridH - sceneState.paddleH)"
          },
          {
            "name": "inputY",
            "value": "0"
          },
          {
            "name": "paddle2Y",
            "value": "clamp(v.center2 < sceneState.ballY - 0.5 and sceneState.paddle2Y + 8 * v.time.dt or (v.center2 > sceneState.ballY + 0.5 and sceneState.paddle2Y - 8 * v.time.dt or sceneState.paddle2Y), 0, sceneState.gridH - sceneState.paddleH)"
          },
          {
            "name": "score1",
            "value": "sceneState.score1 + (v.score1_hit and 1 or 0)"
          },
          {
            "name": "score2",
            "value": "sceneState.score2 + (v.score2_hit and 1 or 0)"
          },
          {
            "name": "ballVY",
            "value": "(v.score1_hit or v.score2_hit) and 6 or (v.hit_top and abs(sceneState.ballVY) or (v.hit_bot and -abs(sceneState.ballVY) or (v.p1_hit and (sceneState.ballVY + (v.nby - (sceneState.paddle1Y + sceneState.paddleH/2)) * 2) or (v.p2_hit and (sceneState.ballVY + (v.nby - (sceneState.paddle2Y + sceneState.paddleH/2)) * 2) or sceneState.ballVY))))"
          },
          {
            "name": "ballVX",
            "value": "v.score1_hit and -10 or (v.score2_hit and 10 or (v.p1_hit and abs(sceneState.ballVX)*1.1 or (v.p2_hit and -abs(sceneState.ballVX)*1.1 or sceneState.ballVX)))"
          },
          {
            "name": "ballX",
            "value": "(v.score1_hit or v.score2_hit) and 10 or (v.p1_hit and 1 or (v.p2_hit and sceneState.gridW - 2 or v.nbx))"
          },
          {
            "name": "ballY",
            "value": "(v.score1_hit or v.score2_hit) and 6 or (v.hit_top and 0 or (v.hit_bot and sceneState.gridH - 1 or v.nby))"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputY",
        "value": "-1"
      }
    ],
    "on_down": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputY",
        "value": "1"
      }
    ],
    "on_select": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "gridW",
            "value": "20"
          },
          {
            "name": "gridH",
            "value": "13"
          },
          {
            "name": "paddle1Y",
            "value": "6"
          },
          {
            "name": "paddle2Y",
            "value": "6"
          },
          {
            "name": "paddleH",
            "value": "3"
          },
          {
            "name": "ballX",
            "value": "10"
          },
          {
            "name": "ballY",
            "value": "6"
          },
          {
            "name": "ballVX",
            "value": "10"
          },
          {
            "name": "ballVY",
            "value": "6"
          },
          {
            "name": "score1",
            "value": "sceneState.score1 or 0"
          },
          {
            "name": "score2",
            "value": "sceneState.score2 or 0"
          },
          {
            "name": "inputY",
            "value": "0"
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {},
  "goldenScript": [
    {
      "key": "down",
      "wait": 0.5
    },
    {
      "key": "down",
      "wait": 0.5
    },
    {
      "key": "up",
      "wait": 0.5
    },
    {
      "key": "return",
      "wait": 1.0
    },
    {
      "key": "escape",
      "wait": 0.5
    }
  ],
  "terminal": {
    "none": "spec requires scoring, reset after score and a restartable lifecycle, but no match-win threshold: an endless rally is the authored contract, and reset is a mid-game transition rather than a terminal state"
  }
}