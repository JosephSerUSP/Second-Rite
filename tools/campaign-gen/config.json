{
  "providers": {
    "openrouter": {
      "label": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "type": "openai-compatible",
      "default": true
    },
    "deepseek": {
      "label": "DeepSeek",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "type": "openai-compatible"
    },
    "gemini": {
      "label": "Gemini",
      "apiKeyEnv": "GEMINI_API_KEY",
      "type": "gemini"
    }
  },
  "stages": {
    "plan": {
      "model": "deepseek/deepseek-chat",
      "temperature": 0.6,
      "note": "Capabilities and sparse game grammar planning."
    },
    "ruleset": {
      "model": "deepseek/deepseek-chat",
      "temperature": 0.5,
      "note": "Authors only the Project-owned rule resources required by the plan."
    },
    "outline": {
      "model": "deepseek/deepseek-chat",
      "temperature": 0.9,
      "note": "Creative walkthrough/content stage; game shape comes from the generated plan and ruleset."
    },
    "units": { "model": "deepseek/deepseek-chat", "temperature": 0.7 },
    "items": { "model": "deepseek/deepseek-chat", "temperature": 0.7 },
    "quests": { "model": "deepseek/deepseek-chat", "temperature": 0.7 },
    "maps": { "model": "deepseek/deepseek-chat", "temperature": 0.7 },
    "events": { "model": "deepseek/deepseek-chat", "temperature": 0.8 },
    "startup": {
      "model": "deepseek/deepseek-chat",
      "temperature": 0.5,
      "note": "Authors Project identity/startup/Scenes after content ids are known."
    },
    "repair": {
      "model": "deepseek/deepseek-chat",
      "temperature": 0.2,
      "note": "Fed validator failures verbatim; low temperature, Project-only mechanical fixes."
    }
  },
  "validate": {
    "lovecPath": "C:\\Program Files\\LOVE\\lovec.exe",
    "maxRepairRounds": 4
  }
}
