{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../../shared/semantics",
    "outDir": "../../engine/generated",
    "types": []
  },
  "include": ["../../shared/semantics/*.ts"],
  "tstl": {
    "luaTarget": "JIT",
    "luaLibImport": "inline",
    "sourceMapTraceback": true,
    "noImplicitSelf": true
  }
}
