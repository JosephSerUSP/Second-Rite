            "value": "sceneState.score2 or 0"
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "paddle1Y",
            "value": "max(0, min(sceneState.gridH - sceneState.paddleH, sceneState.paddle1Y + sceneState.inputY * 15.0 * time.dt))"
          },
          {
            "name": "inputY",
            "value": 0
          },
          {
            "name": "targetBallY",
            "value": "sceneState.ball3Active > 0 and sceneState.ball3Y or (sceneState.ball2Active > 0 and sceneState.ball2Y or sceneState.ball1Y)"
          },
          {
            "name": "center2",
            "value": "sceneState.paddle2Y + sceneState.paddleH / 2"
          },
          {
            "name": "paddle2Y",
            "value": "sceneState.center2 < sceneState.targetBallY - 0.5 and sceneState.paddle2Y + 8.0 * time.dt or (sceneState.center2 > sceneState.targetBallY + 0.5 and sceneState.paddle2Y - 8.0 * time.dt or sceneState.paddle2Y)"
          },
          {
            "name": "paddle2Y",
            "value": "max(0, min(sceneState.gridH - sceneState.paddleH, sceneState.paddle2Y))"
          },
          {
            "name": "ball1X",
            "value": "sceneState.ball1X + sceneState.ball1VX * time.dt"
          },
          {
            "name": "ball1Y",
            "value": "sceneState.ball1Y + sceneState.ball1VY * time.dt"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball2Active > 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball2X",
                "value": "sceneState.ball2X + sceneState.ball2VX * time.dt"
              },
              {
                "name": "ball2Y",
                "value": "sceneState.ball2Y + sceneState.ball2VY * time.dt"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball3Active > 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball3X",
                "value": "sceneState.ball3X + sceneState.ball3VX * time.dt"
              },
              {
                "name": "ball3Y",
                "value": "sceneState.ball3Y + sceneState.ball3VY * time.dt"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball1Y <= 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball1Y",
                "value": 0
              },
              {
                "name": "ball1VY",
                "value": "-sceneState.ball1VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball1Y >= sceneState.gridH - 1",
