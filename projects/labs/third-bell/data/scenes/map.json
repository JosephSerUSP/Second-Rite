      {
        "cmd": "IF",
        "condition": "v.mode == 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "cmdIdx",
            "value": "v.cmdIdx < 4 and v.cmdIdx + 1 or 1"
          },
          {
            "cmd": "SET_CURSOR",
            "windowId": "battle_command",
            "index": "v.cmdIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 4 and v.partyIdx + 2 <= 4",
