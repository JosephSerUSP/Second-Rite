  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "name": "step",
        "value": -1
      },
      {
        "cmd": "SET_VAR",
        "name": "idx",
        "value": 1
      },
      {
        "cmd": "SET_SUBTRACTIVE_FADE",
        "amount": 1
      },
      {
        "cmd": "SHOW_IMAGE_PICTURE",
        "id": 20,
        "path": "assets/cinematics/game_over_talisman_psx.png",
        "x": 128,
        "y": 130,
        "anchor": "center",
        "opacity": 1,
        "scale": 1,
        "layer": "backdrop"
      },
      {
        "cmd": "MOVE_IMAGE_PICTURE",
        "id": 20,
        "x": 128,
        "y": 120,
        "duration": 7.5,
        "easing": "linear"
      },
      {
        "cmd": "SET_SUBTRACTIVE_FADE",
        "amount": 0,
        "duration": 1.2,
        "easing": "smooth"
      },
      {
        "cmd": "WAIT",
        "duration": 0.8
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.step == -1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_VAR",
            "name": "step",
            "value": 0
          },
          {
            "cmd": "WAIT",
            "duration": 1.1
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.step == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_VAR",
            "name": "step",
            "value": 1
          },
          {
            "cmd": "WAIT",
            "duration": 1.1
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.step == 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_VAR",
            "name": "step",
            "value": 2
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "v.step == 2",
        "then": [
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "goto",
            "scene": "title"
          }
        ]
      }
    ],
    "on_exit": [
      {
        "cmd": "ERASE_ALL_IMAGE_PICTURES"
      },
      {
        "cmd": "SET_SUBTRACTIVE_FADE",
        "amount": 0
      }
    ]
  },
  "config": {},
  "windows": [
    {
      "id": "game_over_frame",
      "rect": {
        "x": 5,
        "y": 6,
        "w": 22,
        "h": 5
      },
      "style": "frame",
      "anim": {
        "open": {
          "duration": 0.45
        }
      },
      "visible": "v.step >= 0",
      "content": [
        {
          "type": "text",
          "text": "GAME OVER"
        }
      ]
    },
    {
      "id": "game_over_message",
      "rect": {
        "x": 3,
        "y": 12,
        "w": 26,
        "h": 4
      },
      "style": "frame",
      "anim": {
        "open": {
          "duration": 0.3
        }
      },
      "visible": "v.step >= 1",
      "content": [
        {
          "type": "text",
          "text": "The party has fallen.\nTheir expedition ends here."
        }
      ]
    },
    {
      "id": "game_over_menu",
      "rect": {
        "x": 8,
        "y": 18,
        "w": 16,
        "h": 4
      },
      "style": "list",
      "anim": {
        "open": {
          "duration": 0.25
        }
      },
      "visible": "v.step >= 2",
      "content": [
        {
          "type": "list",
          "listId": "static:Return to Title",
          "cursor": "1"
        }
      ]
    }
  ]
}
