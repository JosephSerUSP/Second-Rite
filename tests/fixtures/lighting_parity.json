{
  "tolerance": 1e-8,
  "orientationFactors": {
    "floor": 1.0,
    "front-wall": 1.0,
    "side-wall": 0.76
  },
  "cases": [
    {
      "name": "default ambient without sources",
      "rows": ["..", ".."],
      "sources": [],
      "samples": [
        { "x": 0, "y": 0, "expect": [0.12, 0.12, 0.12] },
        { "x": 2, "y": 2, "expect": [0.12, 0.12, 0.12] }
      ]
    },
    {
      "name": "custom ambient without sources",
      "rows": ["..", ".."],
      "ambient": [0.2, 0.3, 0.4],
      "sources": [],
      "samples": [
        { "x": 1, "y": 1, "expect": [0.2, 0.3, 0.4] },
        { "x": 2, "y": 0, "expect": [0.2, 0.3, 0.4] }
      ]
    },
    {
      "name": "one colored source",
      "rows": ["...", "...", "..."],
      "sources": [
        { "x": 1, "y": 1, "radius": 2.5, "falloff": 2, "color": [0.8, 0.4, 0.2] }
      ],
      "samples": [
        { "x": 1, "y": 1, "expect": [0.53145166, 0.32572583, 0.222862915] },
        { "x": 0, "y": 0, "expect": [0.13835498, 0.12917749, 0.124588745] }
      ],
      "surfaceSamples": [
        { "x": 1, "y": 1, "faceRole": "floor", "expect": [0.53145166, 0.32572583, 0.222862915] },
        { "x": 1, "y": 1, "faceRole": "front-wall", "expect": [0.53145166, 0.32572583, 0.222862915] },
        { "x": 1, "y": 1, "faceRole": "side-wall", "expect": [0.4039032616, 0.2475516308, 0.1693758154] }
      ]
    },
    {
      "name": "linear falloff",
      "rows": ["...", "...", "..."],
      "sources": [
        { "x": 1, "y": 1, "radius": 3, "falloff": 1, "color": [1, 0.5, 0.25] }
      ],
      "samples": [
        { "x": 1, "y": 1, "expect": [0.88429774, 0.50214887, 0.311074435] },
        { "x": 0, "y": 0, "expect": [0.412893219, 0.266446609, 0.193223305] }
      ]
    },
    {
      "name": "quadratic falloff",
      "rows": ["...", "...", "..."],
      "sources": [
        { "x": 1, "y": 1, "radius": 3, "falloff": 2, "color": [1, 0.5, 0.25] }
      ],
      "samples": [
        { "x": 1, "y": 1, "expect": [0.704151035, 0.412075517, 0.266037759] },
        { "x": 0, "y": 0, "expect": [0.205786438, 0.162893219, 0.141446609] }
      ]
    },
    {
      "name": "overlap clamps at one",
      "rows": ["...", "...", "..."],
      "sources": [
        { "x": 0, "y": 0, "radius": 4, "falloff": 1, "color": [1, 1, 1] },
        { "x": 2, "y": 2, "radius": 4, "falloff": 1, "color": [1, 1, 1] }
      ],
      "samples": [
        { "x": 1, "y": 1, "expect": [1, 1, 1] },
        { "x": 0, "y": 0, "expect": [1, 1, 1] },
        { "x": 3, "y": 0, "expect": [0.845245122, 0.845245122, 0.845245122] }
      ]
    },
    {
      "name": "source near bounds",
      "rows": ["..", ".."],
      "sources": [
        { "x": 0, "y": 0, "radius": 2, "falloff": 2, "color": [0.5, 0.7, 1] }
      ],
      "samples": [
        { "x": 0, "y": 0, "expect": [0.328946609, 0.412525253, 0.537893219] },
        { "x": 2, "y": 2, "expect": [0.12, 0.12, 0.12] }
      ]
    },
    {
      "name": "wall occlusion",
      "rows": ["...", ".#.", "..."],
      "sources": [
        { "x": 0, "y": 1, "radius": 4, "falloff": 1, "color": [1, 0.5, 0.25] }
      ],
      "samples": [
        { "x": 1, "y": 1, "expect": [0.943223305, 0.531611652, 0.325805826] },
        { "x": 3, "y": 1, "expect": [0.12, 0.12, 0.12] }
      ]
    }
  ]
}
