{
  "id": "title",
  "terminal": {
    "none": "benchmark launcher menu: a dispatch surface into the specimens, with no loop of its own to finish"
  },
  "name": "Benchmark Launcher",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "heading",
      "rect": {
        "x": 4,
        "y": 2,
        "w": 24,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "THESTRA SCENE LAB"
        }
      ]
    },
    {
      "id": "benchmarks",
      "rect": {
        "x": 6,
        "y": 7,
        "w": 20,
        "h": 9
      },
      "style": "list",
      "visibleRows": 3,
      "content": [
        {
          "type": "list",
          "listId": "term:title.options",
          "cursor": "sceneState.idx"
        }
      ]
    },
    {
      "id": "help_primary",
      "rect": {
        "x": 4,
        "y": 17,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Arrows choose   Enter play"
        }
      ]
    },
    {
      "id": "help_back",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B returns from a specimen"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "idx",
            "value": 1
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "_guard",
            "value": 0
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "idx",
        "value": "sceneState.idx == 1 and 16 or sceneState.idx - 1"
      }
    ],
    "on_down": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "idx",
        "value": "sceneState.idx == 16 and 1 or sceneState.idx + 1"
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "a003_snake"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 2",
