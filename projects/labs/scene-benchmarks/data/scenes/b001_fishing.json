        "y": 17,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Hold ENTER to reel  B back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SCRIPT",
        "ref": "init"
      }
    ],
    "on_frame": [
      {
        "cmd": "SCRIPT",
        "ref": "update"
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {
    "init": "local sceneState = ctx.sceneState; sceneState.tension = 50; sceneState.progress = 0; sceneState.fish_pull = 0; sceneState.tension_text = 'OK'; sceneState.state = 'fishing'; sceneState.timer = 0;",
    "update": "local sceneState = ctx.sceneState; if sceneState.state ~= 'fishing' then return end; local dt = sceneState.time.dt; sceneState.timer = sceneState.timer + dt; if sceneState.timer > 1.0 then sceneState.fish_pull = math.random(-20, 30); sceneState.timer = 0 end; local input_pull = 0; if _G.love.keyboard.isDown('return') then input_pull = 25 end; sceneState.tension = sceneState.tension + (sceneState.fish_pull + input_pull) * dt; if sceneState.tension < 0 then sceneState.tension = 0 elseif sceneState.tension > 100 then sceneState.tension = 100 end; if sceneState.tension > 20 and sceneState.tension < 80 then sceneState.progress = sceneState.progress + 10 * dt else sceneState.progress = sceneState.progress - 5 * dt end; if sceneState.progress < 0 then sceneState.progress = 0 elseif sceneState.progress >= 100 then sceneState.progress = 100; sceneState.state = 'caught'; sceneState.tension_text = 'CAUGHT!' return end; if sceneState.tension >= 100 then sceneState.state = 'snapped'; sceneState.tension_text = 'LINE SNAPPED!' return end; if sceneState.tension <= 0 then sceneState.state = 'escaped'; sceneState.tension_text = 'FISH ESCAPED!' return end;"
  }
}