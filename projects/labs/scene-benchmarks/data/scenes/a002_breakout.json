{
  "id": "a002_breakout",
  "name": "A002 Breakout Benchmark",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "terminal": {
    "reached": "sceneState.gameOver == true or sceneState.gameWon == true"
  },
  "windows": [
    {
      "id": "header",
      "rect": {
        "x": 1,
        "y": 1,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Breakout   Score: {sceneState.score}"
        }
      ]
    },
    {
      "id": "playfield",
      "rect": {
        "x": 1,
        "y": 5,
        "w": 28,
        "h": 16
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.renderedField}"
        }
      ]
    },
    {
      "id": "controls",
      "rect": {
        "x": 1,
        "y": 22,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "LEFT/RIGHT: Move   Enter: Restart   B: Exit"
        }
      ]
    },
    {
      "id": "paddle_win",
      "rect": {
        "x": "1 + 1 + sceneState.padX",
        "y": "5 + 1 + sceneState.padY",
        "w": "sceneState.padW",
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "====="
        }
      ]
    },
    {
      "id": "ball_win",
      "rect": {
        "x": "1 + 1 + sceneState.ballX",
        "y": "5 + 1 + sceneState.ballY",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "_guard",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "fieldW",
            "value": 26
          },
          {
            "name": "fieldH",
            "value": 14
          },
          {
            "name": "padW",
            "value": 5
          },
          {
            "name": "padX",
            "value": 10
          },
          {
            "name": "padY",
            "value": 13
          },
          {
            "name": "ballX",
            "value": 12
          },
          {
            "name": "ballY",
            "value": 13.5
          },
          {
            "name": "ballVX",
            "value": 8
          },
          {
            "name": "ballVY",
            "value": 10
          },
          {
            "name": "score",
            "value": 0
          },
          {
            "name": "moveInput",
            "value": 0
          },
          {
            "name": "renderedField",
            "value": "''"
          },
          {
            "name": "gameOver",
            "value": "false"
          },
          {
            "name": "gameWon",
            "value": "false"
          }
        ]
      },
      {
        "cmd": "SCRIPT",
        "ref": "setup_bricks"
      }
    ],
    "on_select": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "fieldW",
            "value": 26
          },
          {
            "name": "fieldH",
            "value": 14
          },
          {
            "name": "padW",
            "value": 5
          },
          {
            "name": "padX",
            "value": 10
          },
          {
            "name": "padY",
            "value": 13
          },
          {
            "name": "ballX",
            "value": 12
          },
          {
            "name": "ballY",
            "value": 13.5
          },
          {
            "name": "ballVX",
            "value": 8
          },
          {
            "name": "ballVY",
            "value": 10
          },
          {
            "name": "score",
            "value": 0
          },
          {
            "name": "moveInput",
            "value": 0
          },
          {
            "name": "renderedField",
            "value": "''"
          },
          {
            "name": "gameOver",
            "value": "false"
          },
          {
            "name": "gameWon",
            "value": "false"
          }
        ]
      },
      {
        "cmd": "SCRIPT",
        "ref": "setup_bricks"
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "sceneState.gameOver == false and sceneState.gameWon == false",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "padX",
                "value": "clamp(sceneState.padX + sceneState.moveInput * 18.0 * sceneState.time.dt, 0, sceneState.fieldW - sceneState.padW)"
              },
              {
                "name": "moveInput",
                "value": 0
              },
              {
                "name": "ballX",
                "value": "sceneState.ballX + sceneState.ballVX * sceneState.time.dt"
              },
              {
                "name": "ballY",
                "value": "sceneState.ballY + sceneState.ballVY * sceneState.time.dt"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballX <= 0 or sceneState.ballX >= sceneState.fieldW - 1",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballX",
                    "value": "clamp(sceneState.ballX, 0, sceneState.fieldW - 1)"
                  },
                  {
                    "name": "ballVX",
                    "value": "-sceneState.ballVX"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": 0
                  },
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.fieldH",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "gameOver",
                "value": "true"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.padY - 0.5 and sceneState.ballY <= sceneState.padY + 0.5 and sceneState.ballVY > 0 and sceneState.ballX >= sceneState.padX - 0.5 and sceneState.ballX <= sceneState.padX + sceneState.padW - 0.5",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": "sceneState.padY - 0.5"
                  },
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  },
                  {
                    "name": "ballVX",
                    "value": "sceneState.ballVX + ((sceneState.ballX - (sceneState.padX + sceneState.padW / 2)) / (sceneState.padW / 2)) * 6.0"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SCRIPT",
            "ref": "process_bricks"
          }
        ]
      }
    ],
    "on_left": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "moveInput",
        "value": -1
      }
    ],
    "on_right": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "moveInput",
        "value": 1
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {
    "setup_bricks": "\nlocal sceneState = ctx.sceneState\nsceneState.bricks = {}\nfor y = 1, 4 do\n    for x = 2, sceneState.fieldW - 3 do\n        table.insert(sceneState.bricks, {x=x, y=y, intact=true})\n    end\nend\n",
    "process_bricks": "\nlocal sceneState = ctx.sceneState\nlocal bx, by = math.floor(sceneState.ballX + 0.5), math.floor(sceneState.ballY + 0.5)\nlocal count = 0\nfor i, b in ipairs(sceneState.bricks) do\n    if b.intact then\n        count = count + 1\n        if bx == b.x and by == b.y then\n            b.intact = false\n            sceneState.score = sceneState.score + 10\n            sceneState.ballVY = -sceneState.ballVY\n            break\n        end\n    end\nend\nif count == 0 then sceneState.gameWon = true end\n\nlocal out = \"\"\nfor y = 0, sceneState.fieldH - 1 do\n    for x = 0, sceneState.fieldW - 1 do\n        local c = \" \"\n        for i, b in ipairs(sceneState.bricks) do\n            if b.intact and b.x == x and b.y == y then\n                c = \"#\"\n                break\n            end\n        end\n        out = out .. c\n    end\n    out = out .. \"\\n\"\nend\nif sceneState.gameOver then out = out .. \"GAME OVER\\n\" end\nif sceneState.gameWon then out = out .. \"YOU WIN!\\n\" end\nsceneState.renderedField = out\n"
  },
  "goldenScript": [
    "wait 1",
    "wait 2"
  ]
}
