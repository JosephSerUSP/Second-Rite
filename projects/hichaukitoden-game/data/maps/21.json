                                      "cmd": "TEXT"
                                    },
                                    {
                                      "options": [
                                        {
                                          "label": "You're welcome.",
                                          "commands": [
                                            {
                                              "text": "(She gives you a genuine, heartfelt smile.)",
                                              "speaker": "Alicia",
                                              "cmd": "TEXT"
                                            }
                                          ]
                                        },
