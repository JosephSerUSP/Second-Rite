      {
        "key": "return"
      }
    ]
  },
  "name": "B005 \u2014 Lockpicking",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 4,
        "y": 2,
        "w": 24,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B005 \u2014 Lockpicking"
        }
      ]
    },
    {
      "id": "board",
      "rect": {
        "x": 2,
        "y": 7,
        "w": 28,
        "h": 8
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.display_text}"
        },
        {
          "type": "text",
          "y": 2,
          "text": "Pins Picked: {sceneState.pins_picked} / {sceneState.total_pins}"
        },
        {
          "type": "text",
          "y": 4,
          "text": "{sceneState.status_text}"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 4,
        "y": 17,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "A (Enter) pick   B (Escape) back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "state",
        "value": "'picking'"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "pins_picked",
        "value": "0"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "total_pins",
        "value": "3"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "cursor_pos",
        "value": "0"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "cursor_dir",
        "value": "1"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "cursor_speed",
        "value": "30"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "sweet_spot_start",
        "value": "20"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "sweet_spot_width",
        "value": "15"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "display_text",
        "value": "''"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "status_text",
        "value": "'Press ENTER in the sweet spot!'"
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "sceneState.state == 'picking'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cursor_pos",
            "value": "sceneState.cursor_pos + (sceneState.cursor_speed * sceneState.cursor_dir * (sceneState.time and sceneState.time.dt or (1/60)))"
          },
          {
            "cmd": "IF",
            "condition": "sceneState.cursor_pos > 100",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursor_pos",
                "value": "100"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursor_dir",
                "value": "-1"
              }
            ],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.cursor_pos < 0",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "cursor_pos",
                    "value": "0"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "cursor_dir",
                    "value": "1"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SCRIPT",
            "ref": "render"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.state ~= 'picking'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "state",
            "value": "'picking'"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "pins_picked",
            "value": "0"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cursor_speed",
            "value": "30"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "sweet_spot_start",
            "value": "20"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "status_text",
            "value": "'Press ENTER in the sweet spot!'"
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.cursor_pos >= sceneState.sweet_spot_start and sceneState.cursor_pos <= sceneState.sweet_spot_start + sceneState.sweet_spot_width",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "pins_picked",
                "value": "sceneState.pins_picked + 1"
              },
              {
                "cmd": "IF",
                "condition": "sceneState.pins_picked >= sceneState.total_pins",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "state",
                    "value": "'won'"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "status_text",
                    "value": "'LOCK PICKED! Press ENTER to replay.'"
                  }
                ],
                "else": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "status_text",
                    "value": "'Pin set!'"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "cursor_speed",
                    "value": "sceneState.cursor_speed + 15"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "sweet_spot_start",
                    "value": "math.random(10, 70)"
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "state",
                "value": "'failed'"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "status_text",
                "value": "'FAILED! Pick broke. Press ENTER to retry.'"
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {
    "render": "local sceneState = ctx.sceneState\nlocal text = '['\nfor i = 1, 20 do\n    local p_start = (i - 1) * 5\n    local p_end = i * 5\n    local isSweet = (p_end >= sceneState.sweet_spot_start and p_start <= sceneState.sweet_spot_start + sceneState.sweet_spot_width)\n    local isNeedle = (sceneState.cursor_pos >= p_start and sceneState.cursor_pos < p_end)\n    if i == 20 and sceneState.cursor_pos >= 100 then isNeedle = true end\n    if isNeedle and isSweet then text = text .. '+'\n    elseif isNeedle then text = text .. '|'\n    elseif isSweet then text = text .. '='\n    else text = text .. '-' end\nend\ntext = text .. ']'\nsceneState.display_text = text"
  }
}