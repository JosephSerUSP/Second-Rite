  "boss_red_dragon": {
    "id": "boss_red_dragon",
    "name": "Boss: Red Dragon",
    "description": "Strata 1 climax: a multi-phase Red Dragon at level 10, designed to reach Battle Strain. Tests affinity preparation (bring Blue), MPD budgeting (can you afford the return trip after a 10-round fight?), and the decision to retreat. At level 10 with growth band 1 fully applied: roughly 189 HP, 61 ATK, 50 MAT, 46 DEF. Four authored phases escalate pressure until ending the fight quickly becomes existentially important.",
    "members": [
      {
        "actor": "red_dragon",
        "level": 10
      }
    ],
    "events": [
      {
        "id": "dragon_roar",
        "at": "battle_start",
        "once": true,
        "commands": [
          {
            "cmd": "EMIT_TEXT",
            "fallback": "The Red Dragon roars! Heat distorts the air around it!"
          },
          {
            "cmd": "SCREEN_EFFECT",
            "effect": "shake",
            "power": 4,
            "duration": 40
          }
        ]
      },
      {
        "id": "phase2_heat",
        "at": "after_action",
        "once": true,
        "when": "enemy.hpRate <= 0.6",
        "commands": [
          {
            "cmd": "EMIT_TEXT",
            "fallback": "The dragon's scales glow white-hot! Waves of heat wash over your party!"
          },
          {
            "cmd": "SCREEN_EFFECT",
            "effect": "flash",
            "color": [
              220,
              60,
              20
            ],
            "power": 3,
            "duration": 30
          },
          {
            "cmd": "FOR_EACH",
            "scope": "living_allies",
            "as": "ally",
            "do": [
              {
                "cmd": "DAMAGE",
                "target": "ally",
                "amount": "max(1, floor(ally.maxHp * 0.08))",
                "pierce": true,
                "minHp": 1
              }
            ]
          }
        ]
      },
      {
        "id": "strain_warn_5",
        "at": "round_start",
        "once": true,
        "when": "battle.round == 5",
        "commands": [
          {
            "cmd": "EMIT_TEXT",
            "fallback": "The summoning begins to strain. Prolonged rounds will consume MP."
          }
        ]
      },
      {
        "id": "strain_warn_6",
        "at": "round_start",
        "once": true,
        "when": "battle.round == 6",
        "commands": [
          {
            "cmd": "EMIT_TEXT",
            "fallback": "Strain next round: 4 × party MPD"
          }
        ]
      },
      {
        "id": "strain_warn_10",
        "at": "round_start",
        "once": true,
        "when": "battle.round == 10",
        "commands": [
          {
            "cmd": "EMIT_TEXT",
            "fallback": "Strain intensifies: 8 × party MPD"
          }
        ]
      },
      {
        "id": "phase3_fury",
        "at": "after_action",
        "once": true,
        "when": "enemy.hpRate <= 0.3",
        "commands": [
          {
            "cmd": "EMIT_TEXT",
            "fallback": "The dragon shrieks in fury! Its flames intensify beyond control!"
          },
          {
            "cmd": "SCREEN_EFFECT",
            "effect": "shake",
            "power": 6,
            "duration": 60
          },
          {
            "cmd": "CHANGE_PARAM",
            "target": "enemy",
            "param": "atk",
            "operation": "addRate",
            "value": "0.20"
          },
          {
            "cmd": "CHANGE_PARAM",
            "target": "enemy",
            "param": "mat",
            "operation": "addRate",
            "value": "0.25"
          }
        ]
      }
    ]
  },
