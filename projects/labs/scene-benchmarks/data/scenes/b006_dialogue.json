{
  "id": "b006_dialogue",
  "terminal": {
    "none": "portrait/message staging probe, not a loop with an outcome"
  },
  "name": "B006 — Dialogue Portrait Stage",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "dialogue",
      "rect": {
        "x": 1,
        "y": 18,
        "w": 30,
        "h": 6
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.speakerName}"
        },
        {
          "type": "text",
          "y": 2,
          "text": "{sceneState.dialogueText}"
        }
      ]
    },
    {
      "id": "choices",
      "rect": {
        "x": 18,
        "y": 12,
        "w": 13,
        "h": 5
      },
      "style": "list",
      "visibleRows": 3,
      "condition": "sceneState.showChoices == 1",
      "content": [
        {
          "type": "list",
          "listId": "term:b006.options",
          "cursor": "sceneState.choiceIdx"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "step",
            "value": 1
          },
          {
            "name": "choiceIdx",
            "value": 1
          },
          {
            "name": "showChoices",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "_guard",
            "value": 0
          }
        ]
      },
      {

        "cmd": "COMMENT",

        "text": "Legacy scene hook update_step remains quarantined under #919."
      }
    ],
    "update_step": [
      {
        "cmd": "IF",
        "condition": "sceneState.step == 1",
        "then": [
          {
            "cmd": "SHOW_IMAGE_PICTURE",
            "id": 1,
            "path": "assets/b006_celina.png",
            "x": 60,
            "y": 100,
            "anchor": "center",
            "scale": 1,
            "opacity": 1,
            "layer": "screen"
          },
          {
            "cmd": "SHOW_IMAGE_PICTURE",
            "id": 2,
            "path": "assets/b006_merchant.png",
            "x": 260,
            "y": 100,
            "anchor": "center",
            "scale": 1,
            "opacity": 0.5,
            "layer": "screen"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "speakerName",
            "value": "'Celina'"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "dialogueText",
            "value": "'Welcome to the Dialogue Portrait Stage. We are testing image picture manipulation.'"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.step == 2",
        "then": [
          {
            "cmd": "MOVE_IMAGE_PICTURE",
            "id": 1,
            "opacity": 0.5,
            "duration": 0.3
          },
          {
            "cmd": "MOVE_IMAGE_PICTURE",
            "id": 2,
            "opacity": 1,
            "scale": 1.2,
            "y": 90,
            "duration": 0.3
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "speakerName",
            "value": "'Merchant'"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "dialogueText",
            "value": "'Indeed. Notice how I move forward and come into focus when I speak.'"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.step == 3",
        "then": [
          {
            "cmd": "MOVE_IMAGE_PICTURE",
            "id": 1,
            "opacity": 1,
            "x": 80,
            "duration": 0.5,
            "easing": "out"
          },
          {
            "cmd": "MOVE_IMAGE_PICTURE",
            "id": 2,
            "opacity": 0.5,
            "scale": 1,
            "y": 100,
            "x": 280,
            "duration": 0.5
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "speakerName",
            "value": "'Celina'"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "dialogueText",
            "value": "'And we can both shift positions smoothly. How should we proceed?'"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "showChoices",
            "value": 1
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.step == 4",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "showChoices",
            "value": 0
          },
          {
            "cmd": "MOVE_IMAGE_PICTURE",
            "id": 1,
            "opacity": 0,
            "x": 40,
            "duration": 0.5
          },
          {
            "cmd": "MOVE_IMAGE_PICTURE",
            "id": 2,
            "opacity": 0,
            "x": 300,
            "duration": 0.5
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "speakerName",
            "value": "''"
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "dialogueText",
            "value": "'(They depart, concluding the demonstration.)'"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.step > 4",
        "then": [
          {
            "cmd": "ERASE_IMAGE_PICTURE",
            "id": 1
          },
          {
            "cmd": "ERASE_IMAGE_PICTURE",
            "id": 2
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.showChoices == 0",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "step",
            "value": "sceneState.step + 1"
          },
          {

            "cmd": "COMMENT",

            "text": "Legacy scene hook update_step remains quarantined under #919."
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.showChoices == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "step",
            "value": "4"
          },
          {

            "cmd": "COMMENT",

            "text": "Legacy scene hook update_step remains quarantined under #919."
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "name": "_guard",
        "value": 0
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.showChoices == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "choiceIdx",
            "value": "sceneState.choiceIdx == 1 and 2 or sceneState.choiceIdx - 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.showChoices == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "choiceIdx",
            "value": "sceneState.choiceIdx == 2 and 1 or sceneState.choiceIdx + 1"
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "ERASE_IMAGE_PICTURE",
        "id": 1
      },
      {
        "cmd": "ERASE_IMAGE_PICTURE",
        "id": 2
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "config": {}
}