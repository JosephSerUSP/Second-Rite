  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "win",
            "value": "false"
          },
          {
            "name": "px",
            "value": "4"
          },
          {
            "name": "py",
            "value": "4"
          },
          {
            "name": "c1x",
            "value": "3"
          },
          {
            "name": "c1y",
            "value": "3"
          },
          {
            "name": "c2x",
            "value": "5"
          },
          {
            "name": "c2y",
            "value": "4"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "IF",
        "condition": "not v.win",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "nx",
                "value": "v.px + (0)"
              },
              {
                "name": "ny",
                "value": "v.py + (-1)"
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "isWall",
                "value": "(v.nx < 0) or (v.nx > 7) or (v.ny < 0) or (v.ny > 7) or (v.ny == 0) or (v.ny == 7) or (v.nx == 0) or (v.nx == 7) or ((v.nx == 2) and (v.ny == 2)) or ((v.nx == 3) and (v.ny == 2)) or ((v.nx == 4) and (v.ny == 2)) or ((v.nx == 5) and (v.ny == 3)) or ((v.nx == 1) and (v.ny == 4)) or ((v.nx == 2) and (v.ny == 4)) or ((v.nx == 3) and (v.ny == 5)) or ((v.nx == 5) and (v.ny == 6)) or ((v.nx == 6) and (v.ny == 6))"
              },
              {
                "name": "isCrate1",
                "value": "v.nx == v.c1x and v.ny == v.c1y"
              },
              {
                "name": "isCrate2",
                "value": "v.nx == v.c2x and v.ny == v.c2y"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "not v.isWall",
            "then": [
              {
                "cmd": "IF",
                "condition": "v.isCrate1",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      {
                        "name": "nnx",
                        "value": "v.nx + (0)"
                      },
                      {
                        "name": "nny",
                        "value": "v.ny + (-1)"
                      }
                    ]
                  },
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      {
                        "name": "nnWall",
                        "value": "(v.nnx < 0) or (v.nnx > 7) or (v.nny < 0) or (v.nny > 7) or (v.nny == 0) or (v.nny == 7) or (v.nnx == 0) or (v.nnx == 7) or ((v.nnx == 2) and (v.nny == 2)) or ((v.nnx == 3) and (v.nny == 2)) or ((v.nnx == 4) and (v.nny == 2)) or ((v.nnx == 5) and (v.nny == 3)) or ((v.nnx == 1) and (v.nny == 4)) or ((v.nnx == 2) and (v.nny == 4)) or ((v.nnx == 3) and (v.nny == 5)) or ((v.nnx == 5) and (v.nny == 6)) or ((v.nnx == 6) and (v.nny == 6))"
                      },
                      {
                        "name": "nnCrate2",
                        "value": "v.nnx == v.c2x and v.nny == v.c2y"
                      }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "not v.nnWall and not v.nnCrate2",
                    "then": [
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          {
                            "name": "c1x",
                            "value": "v.nnx"
                          },
                          {
                            "name": "c1y",
                            "value": "v.nny"
                          },
                          {
                            "name": "px",
                            "value": "v.nx"
                          },
                          {
                            "name": "py",
                            "value": "v.ny"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "cmd": "IF",
                    "condition": "v.isCrate2",
                    "then": [
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          {
                            "name": "nnx",
                            "value": "v.nx + (0)"
                          },
                          {
                            "name": "nny",
                            "value": "v.ny + (-1)"
                          }
                        ]
                      },
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          {
                            "name": "nnWall",
                            "value": "(v.nnx < 0) or (v.nnx > 7) or (v.nny < 0) or (v.nny > 7) or (v.nny == 0) or (v.nny == 7) or (v.nnx == 0) or (v.nnx == 7) or ((v.nnx == 2) and (v.nny == 2)) or ((v.nnx == 3) and (v.nny == 2)) or ((v.nnx == 4) and (v.nny == 2)) or ((v.nnx == 5) and (v.nny == 3)) or ((v.nnx == 1) and (v.nny == 4)) or ((v.nnx == 2) and (v.nny == 4)) or ((v.nnx == 3) and (v.nny == 5)) or ((v.nnx == 5) and (v.nny == 6)) or ((v.nnx == 6) and (v.nny == 6))"
                          },
                          {
                            "name": "nnCrate1",
                            "value": "v.nnx == v.c1x and v.nny == v.c1y"
                          }
                        ]
                      },
                      {
                        "cmd": "IF",
                        "condition": "not v.nnWall and not v.nnCrate1",
                        "then": [
                          {
                            "cmd": "SET_VAR",
                            "assignments": [
                              {
                                "name": "c2x",
                                "value": "v.nnx"
                              },
                              {
                                "name": "c2y",
                                "value": "v.nny"
                              },
                              {
                                "name": "px",
                                "value": "v.nx"
                              },
                              {
                                "name": "py",
                                "value": "v.ny"
                              }
                            ]
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          {
                            "name": "px",
                            "value": "v.nx"
                          },
                          {
                            "name": "py",
                            "value": "v.ny"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "c1OnGoal",
                "value": "(v.c1x == 3 and v.c1y == 1) or (v.c1x == 2 and v.c1y == 5)"
              },
              {
                "name": "c2OnGoal",
                "value": "(v.c2x == 3 and v.c2y == 1) or (v.c2x == 2 and v.c2y == 5)"
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "win",
                "value": "v.c1OnGoal and v.c2OnGoal"
              }
            ]
          }
        ]
      }
    ],
