          "commands": [
            {
              "cmd": "TEXT",
              "text": "You emerged from the Labyrinth gate at sunrise."
            },
            {
              "cmd": "TEXT",
              "text": "Alicia met you with warm bread; Laura nodded from the open forge; Celina stamped your ledger with a single gold seal: 'RETURNED WITH COMPANIONS.'"
            },
            {
              "cmd": "TEXT",
              "text": "Yukio watched from the parapet, counting Saban's steady footsteps in silence."
            },
            {
              "cmd": "TEXT",
              "text": "You and Saban shared breakfast in Room 3 as the autumn rain softly fell over St. Maria."
            }
          ],
          "elseCommands": [
            {
              "condition": "flag:ending_second_rite",
              "commands": [
                {
                  "cmd": "TEXT",
                  "text": "You crossed beyond the mortal boundary into the Great Weave of the Gate."
                },
                {
                  "cmd": "TEXT",
                  "text": "In St. Maria, the third bell sounded one last time before falling silent forever."
                },
                {
                  "cmd": "TEXT",
                  "text": "Sister Agnes lit the lantern marked THESTRA in the chapel, where it burns with steady, undying flame."
                }
              ],
              "elseCommands": [
