{
  "id": "b009_positioning",
  "terminal": {
    "reached": "sceneState.ehp <= 0"
  },
  "name": "B009 — Parasite-Eve-Like Positioning Proof",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B009 — Positioning Proof   State: {sceneState.stateText}"
        }
      ]
    },
    {
      "id": "arena",
      "rect": {
        "x": 2,
        "y": 4,
        "w": 28,
        "h": 16
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "player",
      "rect": {
        "x": "2 + 1 + sceneState.px",
        "y": "4 + 1 + sceneState.py",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "@"
        }
      ]
    },
    {
      "id": "enemy",
      "rect": {
        "x": "2 + 1 + sceneState.ex",
        "y": "4 + 1 + sceneState.ey",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "E"
        }
      ]
    },
    {
      "id": "target_area",
      "rect": {
        "x": "2 + 1 + sceneState.px - sceneState.range",
        "y": "4 + 1 + sceneState.py - sceneState.range",
        "w": "sceneState.range * 2 + 1",
        "h": "sceneState.range * 2 + 1"
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "atb_gauge",
      "rect": {
        "x": 2,
        "y": 20,
        "w": 14,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 12,
          "label": "ATB",
          "value": "sceneState.atb",
          "max": "100",
          "color": [
            0.2,
            0.2,
            0.2
          ],
          "fill": [
            0,
            1,
            0
          ]
        }
      ]
    },
    {
      "id": "hp_gauge",
      "rect": {
        "x": 16,
        "y": 20,
        "w": 14,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 12,
          "label": "Enemy HP",
          "value": "sceneState.ehp",
          "max": "100",
          "color": [
            0.2,
            0.2,
            0.2
          ],
          "fill": [
            1,
            0,
            0
          ]
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SCRIPT",
        "ref": "init"
      }
    ],
    "on_frame": [
      {
        "cmd": "SCRIPT",
        "ref": "update"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "inputX",
            "value": 0
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_left": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputX",
        "value": -1
      }
    ],
    "on_right": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputX",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "SCRIPT",
        "ref": "action"
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {
    "init": "local sceneState = ctx.sceneState; sceneState.px = 10; sceneState.py = 10; sceneState.ex = 20; sceneState.ey = 5; sceneState.atb = 0; sceneState.ehp = 100; sceneState.stateText = 'Moving'; sceneState.range = 5; sceneState.speed = 10.0; sceneState.mode = 'move'; sceneState.actionTimer = 0; sceneState.inputX = 0; sceneState.inputY = 0;",
    "update": "local sceneState = ctx.sceneState; local dt = sceneState.time.dt; if sceneState.mode == 'move' then sceneState.atb = math.min(100, sceneState.atb + 20 * dt); sceneState.px = math.max(0, math.min(25, sceneState.px + sceneState.inputX * sceneState.speed * dt)); sceneState.py = math.max(0, math.min(13, sceneState.py + sceneState.inputY * sceneState.speed * dt)); else sceneState.actionTimer = sceneState.actionTimer - dt; if sceneState.actionTimer <= 0 then sceneState.mode = 'move'; sceneState.stateText = 'Moving' end end; if sceneState.ehp <= 0 then sceneState.stateText = 'VICTORY!' end",
    "action": "local sceneState = ctx.sceneState; if sceneState.mode == 'move' and sceneState.atb >= 100 then sceneState.mode = 'action'; sceneState.atb = 0; sceneState.actionTimer = 1.0; sceneState.stateText = 'Action Phase!'; local dist = math.abs(sceneState.px - sceneState.ex) + math.abs(sceneState.py - sceneState.ey); if dist <= sceneState.range then sceneState.ehp = math.max(0, sceneState.ehp - 30); sceneState.stateText = 'HIT!' else sceneState.stateText = 'MISSED! (Out of range)' end end"
  },
