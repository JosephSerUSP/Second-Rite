    "snapPartyIdx": "\nlocal v = ctx.v\nfor i = 1, 4 do\n    local m = api.party(i)\n    if m then\n        v.partyIdx = i\n        break\n    end\nend\n",
    "selectPartyMember": "\nlocal v = ctx.v\nlocal member = api.party(v.partyIdx)\nif member then\n    v._guard = 1\n    v.mode = 2\n    v.memberIdx = v.partyIdx\n    v.popupIdx = 1\n    api.emit({ type = \"open_window\", windowId = \"map_member_popup\" })\n    api.emit({ type = \"set_list\", windowId = \"map_member_popup\", listId = \"config:unitCommands\" })\n    api.emit({ type = \"set_cursor\", windowId = \"map_member_popup\", index = v.popupIdx })\nend\n",
    "pushStatus": "\nlocal v = ctx.v\nif v.memberIdx then\n    api.emit({ type = \"scene_change\", kind = \"push\", scene = \"status\", vars = { idx = v.memberIdx } })\nend\n"
