{
  "version": 1,
  "id": "serving_corner_reference",
  "room": {"half_width": 3.8, "depth": 6.8, "ceiling_z": 3.7},
  "shell": [
    {"call": "floor", "params": {"mat": {"material": "terracotta"}}},
    {"call": "back_wall", "params": {"openings": [[-0.3, 1.3, 1.45, 2.75]]}},
    {"call": "side_walls"},
    {"call": "ceiling", "params": {"beams": 5}},
    {"call": "window", "args": [-0.3, 1.3, 1.45, 2.75]},
    {"call": "exit_threshold", "args": [-3.15]},
    {"call": "window_light", "args": [0.5, 2.1]}
  ],
  "keepClear": {"exit_sightline": [[-1.6, -3.9, 0.05], [0.1, -2.4, 1.8]]},
  "furnishings": [
    {"id": "counter", "builder": "counter", "params": {"length": 3.6, "panels": 4, "top_mat": {"material": "old_limestone"}}, "place": {"at": [0.5, -0.5]}},
    {"id": "bread", "builder": "bread_basket", "params": {"radius": 0.26}, "place": {"on": "counter", "offset": [0, 1.05]}},
    {"id": "scales", "builder": "scales", "place": {"on": "counter", "offset": [0, -1.1]}},
    {"id": "water", "builder": "water_stand", "place": {"beside": "counter", "axis": "x", "side": -1, "gap": 0.16}}
  ]
}
