{
  "id": "reserve",
  "name": "Reserve",
  "kind": "menu",
  "config": {
    "terms": {
      "title": "Expedition Reserve & Formation",
      "help": "Choose expedition party slots (1-2 Front, 3-4 Back) & reserve.  Arrows: move  ESC: back"
    }
  },
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "mode",
        "value": 1
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "cursorIdx",
        "value": 1
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "focusArea",
        "value": "'party'"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "statusText",
        "value": "''"
      },
      {
        "cmd": "SET_LOCAL",
        "name": "_guard",
        "value": 0
      }
    ],
    "on_left": [
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'party'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cursorIdx",
            "value": "sceneState.cursorIdx > 1 and sceneState.cursorIdx - 1 or sceneState.cursorIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'reserve'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cursorIdx",
            "value": "sceneState.cursorIdx > 1 and sceneState.cursorIdx - 1 or sceneState.cursorIdx"
          }
        ]
      }
    ],
    "on_right": [
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'party'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cursorIdx",
            "value": "sceneState.cursorIdx < 4 and sceneState.cursorIdx + 1 or sceneState.cursorIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'reserve'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cursorIdx",
            "value": "sceneState.cursorIdx < 4 and sceneState.cursorIdx + 1 or sceneState.cursorIdx"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'party'",
        "then": [
          {
            "cmd": "IF",
            "condition": "sceneState.cursorIdx > 2",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursorIdx",
                "value": "sceneState.cursorIdx - 2"
              }
            ],
            "else": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "focusArea",
                "value": "'reserve'"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursorIdx",
                "value": "sceneState.cursorIdx + 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'reserve'",
        "then": [
          {
            "cmd": "IF",
            "condition": "sceneState.cursorIdx > 2",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursorIdx",
                "value": "sceneState.cursorIdx - 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.mode == 2",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "popupIdx",
            "value": "sceneState.popupIdx > 1 and sceneState.popupIdx - 1 or sceneState.popupIdx"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'party'",
        "then": [
          {
            "cmd": "IF",
            "condition": "sceneState.cursorIdx <= 2",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursorIdx",
                "value": "sceneState.cursorIdx + 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'reserve'",
        "then": [
          {
            "cmd": "IF",
            "condition": "sceneState.cursorIdx <= 2",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursorIdx",
                "value": "sceneState.cursorIdx + 2"
              }
            ],
            "else": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "focusArea",
                "value": "'party'"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "cursorIdx",
                "value": "sceneState.cursorIdx - 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.mode == 2",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "popupIdx",
            "value": "sceneState.popupIdx < sceneState.popupCount and sceneState.popupIdx + 1 or sceneState.popupIdx"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.mode == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "mode",
            "value": 2
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "popupIdx",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "ref": "setupReservePopup"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.mode == 2",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "ref": "executeReservePopup"
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ritualPush == 'summon'",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "ritualPush",
                "value": "''"
              },
              {
                "cmd": "SCENE_EVENT",
                "kind": "push",
                "scene": "ritual",
                "sceneState": [
                  {
                    "name": "ritualMode",
                    "value": "'summon'"
                  },
                  {
                    "name": "targetIsReserve",
                    "value": "sceneState.popupTargetIsReserve"
                  },
                  {
                    "name": "targetIndex",
                    "value": "sceneState.popupTargetIndex"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ritualPush == 'promote'",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "ritualPush",
                "value": "''"
              },
              {
                "cmd": "SCENE_EVENT",
                "kind": "push",
                "scene": "ritual",
                "sceneState": [
                  {
                    "name": "ritualMode",
                    "value": "'promote'"
                  },
                  {
                    "name": "targetIsReserve",
                    "value": "sceneState.popupTargetIsReserve"
                  },
                  {
                    "name": "targetIndex",
                    "value": "sceneState.popupTargetIndex"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ritualPush == 'sacrifice'",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "ritualPush",
                "value": "''"
              },
              {
                "cmd": "SCENE_EVENT",
                "kind": "push",
                "scene": "ritual",
                "sceneState": [
                  {
                    "name": "ritualMode",
                    "value": "'sacrifice'"
                  },
                  {
                    "name": "targetIsReserve",
                    "value": "sceneState.popupTargetIsReserve"
                  },
                  {
                    "name": "targetIndex",
                    "value": "sceneState.popupTargetIndex"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.mode == 4",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "ref": "executeSwap"
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.mode == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.mode == 2",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "mode",
            "value": 1
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.mode == 4",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "mode",
            "value": 1
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_LOCAL",
        "name": "_guard",
        "value": 0
      }
    ]
  },
  "scripts": {
    "setupReservePopup": "\nlocal sceneState = ctx.sceneState\nlocal focusArea = sceneState.focusArea\nlocal cursorIdx = sceneState.cursorIdx\nlocal member = (focusArea == 'party') and api.party(cursorIdx) or api.reserve(cursorIdx)\nlocal options = {}\n\nif member and member.empty then member = nil end\n\nsceneState.popupTargetIsReserve = (focusArea == 'reserve')\nsceneState.popupTargetIndex = cursorIdx\nsceneState.popupMemberName = member and (member.name or \"Unknown\") or nil\nsceneState.popupMemberRef = member\n\n-- Summoning belongs to a town ritual site. Sacrifice is disabled while its\n-- inheritance-based replacement is designed. Expedition reserve only manages\n-- creatures the player already committed to bringing below.\ntable.insert(options, {name = \"Swap\"})\nif member and api.inDungeon() then\n    table.insert(options, {name = \"Dismiss\"})\nend\nif member and api.canPromote(sceneState.popupTargetIsReserve, sceneState.popupTargetIndex) then\n    table.insert(options, {name = \"Promote\"})\nend\ntable.insert(options, {name = \"Cancel\"})\n\nsceneState.popupCount = #options\nsceneState.popupOptions = options\n",
    "executeReservePopup": "\nlocal sceneState = ctx.sceneState\nlocal opt = sceneState.popupOptions[sceneState.popupIdx].name\nif opt == \"Cancel\" then\n    sceneState.mode = 1\n    api.emit({ type = \"close_window\", windowId = \"reserve_popup\" })\nelseif opt == \"Swap\" then\n    sceneState.mode = 4\n    sceneState.swapSourceIsReserve = sceneState.popupTargetIsReserve\n    sceneState.swapSourceIndex = sceneState.popupTargetIndex\n    sceneState.swapSourceFocus = sceneState.focusArea\n    api.emit({ type = \"close_window\", windowId = \"reserve_popup\" })\nelseif opt == \"Dismiss\" then\n    local member, result = api.dismissToStorage(sceneState.popupTargetIsReserve, sceneState.popupTargetIndex)\n    sceneState.mode = 1\n    api.emit({ type = \"close_window\", windowId = \"reserve_popup\" })\n    if member then\n        sceneState.statusText = member.name .. \" returned to town storage (slot \" .. result .. \").\"\n    else\n        sceneState.statusText = result or \"Dismissal failed.\"\n    end\nelseif opt == \"Promote\" then\n    sceneState.ritualPush = \"promote\"\n    sceneState.mode = 1\n    api.emit({ type = \"close_window\", windowId = \"reserve_popup\" })\nend\n",
    "executeSwap": "\nlocal sceneState = ctx.sceneState\napi.swap(sceneState.swapSourceIndex, sceneState.swapSourceIsReserve, sceneState.cursorIdx, sceneState.focusArea == 'reserve')\nif api.partyCount() <= 0 then\n    api.swap(sceneState.cursorIdx, sceneState.focusArea == 'reserve', sceneState.swapSourceIndex, sceneState.swapSourceIsReserve)\n    sceneState.statusText = \"Cannot leave the party empty!\"\n    sceneState.mode = 1\n    return\nend\nsceneState.mode = 1\nsceneState.statusText = \"\"\n"
  },
  "overlay": true,
  "draw": "windows",
  "backdrop": "map",
  "windows": [
    {
      "id": "help",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.mode == 4 and 'Select a target to swap with.  ESC: cancel' or ((sceneState.statusText and sceneState.statusText ~= '') and sceneState.statusText or config.terms.help)}"
        }
      ]
    },
    {
      "id": "reserve_party",
      "content": [
        {
          "type": "list",
          "listId": "party",
          "format": "{name}",
          "cursor": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'party' and sceneState.cursorIdx or 0"
        }
      ]
    },
    {
      "id": "reserve_roster",
      "content": [
        {
          "type": "list",
          "listId": "reserve",
          "format": "{name}",
          "cursor": "(sceneState.mode == 1 or sceneState.mode == 4) and sceneState.focusArea == 'reserve' and sceneState.cursorIdx or 0"
        }
      ]
    },
    {
      "id": "reserve_popup",
      "visible": "sceneState.mode == 2",
      "content": [
        {
          "type": "list",
          "listId": "sceneState:popupOptions",
          "format": "{name}",
          "cursor": "sceneState.popupIdx"
        }
      ]
    }
  ],
  "goldenScript": [
    {
      "key": "return"
    },
    {
      "key": "down"
    },
    {
      "key": "return"
    },
    {
      "key": "e"
    },
    {
      "key": "e"
    },
    {
      "key": "return"
    },
    {
      "key": "return"
    },
    {
      "key": "return"
    },
    {
      "key": "escape"
    }
  ]
}
