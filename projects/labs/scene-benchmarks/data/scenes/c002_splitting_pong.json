              },
              {
                "name": "ball2VY",
                "value": "-sceneState.ball2VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball3Active > 0 and sceneState.ball3Y <= 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
