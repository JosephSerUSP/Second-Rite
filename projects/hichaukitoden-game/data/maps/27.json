          "commands": [
            {
              "condition": "flag:shipment_investigated",
              "commands": [
                {
                  "commonEventId": 30,
                  "cmd": "CALL_COMMON_EVENT"
                }
              ],
              "elseCommands": [
                {
                  "text": "Oh! Are you looking for the supply cart? I heard it! I was listening to the wind near the chasm, and I heard squeaky wheels stop suddenly. Then... goblin noises. Lots of them.",
                  "speaker": "Alicia",
                  "cmd": "TEXT"
                },
                {
                  "options": [
                    {
                      "label": "Goblins? I should tell the guard.",
                      "commands": [
                        {
                          "flag": "shipment_investigated",
                          "value": true,
                          "cmd": "SET_FLAG"
                        },
                        {
                          "text": "Please be careful! If the goblins have the food, they'll be... energetic.",
                          "speaker": "Alicia",
                          "cmd": "TEXT"
                        },
                        {
                          "commonEventId": 30,
                          "cmd": "CALL_COMMON_EVENT"
                        }
                      ]
