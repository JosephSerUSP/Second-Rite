    {
      "name": "Ash Ledger",
      "label": "The Gray Ledger",
      "spawn": "Random",
      "sprite": "assets/sprites/dungeon_reliquary_drawers.png",
      "trigger": "bump",
      "wallEvent": true,
      "minimapColor": [
        0.82,
        0.62,
        0.3
      ],
      "commands": [
        {
          "cmd": "CONDITIONAL_BRANCH",
          "condition": "flag:ash_ledger_read",
          "commands": [
            {
              "cmd": "TEXT",
              "text": "The ledger is shut. The gray line on its cover now ends at your name."
            }
          ],
          "elseCommands": [
            {
              "cmd": "TEXT",
              "text": "A narrow ledger has been mortared into the wall. Its pages are packed with tiny charcoal marks."
            },
            {
              "cmd": "TEXT",
              "text": "The first page says ST. MARIA. The second page says SABAN. The third page is blank except for a place where a wet thumb has pressed through."
            },
            {
              "cmd": "CHOICE",
              "options": [
                {
                  "label": "Read the blank page.",
                  "commands": [
                    {
                      "cmd": "SET_FLAG",
                      "flag": "ash_ledger_read",
                      "value": true
                    },
                    {
                      "cmd": "CHANGE_ITEM",
                      "item": 195,
                      "count": 1
                    },
                    {
                      "cmd": "TEXT",
                      "text": "The page takes the heat from your fingers and leaves behind an Ether Seed. It is not a reward; it is an advance payment."
                    }
                  ]
                },
                {
                  "label": "Leave the page closed.",
                  "commands": [
                    {
                      "cmd": "SET_FLAG",
                      "flag": "ash_ledger_left",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Contract Knot",
      "label": "A Contract in the Seam",
      "spawn": "Random",
      "sprite": "assets/sprites/dungeon_summoner_contract.png",
      "trigger": "bump",
      "wallEvent": true,
      "minimapColor": [
        0.82,
        0.62,
        0.3
      ],
      "commands": [
        {
          "cmd": "CONDITIONAL_BRANCH",
          "condition": "flag:ash_contract_taken",
          "commands": [
            {
              "cmd": "TEXT",
              "text": "The seam is empty. A few green sparks still remember the shape of the creature you named."
            }
          ],
          "elseCommands": [
            {
              "cmd": "TEXT",
              "text": "A Pixie is wedged in a crack beside a contract knot. It watches Saban first, then your hand."
            },
            {
              "cmd": "TEXT",
              "text": "The knot is eager. Your MP is not infinite, and every new creature changes the price of walking home."
            },
            {
              "cmd": "CHOICE",
              "options": [
                {
                  "label": "Offer a contract.",
                  "commands": [
                    {
                      "cmd": "OPEN_RECRUIT",
                      "actorId": "pixie",
                      "level": 2,
                      "sourceKey": "ash_choir:pixie"
                    },
                    {
                      "cmd": "SET_FLAG",
                      "flag": "ash_contract_taken",
                      "value": true
                    },
                    {
                      "cmd": "TEXT",
                      "text": "The Pixie accepts. Its first act is to touch Saban's wing, as if checking that the older contract is still there."
                    }
                  ]
                },
                {
                  "label": "Leave the creature space.",
                  "commands": [
                    {
                      "cmd": "SET_FLAG",
                      "flag": "ash_contract_declined",
                      "value": true
                    },
                    {
                      "cmd": "TEXT",
                      "text": "The Pixie stays in the seam. The choice remains yours, even after you walk away."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
