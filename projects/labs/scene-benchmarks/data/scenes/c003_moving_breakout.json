{
  "id": "c003_moving_breakout",
  "name": "C003 — Moving Bricks",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "terminal": {
    "reached": "v.game_over == true or v.game_won == true"
  },
  "windows": [
    {
      "id": "header",
      "rect": { "x": 2, "y": 1, "w": 26, "h": 3 },
      "style": "frame",
      "content": [ { "type": "text", "text": "C003 - Moving Breakout  Score: {v.score}" } ]
    },
    {
      "id": "playfield",
      "rect": { "x": 2, "y": 5, "w": 26, "h": 16 },
      "style": "frame",
      "content": [ { "type": "text", "text": "{v.rendered_bricks}" } ]
    },
    {
      "id": "controls",
      "rect": { "x": 2, "y": 22, "w": 26, "h": 3 },
      "style": "frame",
      "content": [ { "type": "text", "text": "LEFT/RIGHT: Move   B: Exit" } ]
    },
    {
      "id": "paddle_win",
      "rect": { "x": "2 + 1 + v.pad_x", "y": "5 + 1 + v.pad_y", "w": "v.pad_w", "h": 1 },
      "style": "panel",
      "content": [ { "type": "text", "text": "=====" } ]
    },
    {
      "id": "ball_win",
      "rect": { "x": "2 + 1 + v.ball_x", "y": "5 + 1 + v.ball_y", "w": 1, "h": 1 },
      "style": "panel",
      "content": [ { "type": "text", "text": "O" } ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "field_w", "value": 24 },
          { "name": "field_h", "value": 14 },
          { "name": "pad_w", "value": 5 },
          { "name": "pad_x", "value": 10 },
          { "name": "pad_y", "value": 13 },
          { "name": "ball_x", "value": 12.0 },
          { "name": "ball_y", "value": 12.5 },
          { "name": "ball_vx", "value": 6.0 },
          { "name": "ball_vy", "value": -8.0 },
          { "name": "score", "value": 0 },
          { "name": "move_input", "value": 0 },
          { "name": "rendered_bricks", "value": "''" },
          { "name": "game_over", "value": false },
          { "name": "game_won", "value": false }
        ]
      },
      { "cmd": "SCRIPT", "ref": "init_bricks" }
    ],
    "on_select": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "field_w", "value": 24 },
          { "name": "field_h", "value": 14 },
          { "name": "pad_w", "value": 5 },
          { "name": "pad_x", "value": 10 },
          { "name": "pad_y", "value": 13 },
          { "name": "ball_x", "value": 12.0 },
          { "name": "ball_y", "value": 12.5 },
          { "name": "ball_vx", "value": 6.0 },
          { "name": "ball_vy", "value": -8.0 },
          { "name": "score", "value": 0 },
          { "name": "move_input", "value": 0 },
          { "name": "rendered_bricks", "value": "''" },
          { "name": "game_over", "value": false },
          { "name": "game_won", "value": false }
        ]
      },
      { "cmd": "SCRIPT", "ref": "init_bricks" }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v.game_over == false and v.game_won == false",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "pad_x", "value": "clamp(v.pad_x + v.move_input * 16.0 * v.time.dt, 0, v.field_w - v.pad_w)" },
              { "name": "move_input", "value": 0 },
              { "name": "ball_x", "value": "v.ball_x + v.ball_vx * v.time.dt" },
              { "name": "ball_y", "value": "v.ball_y + v.ball_vy * v.time.dt" }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ball_x <= 0 or v.ball_x >= v.field_w - 1",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  { "name": "ball_x", "value": "clamp(v.ball_x, 0, v.field_w - 1)" },
                  { "name": "ball_vx", "value": "-v.ball_vx" }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ball_y <= 0",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  { "name": "ball_y", "value": 0 },
                  { "name": "ball_vy", "value": "-v.ball_vy" }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ball_y >= v.field_h",
            "then": [ { "cmd": "SET_VAR", "name": "game_over", "value": true } ]
          },
          {
            "cmd": "IF",
            "condition": "v.ball_y >= v.pad_y - 0.5 and v.ball_y <= v.pad_y + 0.5 and v.ball_vy > 0 and v.ball_x >= v.pad_x - 0.5 and v.ball_x <= v.pad_x + v.pad_w - 0.5",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  { "name": "ball_y", "value": "v.pad_y - 0.5" },
                  { "name": "ball_vy", "value": "-v.ball_vy" },
                  { "name": "ball_vx", "value": "v.ball_vx + ((v.ball_x - (v.pad_x + v.pad_w / 2)) / (v.pad_w / 2)) * 6.0" }
                ]
              }
            ]
          },
          { "cmd": "SCRIPT", "ref": "update_bricks" }
        ]
      }
    ],
    "on_left": [ { "cmd": "SET_VAR", "name": "move_input", "value": -1 } ],
    "on_right": [ { "cmd": "SET_VAR", "name": "move_input", "value": 1 } ],
    "on_cancel": [ { "cmd": "SCENE_EVENT", "kind": "pop" } ]
  },
  "scripts": {
    "init_bricks": "\nlocal v = ctx.v\nv.bricks = {}\nv.brick_dir = 1\nv.brick_timer = 0\nfor y = 1, 3 do\n    for x = 3, v.field_w - 4 do\n        table.insert(v.bricks, {x=x, y=y, active=true})\n    end\nend\n",
    "update_bricks": "\nlocal v = ctx.v\nlocal hit_edge = false\n\nv.brick_timer = v.brick_timer + v.time.dt\nif v.brick_timer >= 1.0 then\n    v.brick_timer = 0\n    for _, b in ipairs(v.bricks) do\n        if b.active then\n            local next_x = b.x + v.brick_dir\n            if next_x < 1 or next_x >= v.field_w - 1 then\n                hit_edge = true\n                break\n            end\n        end\n    end\n\n    if hit_edge then\n        v.brick_dir = -v.brick_dir\n        for _, b in ipairs(v.bricks) do\n            if b.active then b.y = b.y + 1 end\n        end\n    else\n        for _, b in ipairs(v.bricks) do\n            if b.active then b.x = b.x + v.brick_dir end\n        end\n    end\nend\n\nlocal bx, by = math.floor(v.ball_x + 0.5), math.floor(v.ball_y + 0.5)\nlocal count = 0\nlocal lowest = 0\nfor _, b in ipairs(v.bricks) do\n    if b.active then\n        count = count + 1\n        if b.y > lowest then lowest = b.y end\n        if bx == b.x and by == b.y then\n            b.active = false\n            v.score = v.score + 10\n            v.ball_vy = -v.ball_vy\n            break\n        end\n    end\nend\n\nif count == 0 then v.game_won = true end\nif lowest >= v.pad_y then v.game_over = true end\n\nlocal out = \"\"\nfor y = 0, v.field_h - 1 do\n    for x = 0, v.field_w - 1 do\n        local char = \" \"\n        for _, b in ipairs(v.bricks) do\n            if b.active and b.x == x and b.y == y then\n                char = \"#\"\n                break\n            end\n        end\n        out = out .. char\n    end\n    out = out .. \"\\n\"\nend\n\nif v.game_over then out = out .. \"GAME OVER\\n\" end\nif v.game_won then out = out .. \"YOU WIN!\\n\" end\nv.rendered_bricks = out\n"
  },
