      { "cmd": "SET_VAR", "name": "c1x", "value": 3 },
      { "cmd": "SET_VAR", "name": "c1y", "value": 3 },
      { "cmd": "SET_VAR", "name": "c2x", "value": 5 },
      { "cmd": "SET_VAR", "name": "c2y", "value": 4 },
      { "cmd": "SCRIPT", "ref": "render" }
    ],
    "on_cancel": [ { "cmd": "SCENE_EVENT", "kind": "pop" } ]
  },
  "scripts": {
    "render": "\nlocal v = ctx.v\nlocal g1x, g1y = 3, 1\nlocal g2x, g2y = 2, 5\nlocal function isWall(x, y)\n    if x < 0 or x > 7 or y < 0 or y > 7 then return true end\n    if y == 0 or y == 7 then return true end\n    if x == 0 or x == 7 then return true end\n    if x == 2 and y == 2 then return true end\n    if x == 3 and y == 2 then return true end\n    if x == 4 and y == 2 then return true end\n    if x == 5 and y == 3 then return true end\n    if x == 1 and y == 4 then return true end\n    if x == 2 and y == 4 then return true end\n    if x == 3 and y == 5 then return true end\n    if x == 5 and y == 6 then return true end\n    if x == 6 and y == 6 then return true end\n    return false\nend\nlocal lines = {}\nfor y = 0, 7 do\n    local row = \"\"\n    for x = 0, 7 do\n        if x == v.px and y == v.py then\n            row = row .. \"@\"\n        elseif x == v.c1x and y == v.c1y then\n            row = row .. \"O\"\n        elseif x == v.c2x and y == v.c2y then\n            row = row .. \"O\"\n        elseif isWall(x, y) then\n            row = row .. \"#\"\n        elseif (x == g1x and y == g1y) or (x == g2x and y == g2y) then\n            row = row .. \".\"\n        else\n            row = row .. \" \"\n        end\n    end\n    table.insert(lines, row)\nend\nv.boardText = table.concat(lines, \"\\n\")\n"
  },
  "goldenScript": [
    { "key": "down" },
    { "key": "up" },
    { "key": "left" },
    { "key": "right" },
    { "key": "return" },
    { "key": "escape" }
  ]
}
