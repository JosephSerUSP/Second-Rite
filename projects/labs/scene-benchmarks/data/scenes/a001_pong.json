{
  "id": "a001_pong",
  "name": "A001 \u2014 Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 5,
        "y": 1,
        "w": 22,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "A001 \u2014 Pong   Score: {v.score1} - {v.score2}"
        }
      ]
    },
    {
      "id": "board_outline",
      "rect": {
        "x": 5,
        "y": 5,
        "w": 22,
        "h": 15
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "paddle1",
      "rect": {
        "x": "5 + 1",
        "y": "5 + 1 + v.paddle1Y",
        "w": 1,
        "h": "v.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle2",
      "rect": {
        "x": "5 + v.gridW",
        "y": "5 + 1 + v.paddle2Y",
        "w": 1,
        "h": "v.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball",
      "rect": {
        "x": "5 + 1 + v.ballX",
        "y": "5 + 1 + v.ballY",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "UP/DOWN move   Enter restart   B back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "run_hook",
        "hook": "init_state"
      }
    ],
    "init_state": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "gridW",
            "value": 20
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddle1Y",
            "value": 6
          },
          {
            "name": "paddle2Y",
            "value": 6
          },
          {
            "name": "paddleH",
            "value": 3
          },
          {
            "name": "ballX",
            "value": 10.0
          },
          {
            "name": "ballY",
            "value": 6.0
          },
          {
            "name": "ballVX",
            "value": 10.0
          },
          {
            "name": "ballVY",
            "value": 6.0
          },
          {
            "name": "score1",
            "value": "v.score1 or 0"
          },
          {
            "name": "score2",
            "value": "v.score2 or 0"
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "paddle1Y",
            "value": "max(0, min(v.gridH - v.paddleH, v.paddle1Y + v.inputY * 15.0 * time.dt))"
          },
          {
            "name": "inputY",
            "value": 0
          },
          {
            "name": "center2",
            "value": "v.paddle2Y + v.paddleH / 2"
          },
          {
            "name": "paddle2Y",
            "value": "v.center2 < v.ballY - 0.5 and v.paddle2Y + 8.0 * time.dt or (v.center2 > v.ballY + 0.5 and v.paddle2Y - 8.0 * time.dt or v.paddle2Y)"
          },
          {
            "name": "paddle2Y",
            "value": "max(0, min(v.gridH - v.paddleH, v.paddle2Y))"
          },
          {
            "name": "ballX",
            "value": "v.ballX + v.ballVX * time.dt"
          },
          {
            "name": "ballY",
            "value": "v.ballY + v.ballVY * time.dt"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballY <= 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballY",
                "value": 0
              },
              {
                "name": "ballVY",
                "value": "-v.ballVY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballY >= v.gridH - 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballY",
                "value": "v.gridH - 1"
              },
              {
                "name": "ballVY",
                "value": "-v.ballVY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX <= 1 and v.ballX >= 0 and v.ballVX < 0 and v.ballY >= v.paddle1Y and v.ballY <= v.paddle1Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballX",
                "value": 1
              },
              {
                "name": "ballVX",
                "value": "-v.ballVX * 1.1"
              },
              {
                "name": "ballVY",
                "value": "v.ballVY + (v.ballY - (v.paddle1Y + v.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX >= v.gridW - 2 and v.ballX <= v.gridW - 1 and v.ballVX > 0 and v.ballY >= v.paddle2Y and v.ballY <= v.paddle2Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballX",
                "value": "v.gridW - 2"
              },
              {
                "name": "ballVX",
                "value": "-v.ballVX * 1.1"
              },
              {
                "name": "ballVY",
                "value": "v.ballVY + (v.ballY - (v.paddle2Y + v.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX < 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "score2",
                "value": "v.score2 + 1"
              },
              {
                "name": "ballX",
                "value": 10.0
              },
              {
                "name": "ballY",
                "value": 6.0
              },
              {
                "name": "ballVX",
                "value": 10.0
              },
              {
                "name": "ballVY",
                "value": 6.0
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX >= v.gridW",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "score1",
                "value": "v.score1 + 1"
              },
              {
                "name": "ballX",
                "value": 10.0
              },
              {
                "name": "ballY",
                "value": 6.0
              },
              {
                "name": "ballVX",
                "value": -10.0
              },
              {
                "name": "ballVY",
                "value": 6.0
              }
            ]
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "run_hook",
        "hook": "init_state"
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {}
}