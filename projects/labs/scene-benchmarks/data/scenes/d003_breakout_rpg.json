{
  "id": "d003_breakout_rpg",
  "terminal": {
    "reached": "sceneState.win == 1 or sceneState.lost == 1"
  },
  "name": "D003 - Breakout RPG",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "status",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 26,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "HP: {sceneState.hp}   Goblins Left: {sceneState.goblins}"
        }
      ]
    },
    {
      "id": "encounter",
      "rect": {
        "x": 2,
        "y": 4,
        "w": 26,
        "h": 5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Energy Approaches: {sceneState.energy_lane == 1 and 'LEFT' or (sceneState.energy_lane == 2 and 'CENTER' or 'RIGHT')}"
        },
        {
          "type": "text",
          "text": ""
        },
        {
          "type": "text",
          "text": "{sceneState.turn_result}"
        }
      ]
    },
    {
      "id": "commands",
      "rect": {
        "x": 2,
        "y": 9,
        "w": 26,
        "h": 5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.lost == 1 and (sceneState.cmdIdx == 1 and '> Return' or '  Return') or (sceneState.win == 1 and (sceneState.cmdIdx == 1 and '> Return' or '  Return') or (sceneState.cmdIdx == 1 and '> Stance: Left' or '  Stance: Left'))}"
        },
        {
          "type": "text",
          "text": "{sceneState.lost == 1 and '' or (sceneState.win == 1 and '' or (sceneState.cmdIdx == 2 and '> Stance: Center' or '  Stance: Center'))}"
        },
        {
          "type": "text",
          "text": "{sceneState.lost == 1 and '' or (sceneState.win == 1 and '' or (sceneState.cmdIdx == 3 and '> Stance: Right' or '  Stance: Right'))}"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "hp",
            "value": 3
          },
          {
            "name": "goblins",
            "value": 10
          },
          {
            "name": "energy_lane",
            "value": 2
          },
          {
            "name": "cmdIdx",
            "value": 2
          },
          {
            "name": "turn_result",
            "value": "'Prepare to deflect!'"
          },
          {
            "name": "win",
            "value": 0
          },
          {
            "name": "lost",
            "value": 0
          },
          {
            "name": "rng",
            "value": 1
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.win == 0 and sceneState.lost == 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cmdIdx",
            "value": "sceneState.cmdIdx > 1 and sceneState.cmdIdx - 1 or 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.win == 0 and sceneState.lost == 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "cmdIdx",
            "value": "sceneState.cmdIdx < 3 and sceneState.cmdIdx + 1 or 3"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.win == 1 or sceneState.lost == 1",
        "then": [
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.cmdIdx == sceneState.energy_lane",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "goblins",
                    "value": "sceneState.goblins - 1"
                  },
                  {
                    "name": "turn_result",
                    "value": "'Deflected! Goblin defeated.'"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "sceneState.goblins <= 0",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "win",
                        "value": 1
                      },
                      {
                        "name": "cmdIdx",
                        "value": 1
                      },
                      {
                        "name": "turn_result",
                        "value": "'Victory!'"
                      }
                    ]
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "hp",
                    "value": "sceneState.hp - 1"
                  },
                  {
                    "name": "turn_result",
                    "value": "'Missed! You took damage.'"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "sceneState.hp <= 0",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "lost",
                        "value": 1
                      },
                      {
                        "name": "cmdIdx",
                        "value": 1
                      },
                      {
                        "name": "turn_result",
                        "value": "'Defeat!'"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.win == 0 and sceneState.lost == 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "rng",
                    "value": "(sceneState.rng * 7 + 3) % 10"
                  },
                  {
                    "name": "energy_lane",
                    "value": "(sceneState.rng % 3) + 1"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "goldenScript": [
    "wait 1",
    "down",
    "select",
    "wait 1"
  ]
}
