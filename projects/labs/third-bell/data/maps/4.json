        },
        {
          "condition": "flag:found_borrowed_room",
          "commands": [
            {
              "text": "The copied room waits behind the arch. Something has folded back the blanket.",
              "cmd": "TEXT"
            }
          ],
          "elseCommands": [
            {
              "text": "Beyond a plain stone arch is your room in St. Maria: the narrow bed, the damp stain, the stubborn drawer.",
              "cmd": "TEXT"
            },
            {
              "text": "Your travelling case stands beside the bed. You remember leaving it upstairs.",
              "cmd": "TEXT"
            },
            {
              "options": [
                {
                  "label": "Inspect the room.",
                  "commands": [
                    {
                      "text": "It contains a change of clothes in your size, still warm. On the washstand sits your room's chipped bowl.",
