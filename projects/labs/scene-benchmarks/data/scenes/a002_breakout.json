    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v.gameOver == false and v.gameWon == false",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "padX",
                "value": "clamp(v.padX + v.moveInput * 18.0 * v.time.dt, 0, v.fieldW - v.padW)"
              },
              {
                "name": "moveInput",
                "value": 0
              },
              {
                "name": "ballX",
                "value": "v.ballX + v.ballVX * v.time.dt"
              },
              {
                "name": "ballY",
                "value": "v.ballY + v.ballVY * v.time.dt"
              },
              {
                "name": "hit",
                "value": "false"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "not v.gameOver and not v.gameWon and (v.ballX <= 0 or v.ballX >= v.fieldW - 1)",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballX",
                "value": "clamp(v.ballX, 0, v.fieldW - 1)"
              },
              {
                "name": "ballVX",
                "value": "-v.ballVX"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "not v.gameOver and not v.gameWon and v.ballY <= 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballY",
                "value": 0
              },
              {
                "name": "ballVY",
                "value": "abs(v.ballVY)"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "not v.gameOver and not v.gameWon and v.ballY >= v.fieldH",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "gameOver",
            "value": "true"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "not v.gameOver and not v.gameWon and v.ballVY > 0 and v.ballY >= v.padY - 0.5 and v.ballY <= v.padY + 0.5 and v.ballX >= v.padX - 0.5 and v.ballX <= v.padX + v.padW + 0.5",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballY",
                "value": "v.padY - 0.5"
              },
              {
                "name": "ballVY",
                "value": "-abs(v.ballVY)"
              },
              {
                "name": "ballVX",
                "value": "v.ballVX + ((v.ballX - (v.padX + v.padW / 2)) / (v.padW / 2)) * 6.0"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "not v.gameOver and not v.gameWon and v.hit == false and v.b1 == true and v.ballX >= 1.5 and v.ballX <= 5.5 and v.ballY >= 1.5 and v.ballY <= 3.5",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "b1",
                "value": "false"
              },
              {
                "name": "score",
                "value": "v.score + 10"
              },
              {
                "name": "ballVY",
                "value": "-v.ballVY"
              },
              {
                "name": "hit",
                "value": "true"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "not v.gameOver and not v.gameWon and v.hit == false and v.b2 == true and v.ballX >= 5.5 and v.ballX <= 9.5 and v.ballY >= 1.5 and v.ballY <= 3.5",
        "then": [
          {
