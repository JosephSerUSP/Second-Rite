  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": "0"
      },
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "win",
            "value": "false"
          },
          {
            "name": "px",
            "value": "4"
          },
          {
            "name": "py",
            "value": "4"
          },
          {
            "name": "c1x",
            "value": "3"
          },
          {
            "name": "c1y",
            "value": "3"
          },
          {
            "name": "c2x",
            "value": "5"
          },
          {
            "name": "c2y",
            "value": "4"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": "0"
      },
      {
        "cmd": "IF",
        "condition": "not v.win",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "dx",
            "value": "0"
          },
          {
            "cmd": "SET_VAR",
            "name": "dy",
            "value": "-1"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "call",
            "ref": "move"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": "0"
      },
      {
        "cmd": "IF",
        "condition": "not v.win",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "dx",
            "value": "0"
          },
          {
            "cmd": "SET_VAR",
            "name": "dy",
            "value": "1"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "call",
            "ref": "move"
          }
        ]
      }
    ],
    "on_left": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": "0"
      },
      {
        "cmd": "IF",
        "condition": "not v.win",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "dx",
            "value": "-1"
          },
          {
            "cmd": "SET_VAR",
            "name": "dy",
            "value": "0"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "call",
            "ref": "move"
          }
        ]
      }
    ],
    "on_right": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": "0"
      },
      {
        "cmd": "IF",
        "condition": "not v.win",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "dx",
            "value": "1"
          },
          {
            "cmd": "SET_VAR",
            "name": "dy",
            "value": "0"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "call",
            "ref": "move"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "win",
            "value": "false"
          },
          {
            "name": "px",
            "value": "4"
          },
          {
            "name": "py",
            "value": "4"
          },
          {
            "name": "c1x",
            "value": "3"
          },
          {
            "name": "c1y",
            "value": "3"
          },
          {
            "name": "c2x",
            "value": "5"
          },
          {
            "name": "c2y",
            "value": "4"
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "move": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "nx",
            "value": "v.px + v.dx"
          },
          {
            "name": "ny",
            "value": "v.py + v.dy"
          },
          {
            "name": "nnx",
            "value": "v.nx + v.dx"
          },
          {
            "name": "nny",
            "value": "v.ny + v.dy"
          },
          {
            "name": "hit_wall_n",
            "value": "v.nx < 0 or v.nx > 7 or v.ny < 0 or v.ny > 7 or v.ny == 0 or v.ny == 7 or v.nx == 0 or v.nx == 7 or (v.nx == 2 and v.ny == 2) or (v.nx == 3 and v.ny == 2) or (v.nx == 4 and v.ny == 2) or (v.nx == 5 and v.ny == 3) or (v.nx == 1 and v.ny == 4) or (v.nx == 2 and v.ny == 4) or (v.nx == 3 and v.ny == 5) or (v.nx == 5 and v.ny == 6) or (v.nx == 6 and v.ny == 6)"
          },
          {
            "name": "hit_wall_nn",
            "value": "v.nnx < 0 or v.nnx > 7 or v.nny < 0 or v.nny > 7 or v.nny == 0 or v.nny == 7 or v.nnx == 0 or v.nnx == 7 or (v.nnx == 2 and v.nny == 2) or (v.nnx == 3 and v.nny == 2) or (v.nnx == 4 and v.nny == 2) or (v.nnx == 5 and v.nny == 3) or (v.nnx == 1 and v.nny == 4) or (v.nnx == 2 and v.nny == 4) or (v.nnx == 3 and v.nny == 5) or (v.nnx == 5 and v.nny == 6) or (v.nnx == 6 and v.nny == 6)"
          },
          {
            "name": "hit_c1",
            "value": "v.nx == v.c1x and v.ny == v.c1y"
          },
          {
            "name": "hit_c2",
            "value": "v.nx == v.c2x and v.ny == v.c2y"
          },
          {
            "name": "push_c1",
            "value": "v.hit_c1 and not v.hit_wall_nn and not (v.nnx == v.c2x and v.nny == v.c2y)"
          },
          {
            "name": "push_c2",
            "value": "v.hit_c2 and not v.hit_wall_nn and not (v.nnx == v.c1x and v.nny == v.c1y)"
          },
          {
            "name": "can_move",
            "value": "not v.hit_wall_n and (not v.hit_c1 or v.push_c1) and (not v.hit_c2 or v.push_c2)"
          },
          {
            "name": "px",
            "value": "v.can_move and v.nx or v.px"
          },
          {
            "name": "py",
            "value": "v.can_move and v.ny or v.py"
          },
          {
            "name": "c1x",
            "value": "(v.can_move and v.push_c1) and v.nnx or v.c1x"
          },
          {
            "name": "c1y",
            "value": "(v.can_move and v.push_c1) and v.nny or v.c1y"
          },
          {
            "name": "c2x",
            "value": "(v.can_move and v.push_c2) and v.nnx or v.c2x"
          },
          {
            "name": "c2y",
            "value": "(v.can_move and v.push_c2) and v.nny or v.c2y"
          },
          {
            "name": "win",
            "value": "((v.c1x == 3 and v.c1y == 1) or (v.c1x == 2 and v.c1y == 5)) and ((v.c2x == 3 and v.c2y == 1) or (v.c2x == 2 and v.c2y == 5))"
          }
        ]
      }
    ]
  },
