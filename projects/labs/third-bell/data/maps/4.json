      "commands": [
        {
          "condition": "flag:defeated_red_dragon",
          "commands": [
            {
              "cmd": "TEXT",
              "text": "Scorched scales and embers lie cooling near the archway."
            },
            {
              "cmd": "ERASE_EVENT"
            }
          ],
          "elseCommands": [
            {
              "cmd": "TEXT",
              "text": "A towering Red Dragon guards the descent, heat wafting from its crimson scales."
            },
            {
              "cmd": "TEXT",
              "text": "Saban bristles in fear as the dragon's fiery gaze falls upon your party!"
            },
            {
              "cmd": "CHOICE",
              "options": [
                {
                  "label": "Engage the Red Dragon!",
                  "commands": [
                    {
                      "cmd": "BATTLE",
                      "troop": "boss_red_dragon",
                      "onVictory": [
                        {
                          "cmd": "SET_FLAG",
                          "flag": "defeated_red_dragon",
                          "value": true
                        },
                        {
                          "cmd": "CHANGE_ITEM",
                          "item": 205,
                          "count": 1
                        },
                        {
                          "cmd": "TEXT",
                          "text": "With a final roaring collapse, the Red Dragon falls! You obtain an enormous First Scale. The archway to the deeper vault is now clear."
                        },
                        {
                          "cmd": "ERASE_EVENT"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Fall back and prepare.",
                  "commands": [
                    {
                      "cmd": "TEXT",
                      "text": "You pull Saban back out of the dragon's reach."
                    }
                  ]
                }
              ]
            }
          ],
          "cmd": "CONDITIONAL_BRANCH"
        }
      ]
    },
    {
      "name": "The Rusted Choir",
      "label": "Five Rusted Bells",
      "spawn": "Random",
      "sprite": "assets/sprites/dungeon_crystal_pedestal.png",
      "trigger": "bump",
      "wallEvent": true,
      "minimapColor": [
        0.85,
        0.7,
        0.25
      ],
      "commands": [
        {
          "cmd": "ENTER_LOCATION",
          "image": "campaign_rusted_choir.png"
        },
        {
          "cmd": "CONDITIONAL_BRANCH",
          "condition": "flag:choir_struck_three",
          "commands": [
            {
              "cmd": "TEXT",
              "text": "Five bells hang over the dry pit. Four are rusted through. The fifth is clean, and it is the one that knows your name."
            }
          ],
          "elseCommands": [
            {
              "cmd": "TEXT",
              "text": "Five bells hang over the dry pit on a rail, in order of size, the way they would be hung for a procession."
            },
            {
              "cmd": "TEXT",
              "text": "They are not fixed. Somebody hung them here to be struck, and then arranged that nobody would want to."
            },
            {
              "cmd": "TEXT",
              "text": "The Choir is a bargain and it does not hide it: each bell pays better and costs more. You may stop between any two."
            },
            {
              "cmd": "CHOICE",
              "options": [
                {
                  "label": "Strike the first bell.",
                  "commands": [
                    {
                      "cmd": "TEXT",
                      "text": "The first bell is thin with rust. You strike it and the note is small and completely ordinary."
                    },
                    {
                      "cmd": "SET_FLAG",
                      "flag": "choir_struck_one",
                      "value": true
                    },
                    {
                      "cmd": "FOR_EACH",
                      "scope": "living_allies",
                      "as": "ally",
                      "do": [
                        {
                          "cmd": "GRANT_XP",
                          "target": "ally",
                          "amount": "60"
                        }
                      ]
                    },
                    {
                      "cmd": "TEXT",
                      "text": "Every creature with you goes very still and then relaxes, the way an animal does when a room stops being dangerous."
                    },
                    {
                      "cmd": "TEXT",
                      "text": "Something in the pit below rolls over."
                    },
                    {
                      "cmd": "CHOICE",
                      "options": [
                        {
                          "label": "Strike the second bell.",
                          "commands": [
                            {
                              "cmd": "TEXT",
                              "text": "The second bell is packed with wet salt and old wax. Striking it is like hitting a mattress."
                            },
                            {
                              "cmd": "SET_FLAG",
                              "flag": "choir_struck_two",
                              "value": true
                            },
                            {
                              "cmd": "GAIN_GOLD",
                              "amount": "180"
                            },
                            {
                              "cmd": "TEXT",
                              "text": "Coins come out. Not treasure -- change. Small denominations, St. Maria mint, the kind people carry."
                            },
                            {
                              "cmd": "FOR_EACH",
                              "scope": "living_allies",
                              "as": "ally",
                              "do": [
                                {
                                  "cmd": "DAMAGE",
                                  "target": "ally",
                                  "amount": "8 + session.floor * 2",
                                  "pierce": true,
                                  "minHp": 1
                                }
                              ]
                            },
                            {
                              "cmd": "TEXT",
                              "text": "The floor of the Choir tilts a few degrees toward the pit, and every one of you feels it in the teeth."
                            },
                            {
                              "cmd": "CHOICE",
                              "options": [
                                {
                                  "label": "Strike the third bell.",
                                  "commands": [
                                    {
                                      "cmd": "TEXT",
                                      "text": "The third bell has no rust on it at all."
                                    },
                                    {
                                      "cmd": "TEXT",
                                      "text": "You strike it. It does not ring -- it answers, in a voice with a St. Maria accent, and what it says is your own name with the vowels worn off."
                                    },
                                    {
                                      "cmd": "SET_FLAG",
                                      "flag": "choir_struck_three",
                                      "value": true
                                    },
                                    {
                                      "cmd": "CHANGE_ITEM",
                                      "item": "195",
                                      "count": 1
                                    },
                                    {
                                      "cmd": "TEXT",
                                      "text": "Something falls out of the bell's mouth into your palm: an Ether Seed, warm, and heavier than a seed."
                                    },
                                    {
                                      "cmd": "CHANGE_MP",
                                      "amount": "-25"
                                    },
                                    {
                                      "cmd": "TEXT",
                                      "text": "The Choir takes its fee out of the summoning. Twenty-five MP that you were going to walk home on."
                                    },
                                    {
                                      "cmd": "BATTLE",
                                      "onVictory": [
                                        {
                                          "cmd": "TEXT",
                                          "text": "The other four bells stay quiet for the rest of your visit. That is somehow worse."
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "label": "Two is enough.",
                                  "commands": [
                                    {
                                      "cmd": "TEXT",
                                      "text": "You walk out with your change. The bells sway for a while after you have gone."
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "Leave while it is still ordinary.",
                          "commands": [
                            {
                              "cmd": "TEXT",
                              "text": "You take the ordinary note with you and let the other four alone."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Walk under them without touching anything.",
                  "commands": [
                    {
                      "cmd": "TEXT",
                      "text": "You cross the Choir with your hands at your sides. Nothing happens, which the floor seems to find disappointing."
                    },
                    {
                      "cmd": "SET_FLAG",
                      "flag": "choir_declined",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "id": 7,
      "instanceId": "event:third_bell-the-rusted-choir"
    }
