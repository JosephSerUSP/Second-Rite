  "name": "B001 — Fishing Tension",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 4,
        "y": 2,
        "w": 24,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B001 — Fishing Tension"
        }
      ]
    },
    {
      "id": "board",
      "rect": {
        "x": 6,
        "y": 7,
        "w": 20,
        "h": 8
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 18,
          "label": "Tension {sceneState.tension_text}",
          "value": "sceneState.tension",
