{
  "id": "map",
  "name": "Map",
  "kind": "map",
  "config": {
    "fieldCommands": [
      {
        "name": "ITEMS",
        "help": "Use an item from the inventory."
      },
      {
        "name": "PARTY",
        "help": "View the party, reserve, quests, and notes."
      },
      {
        "name": "DATA",
        "help": "Save or load your progress."
      },
      {
        "name": "OPTIONS",
        "help": "Controls and other settings."
      }
    ],
    "partyCommands": [
      {
        "name": "VIEW",
        "help": "Select a party member to inspect."
      },
      {
        "name": "RESERVE",
        "help": "Manage the four creatures carried in expedition reserve."
      },
      {
        "name": "QUESTS",
        "help": "View your active and completed quests."
      },
      {
        "name": "NOTES",
        "help": "Review lore discovered during the journey."
      }
    ],
    "dataCommands": [
      {
        "name": "SAVE",
        "help": "Save your progress to a slot."
      },
      {
        "name": "LOAD",
        "help": "Load your progress from a slot."
      }
    ],
    "unitCommands": [
      {
        "name": "STATUS",
        "help": "View this creature's stats, skills, biography and equipment."
      },
      {
        "name": "ITEM CREATION",
        "help": "Have this creature attempt to create an item."
      },
      {
        "name": "SWAP",
        "help": "Swap this creature with one from the reserve roster."
      }
    ],
    "dock": {
      "variant": "party_status",
      "cursor": "v.mode == 4 and v.partyIdx or 0"
    }
  },
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "mode",
            "value": 0
          },
          {
            "name": "cmdIdx",
            "value": 1
          },
          {
            "name": "partyIdx",
            "value": 1
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "v.mode == 0",
        "then": [
          {
            "cmd": "FALLBACK"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "cmdIdx",
            "value": "v.cmdIdx > 1 and v.cmdIdx - 1 or 4"
          },
          {
            "cmd": "SET_CURSOR",
            "windowId": "battle_command",
            "index": "v.cmdIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 4 and v.partyIdx - 2 >= 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "partyIdx",
            "value": "v.partyIdx - 2"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 2 and v.popupIdx > 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "popupIdx",
            "value": "v.popupIdx - 1"
          },
          {
            "cmd": "SET_CURSOR",
            "windowId": "map_member_popup",
            "index": "v.popupIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 5 and v.popupIdx > 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "popupIdx",
            "value": "v.popupIdx - 1"
          },
          {
            "cmd": "SET_CURSOR",
            "windowId": "map_data_popup",
            "index": "v.popupIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 6 and v.popupIdx > 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "popupIdx",
            "value": "v.popupIdx - 1"
          },
          {
            "cmd": "SET_CURSOR",
            "windowId": "map_party_popup",
            "index": "v.popupIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 3",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "confirmIdx",
            "value": "v.confirmIdx == 1 and 2 or 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "v.mode == 0",
        "then": [
          {
            "cmd": "FALLBACK"
          }
