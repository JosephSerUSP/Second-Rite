          ],
          "elseCommands": [
            {
              "condition": "flag:alicia_first_met",
              "commands": [
                {
                  "commonEventId": 30,
                  "cmd": "CALL_COMMON_EVENT"
                }
              ],
              "elseCommands": [
                {
                  "text": "Oh! H-hello—! I… I didn’t see you coming. I’m Alicia. Welcome to my shop! Uhm— please look around! And— and if you’re hungry, I can warm something up. Not for sale. Just… because.",
                  "speaker": "Alicia",
                  "cmd": "TEXT"
                },
                {
                  "options": [
                    {
                      "label": "Buy Consumables",
                      "commands": [
                        {
                          "flag": "alicia_first_met",
                          "value": true,
                          "cmd": "SET_FLAG"
                        },
                        {
                          "label": "Alicia",
                          "persistent": true,
                          "cmd": "CHANGE_EVENT_PROPERTIES"
                        },
                        {
                          "shopId": 7,
                          "cmd": "OPEN_SHOP"
                        },
                        {
                          "commonEventId": 30,
                          "cmd": "CALL_COMMON_EVENT"
                        }
                      ]
                    },
                    {
                      "label": "You’re kind.",
                      "commands": [
                        {
                          "text": "M-me? No, I’m… I’m normal. I just… I don’t like when people look empty. Like they forgot they have a body. Sorry. That sounded weird.",
                          "speaker": "Alicia",
                          "cmd": "TEXT"
                        },
                        {
                          "options": [
                            {
                              "label": "Not weird.",
                              "commands": [
                                {
                                  "text": "…Thank you. People usually laugh. Or they say ‘that’s cute’ and then they don’t mean it. Anyway! Please— uhm— browse!",
                                  "speaker": "Alicia",
                                  "cmd": "TEXT"
                                },
