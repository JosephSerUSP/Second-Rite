{
  "id": "developer_3d",
  "name": "3D Geometry",
  "kind": "menu",
  "draw": "windows",
  "backdrop": "map",
  "config": {
    "geometryCommands": [
      {
        "id": "quality",
        "name": "QUALITY",
        "help": "Triangle budget and how aggressively flat areas collapse. Recompiles every asset."
      },
      {
        "id": "denser",
        "name": "DENSER",
        "help": "Raise mesh density one step."
      },
      {
        "id": "coarser",
        "name": "COARSER",
        "help": "Lower mesh density one step. Fewer, larger triangles."
      }
    ]
  },
  "windows": [
    {
      "id": "help",
      "content": [
        {
          "type": "text",
          "text": "{sel('geometry_list').help}"
        }
      ]
    },
    {
      "id": "geometry_list",
      "rect": {
        "x": 4,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "style": "list",
      "visibleRows": 3,
      "title": "3D Geometry",
      "content": [
        {
          "type": "list",
          "listId": "config:geometryCommands",
          "formatRight": "{id == 'quality' and sceneState.preset or ''}",
          "cursor": "sceneState.idx"
        }
      ]
    },
    {
      "id": "geometry_stats",
      "rect": {
        "x": 4,
        "y": 12,
        "w": 24,
        "h": 4
      },
      "style": "frame",
      "title": null,
      "content": [
        {
          "type": "text",
          "text": "{'density x' .. sceneState.density}"
        }
      ]
    }
  ],
  "goldenScript": [
    {
      "key": "down"
    },
    {
      "key": "up"
    },
    {
      "key": "escape"
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "idx",
            "value": 1
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "_guard",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SCRIPT",
        "code": "ctx.sceneState.preset = api.geometryQualityLabel()\nctx.sceneState.density = api.geometryDensity()"
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.idx > 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "idx",
            "value": "sceneState.idx - 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.idx < 3",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "idx",
            "value": "sceneState.idx + 1"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.cycleGeometryQuality()\nctx.sceneState.preset = api.geometryQualityLabel()\nctx.sceneState.density = api.geometryDensity()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 2",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.stepGeometryDensity(1)\nctx.sceneState.preset = api.geometryQualityLabel()\nctx.sceneState.density = api.geometryDensity()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 3",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.stepGeometryDensity(-1)\nctx.sceneState.preset = api.geometryQualityLabel()\nctx.sceneState.density = api.geometryDensity()"
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "name": "_guard",
        "value": 0
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  }
}
