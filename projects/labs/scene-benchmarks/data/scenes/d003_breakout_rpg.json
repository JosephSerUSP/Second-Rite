{
  "id": "d003_breakout_rpg",
  "terminal": {
    "reached": "v.win == 1 or v.lost == 1",
    "script": [
      "wait 1",
      "down",
      "down",
      "select",
      "wait 1"
    ]
  },
  "name": "D003 - Breakout RPG",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "status",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 26,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Ward HP: {v.hp}     Total Enemies: {v.total_enemies}"
        },
        {
          "type": "text",
          "text": "The Energy Orb is in the {v.orb_col == 1 and 'Left' or (v.orb_col == 2 and 'Center' or 'Right')} lane,"
        },
        {
          "type": "text",
          "text": "moving towards {v.orb_dir == 1 and 'the Enemy Lines!' or 'YOUR Ward!'}"
        }
      ]
    },
    {
      "id": "board",
      "rect": {
        "x": 2,
        "y": 5,
        "w": 26,
        "h": 9
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "--- ENEMY VANGUARD ---"
        },
        {
          "type": "text",
          "text": "Left:   {v.enemy_left} Goblin Spearmen"
        },
        {
          "type": "text",
          "text": "Center: {v.enemy_center} Orc Warriors"
        },
        {
          "type": "text",
          "text": "Right:  {v.enemy_right} Dark Mages"
        },
        {
          "type": "text",
          "text": ""
        },
        {
          "type": "text",
          "text": "--- YOUR DEFENSES ---"
        },
        {
          "type": "text",
          "text": "Your Ward is positioned at the {v.player_col == 1 and 'Left' or (v.player_col == 2 and 'Center' or 'Right')} lane."
        }
      ]
    },
    {
      "id": "commands",
      "rect": {
        "x": 2,
        "y": 14,
        "w": 26,
        "h": 5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{v.lost == 1 and (v.cmdIdx == 1 and '> Return' or '  Return') or (v.win == 1 and (v.cmdIdx == 1 and '> Return' or '  Return') or (v.cmdIdx == 1 and '> Shift Ward Left' or '  Shift Ward Left'))}"
        },
        {
          "type": "text",
          "text": "{v.lost == 1 and '' or (v.win == 1 and '' or (v.cmdIdx == 2 and '> Hold Position' or '  Hold Position'))}"
        },
        {
          "type": "text",
          "text": "{v.lost == 1 and '' or (v.win == 1 and '' or (v.cmdIdx == 3 and '> Shift Ward Right' or '  Shift Ward Right'))}"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "hp", "value": 3 },
          { "name": "enemy_left", "value": 3 },
          { "name": "enemy_center", "value": 3 },
          { "name": "enemy_right", "value": 3 },
          { "name": "total_enemies", "value": 9 },
          { "name": "orb_col", "value": 2 },
          { "name": "orb_dir", "value": 1 },
          { "name": "orb_dist", "value": 1 },
          { "name": "player_col", "value": 2 },
          { "name": "cmdIdx", "value": 2 },
          { "name": "win", "value": 0 },
          { "name": "lost", "value": 0 }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "v.win == 0 and v.lost == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "cmdIdx",
            "value": "v.cmdIdx == 1 and 3 or v.cmdIdx - 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "v.win == 0 and v.lost == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "cmdIdx",
            "value": "v.cmdIdx == 3 and 1 or v.cmdIdx + 1"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "v.win == 1 or v.lost == 1",
        "then": [
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "v.cmdIdx == 1",
            "then": [
              {
                "cmd": "SET_VAR",
                "name": "player_col",
                "value": "max(1, v.player_col - 1)"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.cmdIdx == 3",
            "then": [
              {
                "cmd": "SET_VAR",
                "name": "player_col",
                "value": "min(3, v.player_col + 1)"
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "name": "orb_dist",
            "value": "v.orb_dist + v.orb_dir"
          },
          {
            "cmd": "IF",
            "condition": "v.orb_dist == 0",
            "then": [
              {
                "cmd": "IF",
                "condition": "v.orb_col == v.player_col",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      { "name": "orb_dir", "value": 1 },
                      { "name": "orb_dist", "value": 1 }
                    ]
                  }
                ],
                "else": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      { "name": "hp", "value": "v.hp - 1" },
                      { "name": "orb_dir", "value": 1 },
                      { "name": "orb_dist", "value": 1 },
                      { "name": "orb_col", "value": "v.player_col" }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "v.hp <= 0",
                    "then": [
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          { "name": "lost", "value": 1 },
                          { "name": "cmdIdx", "value": 1 }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.orb_dist == 2",
            "then": [
              {
                "cmd": "SET_VAR",
                "name": "hit_enemy",
                "value": 0
              },
              {
                "cmd": "IF",
                "condition": "v.orb_col == 1 and v.enemy_left > 0",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      { "name": "enemy_left", "value": "v.enemy_left - 1" },
                      { "name": "hit_enemy", "value": 1 }
                    ]
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.orb_col == 2 and v.enemy_center > 0",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      { "name": "enemy_center", "value": "v.enemy_center - 1" },
                      { "name": "hit_enemy", "value": 1 }
                    ]
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.orb_col == 3 and v.enemy_right > 0",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      { "name": "enemy_right", "value": "v.enemy_right - 1" },
                      { "name": "hit_enemy", "value": 1 }
                    ]
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.hit_enemy == 1",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "name": "total_enemies",
                    "value": "v.total_enemies - 1"
                  }
                ]
              },
              {
                "cmd": "SET_VAR",
                "assignments": [
                  { "name": "orb_dir", "value": "-1" },
                  { "name": "orb_dist", "value": 1 }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.total_enemies <= 0",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      { "name": "win", "value": 1 },
                      { "name": "cmdIdx", "value": 1 }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  }
}
