{
  "metaKeys": [
    {
      "key": "tier",
      "appliesTo": [
        "items"
      ],
      "type": "number",
      "description": "Equipment/content tier from 1 to 5. Used for authoring, filtering and content placement; it does not directly add statistics."
    },
    {
      "key": "disciplines",
      "appliesTo": [
        "items"
      ],
      "type": "list",
      "itemType": "string",
      "enumFrom": "disciplines",
      "description": "Which disciplines can PRODUCE this item. Ingredients are ungated -- this does not restrict what the item may be used to make. Absent means the default from disciplineDefaults, so only exceptions are authored. An item may belong to several; overlap is how a thin discipline is furnished without new content."
    },
    {
      "key": "intensityGrade",
      "appliesTo": [
        "items"
      ],
      "type": "string",
      "enumFrom": "intensityGrades",
      "description": "The one admitted crafting override. Intensity is derived from cost; a grade multiplies it, recording where the author disagrees with the price (a rare herb that costs nothing and does a lot). Enumerated and multiplicative on purpose -- an absolute field would fork the number and drift the way the old meta.potency did."
    },
    {
      "key": "craftable",
      "appliesTo": [
        "items"
      ],
      "type": "flag",
      "description": "Set false to keep an item out of Item Creation entirely (quest and key items). Opt-out, because signatures are derived and every item otherwise acquires one."
    },
    {
      "key": "craftIngredient",
      "appliesTo": [
        "items"
      ],
      "type": "flag",
      "description": "Set false to keep an item out of Item Creation INGREDIENT selection. Independent of `craftable`, which only excludes outputs: monster remains are ingredients that are never produced (craftable false, craftIngredient absent), while a promotion key is neither (both false). Opt-out for the same reason craftable is."
    },
    {
      "key": "dungeonOnly",
      "appliesTo": [
        "items"
      ],
      "type": "flag",
      "description": "When true, field-item usability rejects the item on safe maps before it can be consumed. Used by traversal tools such as Town Portal."
    },
    {
      "key": "detect",
      "appliesTo": [
        "mapEvents",
        "commonEvents",
        "overrides"
      ],
      "type": "string",
      "description": "Marks this event/cell as detectable: \"trap\" (checked against SEE_TRAPS) or \"secret\" (SEE_WALLS). Affects perception only -- a trap is still an ordinary event."
    },
    {
      "key": "detectLevel",
      "appliesTo": [
        "mapEvents",
        "commonEvents",
        "overrides"
      ],
      "type": "number",
      "description": "Difficulty of noticing this (default 1). The party's best sense rate must be >= this value."
    }
  ],
