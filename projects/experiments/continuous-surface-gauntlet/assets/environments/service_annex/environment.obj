# Continuous Surface Gauntlet — Service Annex original beauty fixture
# Distinct room geometry; reuses only the Project-owned neutral atlas.
mtllib environment.mtl
o service_annex

# floor rectangle
v -4.0 0.0  3.0
v  4.0 0.0  3.0
v  4.0 0.0 -3.0
v -4.0 0.0 -3.0

# rear / side wall tops
v -4.0 3.2  3.0
v  4.0 3.2  3.0
v  4.0 3.2 -3.0
v -4.0 3.2 -3.0

# low maintenance cabinet A, footprint matches first walk blocker
v -0.35 0.0  0.25
v  0.85 0.0  0.25
v  0.85 0.0 -1.25
v -0.35 0.0 -1.25
v -0.35 1.10  0.25
v  0.85 1.10  0.25
v  0.85 1.10 -1.25
v -0.35 1.10 -1.25

# narrow service pedestal B, footprint matches second walk blocker
v 1.45 0.0  0.55
v 2.25 0.0  0.55
v 2.25 0.0 -0.25
v 1.45 0.0 -0.25
v 1.45 0.85  0.55
v 2.25 0.85  0.55
v 2.25 0.85 -0.25
v 1.45 0.85 -0.25

# overhead cross-beam to make the annex silhouette unlike Archive
v -3.25 2.35  2.72
v  3.25 2.35  2.72
v  3.25 2.68  2.72
v -3.25 2.68  2.72
v -3.25 2.35  2.42
v  3.25 2.35  2.42
v  3.25 2.68  2.42
v -3.25 2.68  2.42

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
usemtl annex_beauty

