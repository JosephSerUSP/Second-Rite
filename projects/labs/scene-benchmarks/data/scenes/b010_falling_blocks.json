  "scripts": {
    "draw_board": "\nlocal sceneState = ctx.sceneState\nif sceneState.lost == 1 then sceneState.boardText = \"GAME OVER\\n\"; return end\nlocal text = \"\"\nfor y = 0, 13 do\n    for x = 0, 9 do\n        local cell = v[\"grid_\" .. y .. \"_\" .. x]\n        local isPiece = false\n        if (sceneState.pieceX + sceneState.shape0x == x and sceneState.pieceY + sceneState.shape0y == y) or\n           (sceneState.pieceX + sceneState.shape1x == x and sceneState.pieceY + sceneState.shape1y == y) or\n           (sceneState.pieceX + sceneState.shape2x == x and sceneState.pieceY + sceneState.shape2y == y) or\n           (sceneState.pieceX + sceneState.shape3x == x and sceneState.pieceY + sceneState.shape3y == y) then\n            isPiece = true\n        end\n        if isPiece then\n            text = text .. \"O\"\n        elseif cell == 1 then\n            text = text .. \"#\"\n        else\n            text = text .. \".\"\n        end\n    end\n    text = text .. \"\\n\"\nend\nsceneState.boardText = text\n",
    "check_collision_and_lock": "\nlocal sceneState = ctx.sceneState\nlocal function check(nx, ny)\n    for i=0,3 do\n        local cx = nx + v[\"shape\"..i..\"x\"]\n        local cy = ny + v[\"shape\"..i..\"y\"]\n        if cx < 0 or cx >= 10 or cy >= 14 then return true end\n        if cy >= 0 and v[\"grid_\" .. cy .. \"_\" .. cx] == 1 then return true end\n    end\n    return false\nend\nif check(sceneState.pieceX, sceneState.pieceY + 1) then\n    for i=0,3 do\n        local cx = sceneState.pieceX + v[\"shape\"..i..\"x\"]\n        local cy = sceneState.pieceY + v[\"shape\"..i..\"y\"]\n        if cy >= 0 and cy < 14 and cx >= 0 and cx < 10 then\n            v[\"grid_\" .. cy .. \"_\" .. cx] = 1\n        end\n    end\n    -- clearing simple logic\n    for y=13,0,-1 do\n        local full = true\n        for x=0,9 do if v[\"grid_\" .. y .. \"_\" .. x] == 0 then full=false; break end end\n        if full then\n            for ty=y,1,-1 do\n                for tx=0,9 do v[\"grid_\" .. ty .. \"_\" .. tx] = v[\"grid_\" .. (ty-1) .. \"_\" .. tx] end\n            end\n            for tx=0,9 do v[\"grid_0_\" .. tx] = 0 end\n            y = y + 1\n        end\n    end\n    sceneState.pieceX = 4\n    sceneState.pieceY = 0\n    if check(sceneState.pieceX, sceneState.pieceY) then sceneState.lost = 1 end\nelse\n    sceneState.pieceY = sceneState.pieceY + 1\nend\n",
    "input_left": "\nlocal sceneState = ctx.sceneState; if sceneState.lost == 1 then return end\nlocal collision = false\nfor i=0,3 do\n    local cx = sceneState.pieceX - 1 + v[\"shape\"..i..\"x\"]\n    local cy = sceneState.pieceY + v[\"shape\"..i..\"y\"]\n    if cx < 0 or cx >= 10 or cy >= 14 then collision = true; break end\n    if cy >= 0 and v[\"grid_\" .. cy .. \"_\" .. cx] == 1 then collision = true; break end\nend\nif not collision then sceneState.pieceX = sceneState.pieceX - 1 end\n",
    "input_right": "\nlocal sceneState = ctx.sceneState; if sceneState.lost == 1 then return end\nlocal collision = false\nfor i=0,3 do\n    local cx = sceneState.pieceX + 1 + v[\"shape\"..i..\"x\"]\n    local cy = sceneState.pieceY + v[\"shape\"..i..\"y\"]\n    if cx < 0 or cx >= 10 or cy >= 14 then collision = true; break end\n    if cy >= 0 and v[\"grid_\" .. cy .. \"_\" .. cx] == 1 then collision = true; break end\nend\nif not collision then sceneState.pieceX = sceneState.pieceX + 1 end\n",
    "input_down": "\nlocal sceneState = ctx.sceneState; if sceneState.lost == 1 then return end\nlocal collision = false\nfor i=0,3 do\n    local cx = sceneState.pieceX + v[\"shape\"..i..\"x\"]\n    local cy = sceneState.pieceY + 1 + v[\"shape\"..i..\"y\"]\n    if cx < 0 or cx >= 10 or cy >= 14 then collision = true; break end\n    if cy >= 0 and v[\"grid_\" .. cy .. \"_\" .. cx] == 1 then collision = true; break end\nend\nif not collision then sceneState.pieceY = sceneState.pieceY + 1 end\n",
    "input_up": "\nlocal sceneState = ctx.sceneState; if sceneState.lost == 1 then return end\nwhile true do\n    local collision = false\n    for i=0,3 do\n        local cx = sceneState.pieceX + v[\"shape\"..i..\"x\"]\n        local cy = sceneState.pieceY + 1 + v[\"shape\"..i..\"y\"]\n        if cx < 0 or cx >= 10 or cy >= 14 then collision = true; break end\n        if cy >= 0 and v[\"grid_\" .. cy .. \"_\" .. cx] == 1 then collision = true; break end\n    end\n    if collision then break else sceneState.pieceY = sceneState.pieceY + 1 end\nend\n"
  },
