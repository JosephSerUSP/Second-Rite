                    },
                    {
                      "cmd": "CONDITIONAL_BRANCH",
                      "condition": "flag:found_cerberus",
                      "commands": [
                        {
                          "text": "Coiled beside the bed is a heavy iron collar link, matching Cerberus's heavy chain.",
                          "cmd": "TEXT"
                        }
                      ]
                    },
                    {
                      "cmd": "CONDITIONAL_BRANCH",
                      "condition": "flag:found_salt_table",
                      "commands": [
                        {
                          "text": "A faint ring of wet salt marks the corner of the small nightstand.",
                          "cmd": "TEXT"
                        }
                      ]
                    },
                    {
                      "cmd": "CONDITIONAL_BRANCH",
                      "condition": "flag:laura_lunch_delivered",
                      "commands": [
