{
  "id": "basement_rat",
  "name": "Carnegie Hall basement - mutated rat",
  "kind": "menu",
  "draw": "windows",
  "terminal": {
    "reached": "rt.outcome == 'victory'"
  },
  "update": {
    "mode": "fixed",
    "step": 0.016666666666666666,
    "maxCatchUp": 60
  },
  "windows": [
    {
      "id": "world",
      "rect": {
        "x": "-surface.originX",
        "y": "-surface.originY",
        "w": "surface.width",
        "h": "surface.height"
      },
      "style": "modelScene",
      "chrome": "none",
      "viewport": {
        "camera": {
          "position": [
            2,
            -7.2,
            5.4
          ],
          "target": [
            0,
            2.6,
            0.35
          ],
          "fov": 40
        },
        "background": [
          0.025,
          0.025,
          0.018
        ],
        "models": [
          {
            "id": "corridor",
            "model": "assets/models/backstage/corridor.obj",
            "position": [
              0,
              0,
              0
            ],
            "yaw": 0,
            "visible": "true"
          },
          {
            "id": "aya_shadow",
            "model": "assets/models/backstage/contact_shadow.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0
            ],
            "yaw": 0,
            "visible": "true",
            "scale": [
              1,
              1,
              1
            ]
          },
          {
            "id": "rat_shadow",
            "model": "assets/models/backstage/contact_shadow.obj",
            "position": [
              "rt.enemy.x",
              "rt.enemy.y",
              0
            ],
            "yaw": 0,
            "visible": "true",
            "scale": [
              1.5,
              2.6,
              1
            ]
          },
          {
            "id": "range_ground",
            "model": "assets/models/backstage/range_ground.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0.03
            ],
            "yaw": 0,
            "visible": "sceneState.ui == 2",
            "scale": [
              "sceneState.range",
              "sceneState.range",
              1
            ]
          },
          {
            "id": "range_air",
            "model": "assets/models/backstage/range_air.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0.03
            ],
            "yaw": 0,
            "visible": "sceneState.ui == 2",
            "scale": [
              "sceneState.range",
              "sceneState.range",
              1
            ]
          },
          {
            "id": "aya",
            "model": "assets/models/backstage/aya.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "rt.outcome ~= 'defeat' and rt.actAge >= 12 and (sceneState.moving == 0 or sceneState.ui > 0 or rt.outcome ~= '')"
          },
          {
            "id": "aya_walk_a",
            "model": "assets/models/backstage/aya_walk_a.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "rt.outcome == '' and sceneState.ui == 0 and sceneState.moving == 1 and sin(sceneState.gait) >= 0"
          },
          {
            "id": "aya_walk_b",
            "model": "assets/models/backstage/aya_walk_b.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "rt.outcome == '' and sceneState.ui == 0 and sceneState.moving == 1 and sin(sceneState.gait) < 0"
          },
          {
            "id": "aya_down",
            "model": "assets/models/backstage/aya_down.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "rt.outcome == 'defeat'"
          },
          {
            "id": "aya_recoil",
            "model": "assets/models/backstage/aya_recoil.obj",
            "position": [
              "rt.player.x",
              "rt.player.y",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "rt.outcome ~= 'defeat' and rt.actAge < 12"
          },
          {
            "id": "rat",
            "model": "assets/models/backstage/rat.obj",
            "position": [
              "rt.enemy.x",
              "rt.enemy.y",
              0
            ],
            "yaw": "sceneState.ratAim",
            "visible": "(not rt.enemy.windup and rt.enemy.strikeAge >= 20) or rt.outcome == 'victory'",
            "scale": [
              1,
              1,
              "rt.outcome == 'victory' and .18 or 1"
            ],
            "tint": [
              1,
              "rt.hitAge < 12 and not rt.hitOnPlayer and .4 or 1",
              "rt.hitAge < 12 and not rt.hitOnPlayer and .4 or 1"
            ]
          },
          {
            "id": "rat_windup",
            "model": "assets/models/backstage/rat_windup.obj",
            "position": [
              "rt.enemy.x",
              "rt.enemy.y",
              0
            ],
            "yaw": "sceneState.ratAim",
            "visible": "rt.enemy.windup and rt.outcome ~= 'victory'",
            "scale": [
              1,
              1,
              "rt.outcome == 'victory' and .18 or 1"
            ],
            "tint": [
              1,
              "rt.hitAge < 12 and not rt.hitOnPlayer and .4 or 1",
              "rt.hitAge < 12 and not rt.hitOnPlayer and .4 or 1"
            ]
          },
          {
            "id": "rat_lunge",
            "model": "assets/models/backstage/rat_lunge.obj",
            "position": [
              "rt.enemy.x",
              "rt.enemy.y",
              0
            ],
            "yaw": "sceneState.ratAim",
            "visible": "(not rt.enemy.windup and rt.enemy.strikeAge < 20) and rt.outcome ~= 'victory'",
            "scale": [
              1,
              1,
              "rt.outcome == 'victory' and .18 or 1"
            ],
            "tint": [
              1,
              "rt.hitAge < 12 and not rt.hitOnPlayer and .4 or 1",
              "rt.hitAge < 12 and not rt.hitOnPlayer and .4 or 1"
            ]
          },
          {
            "id": "target",
            "model": "assets/models/backstage/target_cursor.obj",
            "position": [
              "rt.enemy.x",
              "rt.enemy.y",
              1.1
            ],
            "yaw": 0,
            "visible": "sceneState.ui == 2"
          },
          {
            "id": "muzzle",
            "model": "assets/models/backstage/spark.obj",
            "position": [
              "rt.player.x+sin(sceneState.aim)*.72",
              "rt.player.y-cos(sceneState.aim)*.72",
              1.47
            ],
            "yaw": 0,
            "visible": "rt.actAge < 12"
          },
          {
            "id": "fire0",
            "model": "assets/models/backstage/spark.obj",
            "position": [
              "rt.fire[1].x",
              "rt.fire[1].y",
              0.35
            ],
            "yaw": 0,
            "visible": "rt.fire[1].live",
            "scale": [
              1.8,
              1.8,
              2.8
            ]
          },
          {
            "id": "fire1",
            "model": "assets/models/backstage/spark.obj",
            "position": [
              "rt.fire[2].x",
              "rt.fire[2].y",
              0.35
            ],
            "yaw": 0,
            "visible": "rt.fire[2].live",
            "scale": [
              1.8,
              1.8,
              2.8
            ]
          },
          {
            "id": "fire2",
            "model": "assets/models/backstage/spark.obj",
            "position": [
              "rt.fire[3].x",
              "rt.fire[3].y",
              0.35
            ],
            "yaw": 0,
            "visible": "rt.fire[3].live",
            "scale": [
              1.8,
              1.8,
              2.8
            ]
          }
        ],
        "labels": [
          {
            "value": "rt.missAge < rt.hitAge and 'MISS' or rt.hitAmount",
            "position": [
              "rt.hitOnPlayer and rt.missAge >= rt.hitAge and rt.player.x or rt.enemy.x",
              "rt.hitOnPlayer and rt.missAge >= rt.hitAge and rt.player.y or rt.enemy.y",
              "1.2 + min(rt.hitAge, rt.missAge) / 60 * 1.2"
            ],
            "visible": "min(rt.hitAge, rt.missAge) < 48",
            "color": [
              1,
              1,
              0.88,
              1
            ]
          }
        ]
      },
      "content": []
    },
    {
      "id": "combat_hud",
      "rect": {
        "x": "1.5 - surface.originX",
        "y": 1,
        "w": 13,
        "h": 4.5
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "gauge",
          "x": 0.7,
          "y": 0.65,
          "width": 8.5,
          "height": 0.4,
          "labelPlacement": "right",
          "label": "AT",
          "value": "rt.player.at",
          "max": "100",
          "fill": [
            0.08,
            "rt.player.at >= 100 and .45+.4*abs(sin(sceneState.gait)) or .7",
            0.85
          ],
          "color": [
            0.04,
            0.07,
            0.06
          ]
        },
        {
          "type": "gauge",
          "x": 0.7,
          "y": 3.5,
          "width": 8.5,
          "height": 0.4,
          "labelPlacement": "right",
          "label": "PE",
          "value": "rt.player.res.pe",
          "max": "100",
          "fill": [
            0.02,
            0.85,
            0.15
          ],
          "color": [
            0.04,
            0.07,
            0.06
          ]
        }
      ]
    },
    {
      "id": "hp",
      "rect": {
        "x": "3.2 - surface.originX",
        "y": 2.3,
        "w": 7,
        "h": 1.5
      },
      "style": "panel",
      "chrome": "none",
      "content": [
        {
          "type": "text",
          "text": "{rt.player.hp}/{rt.player.maxHp}"
        }
      ]
    },
    {
      "id": "hp_label",
      "rect": {
        "x": "10 - surface.originX",
        "y": 2.3,
        "w": 3.5,
        "h": 1.5
      },
      "style": "panel",
      "chrome": "none",
      "content": [
        {
          "type": "text",
          "text": "HP"
        }
      ]
    },
    {
      "id": "command",
      "rect": {
        "x": "1 - surface.originX",
        "y": 7,
        "w": 13,
        "h": 8
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.choice == 0 and '> Attack' or '  Attack'}\n{sceneState.choice == 1 and '> P. Energy' or '  P. Energy'}\n{sceneState.choice == 2 and '> Item' or '  Item'}\n{sceneState.choice == 3 and '> Escape' or '  Escape'}"
        }
      ],
      "visible": "sceneState.ui == 1"
    },
    {
      "id": "target_info",
      "rect": {
        "x": "surface.width - surface.originX - 13",
        "y": 13,
        "w": 12,
        "h": 5
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "M84F\nBULLETS {(rt.items.handgun_ammo or 0)}\nTARGET   1"
        }
      ],
      "visible": "sceneState.ui == 2"
    },
    {
      "id": "pe_menu",
      "rect": {
        "x": "1 - surface.originX",
        "y": 7,
        "w": 15,
        "h": 5
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "> Heal 1\nRecover 30 HP\nPE cost 30"
        }
      ],
      "visible": "sceneState.ui == 3"
    },
    {
      "id": "item_menu",
      "rect": {
        "x": "1 - surface.originX",
        "y": 7,
        "w": 16,
        "h": 5
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "> Medicine 1\nStock {(rt.items.medicine or 0)}\nRecover 30 HP"
        }
      ],
      "visible": "sceneState.ui == 4"
    },
    {
      "id": "result",
      "rect": {
        "x": 6,
        "y": 9,
        "w": 21,
        "h": 8
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "Battle over\nEXP 2    Ammo +6\n{sceneState.rewarded == 0 and \"> Obtain all\" or \"> Replay\"}\nEsc: return"
        }
      ],
      "visible": "rt.outcome == 'victory'"
    },
    {
      "id": "loss",
      "rect": {
        "x": 7,
        "y": 10,
        "w": 20,
        "h": 6
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "Aya has fallen\nEnter: retry\nEsc: return"
        }
      ],
      "visible": "rt.outcome == 'defeat'"
    },
    {
      "id": "escape",
      "rect": {
        "x": 7,
        "y": 10,
        "w": 20,
        "h": 6
      },
      "style": "panel",
      "chrome": "overlay",
      "content": [
        {
          "type": "text",
          "text": "Escaped\nEnter: retry\nEsc: return"
        }
      ],
      "visible": "rt.outcome == 'escaped'"
    },
    {
      "id": "feedback",
      "rect": {
        "x": "1 - surface.originX",
        "y": 27.5,
        "w": 30,
        "h": 2
      },
      "style": "panel",
      "chrome": "none",
      "content": [
        {
          "type": "text",
          "text": "{rt.refusalAge < 90 and rt.refusal or sceneState.status}"
        }
      ],
      "visible": "rt.outcome == '' and (sceneState.status ~= '' or rt.refusalAge < 90)"
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "COMMENT",
        "text": "Combat is the real-time battle scheduler over production Battle (#1424). This scene owns only input, menus and presentation; every domain fact is read from rt.*."
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ui",
            "value": 0
          },
          {
            "name": "choice",
            "value": 0
          },
          {
            "name": "rewarded",
            "value": 0
          },
          {
            "name": "menuHeld",
            "value": "false"
          },
          {
            "name": "gait",
            "value": 0
          },
          {
            "name": "moving",
            "value": 0
          },
          {
            "name": "dx",
            "value": 0
          },
          {
            "name": "dy",
            "value": 0
          },
          {
            "name": "range",
            "value": 4
          },
          {
            "name": "aim",
            "value": 1.768
          },
          {
            "name": "ratAim",
            "value": -1.373
          },
          {
            "name": "status",
            "value": "'Carnegie Hall - backstage'"
          }
        ]
      },
      {
        "cmd": "REALTIME_BATTLE_START",
        "troop": "basement_rat",
        "party": [
          [
            -2,
            1.2
          ]
        ],
        "enemies": [
          [
            2,
            2
          ]
        ],
        "bounds": {
          "minX": -2.2,
          "maxX": 2.2,
          "minY": 0.3,
          "maxY": 4.4
        }
      }
    ],
    "on_frame": [
      {
        "cmd": "READ_INPUT",
        "name": "input"
      },
      {
        "cmd": "IF",
        "condition": "sceneState.input.X and not sceneState.menuHeld and rt.outcome == ''",
        "then": [
          {
            "cmd": "IF",
            "condition": "sceneState.ui == 0 and rt.player.at >= 100",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ui",
                    "value": 1
                  },
                  {
                    "name": "choice",
                    "value": 0
                  },
                  {
                    "name": "status",
                    "value": "'Choose a command'"
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.ui > 0",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "ui",
                        "value": 0
                      },
                      {
                        "name": "status",
                        "value": "''"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "menuHeld",
            "value": "sceneState.input.X"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "dx",
            "value": "sceneState.ui == 0 and ((sceneState.input.RIGHT and 1 or 0) - (sceneState.input.LEFT and 1 or 0)) or 0"
          },
          {
            "name": "dy",
            "value": "sceneState.ui == 0 and ((sceneState.input.UP and 1 or 0) - (sceneState.input.DOWN and 1 or 0)) or 0"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "moving",
            "value": "(sceneState.dx ~= 0 or sceneState.dy ~= 0) and rt.outcome == '' and 1 or 0"
          }
        ]
      },
      {
        "cmd": "REALTIME_BATTLE_PAUSE",
        "paused": "sceneState.ui > 0"
      },
      {
        "cmd": "REALTIME_BATTLE_STEP",
        "dx": "sceneState.dx",
        "dy": "sceneState.dy"
      },
      {
        "cmd": "IF",
        "condition": "sceneState.moving == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "gait",
                "value": "sceneState.gait + time.dt * 10"
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "aim",
            "value": "sceneState.moving == 1 and atan2(sceneState.dx, -sceneState.dy) or atan2(rt.enemy.x - rt.player.x, rt.player.y - rt.enemy.y)"
          },
          {
            "name": "ratAim",
            "value": "atan2(rt.player.x - rt.enemy.x, rt.enemy.y - rt.player.y)"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "rt.outcome ~= ''",
        "then": [
          {
            "cmd": "IF",
            "condition": "rt.outcome == 'victory' and sceneState.rewarded == 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "rewarded",
                    "value": 1
                  },
                  {
                    "name": "status",
                    "value": "''"
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "COMMENT",
                "text": "Replay the lab encounter from a fresh session."
              },
              {
                "cmd": "REALTIME_BATTLE_END"
              },
              {
                "cmd": "RESET_SESSION"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ui",
                    "value": 0
                  },
                  {
                    "name": "choice",
                    "value": 0
                  },
                  {
                    "name": "rewarded",
                    "value": 0
                  },
                  {
                    "name": "menuHeld",
                    "value": "false"
                  },
                  {
                    "name": "gait",
                    "value": 0
                  },
                  {
                    "name": "moving",
                    "value": 0
                  },
                  {
                    "name": "dx",
                    "value": 0
                  },
                  {
                    "name": "dy",
                    "value": 0
                  },
                  {
                    "name": "range",
                    "value": 4
                  },
                  {
                    "name": "aim",
                    "value": 1.768
                  },
                  {
                    "name": "ratAim",
                    "value": -1.373
                  },
                  {
                    "name": "status",
                    "value": "'Carnegie Hall - backstage'"
                  }
                ]
              },
              {
                "cmd": "REALTIME_BATTLE_START",
                "troop": "basement_rat",
                "party": [
                  [
                    -2,
                    1.2
                  ]
                ],
                "enemies": [
                  [
                    2,
                    2
                  ]
                ],
                "bounds": {
                  "minX": -2.2,
                  "maxX": 2.2,
                  "minY": 0.3,
                  "maxY": 4.4
                }
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.ui == 0",
            "then": [
              {
                "cmd": "IF",
                "condition": "rt.outcome == '' and rt.player.at >= 100",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "ui",
                        "value": 2
                      },
                      {
                        "name": "status",
                        "value": "'Choose target'"
                      }
                    ]
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.ui == 2",
                "then": [
                  {
                    "cmd": "REALTIME_BATTLE_COMMAND",
                    "kind": "skill",
                    "id": "handgun_shot",
                    "target": "enemy"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "ui",
                        "value": 0
                      },
                      {
                        "name": "status",
                        "value": "''"
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "cmd": "IF",
                    "condition": "sceneState.ui == 1",
                    "then": [
                      {
                        "cmd": "IF",
                        "condition": "sceneState.choice == 0",
                        "then": [
                          {
                            "cmd": "SET_SCENE_STATE",
                            "assignments": [
                              {
                                "name": "ui",
                                "value": 2
                              },
                              {
                                "name": "status",
                                "value": "'Choose target'"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "cmd": "IF",
                        "condition": "sceneState.choice == 1",
                        "then": [
                          {
                            "cmd": "SET_SCENE_STATE",
                            "assignments": [
                              {
                                "name": "ui",
                                "value": 3
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "cmd": "IF",
                        "condition": "sceneState.choice == 2",
                        "then": [
                          {
                            "cmd": "SET_SCENE_STATE",
                            "assignments": [
                              {
                                "name": "ui",
                                "value": 4
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "cmd": "IF",
                        "condition": "sceneState.choice == 3",
                        "then": [
                          {
                            "cmd": "REALTIME_BATTLE_COMMAND",
                            "kind": "skill",
                            "id": "escape",
                            "target": "self"
                          },
                          {
                            "cmd": "SET_SCENE_STATE",
                            "assignments": [
                              {
                                "name": "ui",
                                "value": 0
                              }
                            ]
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "cmd": "IF",
                        "condition": "sceneState.ui == 3",
                        "then": [
                          {
                            "cmd": "REALTIME_BATTLE_COMMAND",
                            "kind": "skill",
                            "id": "heal1",
                            "target": "self"
                          },
                          {
                            "cmd": "SET_SCENE_STATE",
                            "assignments": [
                              {
                                "name": "ui",
                                "value": 0
                              },
                              {
                                "name": "status",
                                "value": "''"
                              }
                            ]
                          }
                        ],
                        "else": [
                          {
                            "cmd": "IF",
                            "condition": "sceneState.ui == 4",
                            "then": [
                              {
                                "cmd": "REALTIME_BATTLE_COMMAND",
                                "kind": "item",
                                "id": "medicine",
                                "target": "self"
                              },
                              {
                                "cmd": "SET_SCENE_STATE",
                                "assignments": [
                                  {
                                    "name": "ui",
                                    "value": 0
                                  },
                                  {
                                    "name": "status",
                                    "value": "''"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
