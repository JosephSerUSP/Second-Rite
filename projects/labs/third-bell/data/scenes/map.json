          {
            "cmd": "SET_CURSOR",
            "windowId": "map_data_popup",
            "index": "v.popupIdx"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.mode == 6 and v.popupIdx < 4",
