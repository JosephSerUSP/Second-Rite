{
  "id": "c003_moving_breakout",
  "terminal": {
    "reached": "sceneState.gameWon == 1 or sceneState.gameOver == 1"
  },
  "name": "C003 — Breakout With Moving Bricks",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 5,
        "y": 1,
        "w": 22,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "C003 — Breakout With Moving Bricks   Score: {sceneState.score}"
        }
      ]
    },
    {
      "id": "board",
      "rect": {
        "x": 5,
        "y": 5,
        "w": 22,
        "h": 15
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.boardText}"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "LEFT/RIGHT move   Enter restart   B back"
        }
      ]
    },
    {
      "id": "paddle",
      "rect": {
        "x": "5 + 1 + sceneState.paddleX",
        "y": "5 + 1 + sceneState.paddleY",
        "w": "sceneState.paddleW",
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "===="
        }
      ]
    },
    {
      "id": "ball",
      "rect": {
        "x": "5 + 1 + sceneState.ballX",
        "y": "5 + 1 + sceneState.ballY",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_LOCAL",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "gridW",
            "value": 20
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddleX",
            "value": 8
          },
          {
            "name": "paddleY",
            "value": 12
          },
          {
            "name": "paddleW",
            "value": 4
          },
          {
            "name": "ballX",
            "value": 10
          },
          {
            "name": "ballY",
            "value": 10
          },
          {
            "name": "ballVX",
            "value": 8
          },
          {
            "name": "ballVY",
            "value": -8
          },
          {
            "name": "score",
            "value": 0
          },
          {
            "name": "inputX",
            "value": 0
          },
          {
            "name": "boardText",
            "value": "''"
          },
          {
            "name": "gameOver",
            "value": 0
          },
          {
            "name": "gameWon",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SCRIPT",
        "ref": "init_bricks"
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "sceneState.gameOver == 0 and sceneState.gameWon == 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "paddleX",
                "value": "max(0, min(sceneState.gridW - sceneState.paddleW, sceneState.paddleX + sceneState.inputX * 15.0 * sceneState.time.dt))"
              },
              {
                "name": "inputX",
                "value": 0
              },
              {
                "name": "ballX",
                "value": "sceneState.ballX + sceneState.ballVX * sceneState.time.dt"
              },
              {
                "name": "ballY",
                "value": "sceneState.ballY + sceneState.ballVY * sceneState.time.dt"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballX <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballX",
                    "value": 0
                  },
                  {
                    "name": "ballVX",
                    "value": "-sceneState.ballVX"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballX >= sceneState.gridW - 1",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballX",
                    "value": "sceneState.gridW - 1"
                  },
                  {
                    "name": "ballVX",
                    "value": "-sceneState.ballVX"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": 0
                  },
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.gridH",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "gameOver",
                "value": 1
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.paddleY - 0.5 and sceneState.ballY <= sceneState.paddleY + 0.5 and sceneState.ballVY > 0 and sceneState.ballX >= sceneState.paddleX - 0.5 and sceneState.ballX <= sceneState.paddleX + sceneState.paddleW - 0.5",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": "sceneState.paddleY - 0.5"
                  },
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  },
                  {
                    "name": "hitPos",
                    "value": "(sceneState.ballX - (sceneState.paddleX + sceneState.paddleW / 2)) / (sceneState.paddleW / 2)"
                  },
                  {
                    "name": "ballVX",
                    "value": "sceneState.ballVX + sceneState.hitPos * 5.0"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SCRIPT",
            "ref": "update_bricks"
          }
        ]
      }
    ],
    "on_left": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputX",
        "value": -1
      }
    ],
    "on_right": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputX",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "gameOver",
        "value": "true"
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "init_state": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "gridW",
            "value": 20
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddleX",
            "value": 8
          },
          {
            "name": "paddleY",
            "value": 12
          },
          {
            "name": "paddleW",
            "value": 4
          },
          {
            "name": "ballX",
            "value": 10
          },
          {
            "name": "ballY",
            "value": 10
          },
          {
            "name": "ballVX",
            "value": 8
          },
          {
            "name": "ballVY",
            "value": -8
          },
          {
            "name": "score",
            "value": 0
          },
          {
            "name": "inputX",
            "value": 0
          },
          {
            "name": "boardText",
            "value": "''"
          },
          {
            "name": "gameOver",
            "value": 0
          },
          {
            "name": "gameWon",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SCRIPT",
        "ref": "init_bricks"
      }
    ]
  },
  "scripts": {
    "init_bricks": "\nlocal sceneState = ctx.sceneState\nsceneState.bricks = {}\nfor y = 1, 4 do\n    for x = 2, sceneState.gridW - 3 do\n        table.insert(sceneState.bricks, {x=x, y=y, active=true})\n    end\nend\n",
    "update_bricks": "\nlocal sceneState = ctx.sceneState\n\n-- move bricks\nif not sceneState.brickMoveTimer then\n    sceneState.brickMoveTimer = 0\nend\nif not sceneState.brickMoveDir then\n    sceneState.brickMoveDir = 1\nend\n\nsceneState.brickMoveTimer = sceneState.brickMoveTimer + sceneState.time.dt\nif sceneState.brickMoveTimer > 1.0 then\n    sceneState.brickMoveTimer = 0\n    -- determine if we hit edge\n    local hitEdge = false\n    for i, b in ipairs(sceneState.bricks) do\n        if b.active then\n            local nextX = b.x + sceneState.brickMoveDir\n            if nextX < 1 or nextX >= sceneState.gridW - 1 then\n                hitEdge = true\n                break\n            end\n        end\n    end\n    \n    if hitEdge then\n        sceneState.brickMoveDir = -sceneState.brickMoveDir\n        for i, b in ipairs(sceneState.bricks) do\n            if b.active then\n                b.y = b.y + 1\n            end\n        end\n    else\n        for i, b in ipairs(sceneState.bricks) do\n            if b.active then\n                b.x = b.x + sceneState.brickMoveDir\n            end\n        end\n    end\nend\n\n-- brick collision\nlocal bx = math.floor(sceneState.ballX + 0.5)\nlocal by = math.floor(sceneState.ballY + 0.5)\nlocal activeBricks = 0\nlocal lowestBrickY = 0\n\nfor i, b in ipairs(sceneState.bricks) do\n    if b.active then\n        activeBricks = activeBricks + 1\n        if b.y > lowestBrickY then\n            lowestBrickY = b.y\n        end\n        if bx == b.x and by == b.y then\n            b.active = false\n            sceneState.score = sceneState.score + 10\n            sceneState.ballVY = -sceneState.ballVY\n            break -- only hit one brick per frame\n        end\n    end\nend\n\nif activeBricks == 0 then\n    sceneState.gameWon = 1\nend\n\nif lowestBrickY >= sceneState.paddleY then\n    sceneState.gameOver = 1\nend\n\n-- render to text\nlocal text = \"\"\nfor y = 0, sceneState.gridH - 1 do\n    for x = 0, sceneState.gridW - 1 do\n        local char = \" \"\n        for i, b in ipairs(sceneState.bricks) do\n            if b.active and b.x == x and b.y == y then\n                char = \"#\"\n                break\n            end\n        end\n        text = text .. char\n    end\n    text = text .. \"\\n\"\nend\n\nif sceneState.gameOver then\n    text = text .. \"GAME OVER\\n\"\nelseif sceneState.gameWon then\n    text = text .. \"YOU WIN!\\n\"\nend\n\nsceneState.boardText = text\n"
  },
