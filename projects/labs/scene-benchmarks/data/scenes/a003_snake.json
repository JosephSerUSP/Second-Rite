                "cmd": "IF",
                "condition": "(v.length >= 1 and v.hx == v.segX_1 and v.hy == v.segY_1) or (v.length >= 2 and v.hx == v.segX_2 and v.hy == v.segY_2) or (v.length >= 3 and v.hx == v.segX_3 and v.hy == v.segY_3) or (v.length >= 4 and v.hx == v.segX_4 and v.hy == v.segY_4) or (v.length >= 5 and v.hx == v.segX_5 and v.hy == v.segY_5) or (v.length >= 6 and v.hx == v.segX_6 and v.hy == v.segY_6) or (v.length >= 7 and v.hx == v.segX_7 and v.hy == v.segY_7) or (v.length >= 8 and v.hx == v.segX_8 and v.hy == v.segY_8) or (v.length >= 9 and v.hx == v.segX_9 and v.hy == v.segY_9) or (v.length >= 10 and v.hx == v.segX_10 and v.hy == v.segY_10) or (v.length >= 11 and v.hx == v.segX_11 and v.hy == v.segY_11) or (v.length >= 12 and v.hx == v.segX_12 and v.hy == v.segY_12) or (v.length >= 13 and v.hx == v.segX_13 and v.hy == v.segY_13) or (v.length >= 14 and v.hx == v.segX_14 and v.hy == v.segY_14) or (v.length >= 15 and v.hx == v.segX_15 and v.hy == v.segY_15) or (v.length >= 16 and v.hx == v.segX_16 and v.hy == v.segY_16) or (v.length >= 17 and v.hx == v.segX_17 and v.hy == v.segY_17) or (v.length >= 18 and v.hx == v.segX_18 and v.hy == v.segY_18) or (v.length >= 19 and v.hx == v.segX_19 and v.hy == v.segY_19) or (v.length >= 20 and v.hx == v.segX_20 and v.hy == v.segY_20)",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "name": "lost",
                    "value": "true"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.hx == v.tx and v.hy == v.ty",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "name": "length",
                    "value": "clamp(v.length + 1, 1, 20)"
                  },
