  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "hx",
            "value": 5
          },
          {
            "name": "hy",
            "value": 5
          },
          {
            "name": "dirX",
            "value": 0
          },
          {
            "name": "dirY",
            "value": -1
          },
          {
            "name": "tx",
            "value": 2
          },
          {
            "name": "ty",
            "value": 2
          },
          {
            "name": "length",
            "value": 2
          },
          {
            "name": "lost",
            "value": "false"
          },
          {
            "name": "timer",
            "value": 0.5
          },
          {
            "name": "stepTime",
            "value": 0.5
          },
          {
            "name": "segX_1",
            "value": 5
          },
          {
            "name": "segY_1",
            "value": 6
          },
          {
            "name": "segX_2",
            "value": 5
          },
          {
            "name": "segY_2",
            "value": 7
          },
          {
            "name": "segX_3",
            "value": 5
          },
          {
            "name": "segY_3",
            "value": 8
          },
          {
            "name": "segX_4",
            "value": 5
          },
          {
            "name": "segY_4",
            "value": 9
          },
          {
            "name": "segX_5",
            "value": 5
          },
          {
            "name": "segY_5",
            "value": 10
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v.lost == false",
        "then": [
          {
            "cmd": "IF",
            "condition": "v.timer > 0",
            "then": [
              {
                "cmd": "SET_VAR",
                "name": "timer",
                "value": "v.timer - v.time.dt"
              }
            ],
            "else": [
              {
                "cmd": "SET_VAR",
                "name": "timer",
                "value": "v.stepTime"
              },
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "segX_5",
                    "value": "v.segX_4"
                  },
                  {
                    "name": "segY_5",
                    "value": "v.segY_4"
                  },
                  {
                    "name": "segX_4",
                    "value": "v.segX_3"
                  },
                  {
                    "name": "segY_4",
                    "value": "v.segY_3"
                  },
                  {
                    "name": "segX_3",
                    "value": "v.segX_2"
                  },
                  {
                    "name": "segY_3",
                    "value": "v.segY_2"
                  },
                  {
                    "name": "segX_2",
                    "value": "v.segX_1"
                  },
                  {
                    "name": "segY_2",
                    "value": "v.segY_1"
                  },
                  {
                    "name": "segX_1",
                    "value": "v.hx"
                  },
                  {
                    "name": "segY_1",
                    "value": "v.hy"
                  },
                  {
                    "name": "hx",
                    "value": "v.hx + v.dirX"
                  },
                  {
                    "name": "hy",
                    "value": "v.hy + v.dirY"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.hx < 0 or v.hx >= 12 or v.hy < 0 or v.hy >= 12",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "name": "lost",
                    "value": "true"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "(v.length >= 1 and v.hx == v.segX_1 and v.hy == v.segY_1) or (v.length >= 2 and v.hx == v.segX_2 and v.hy == v.segY_2) or (v.length >= 3 and v.hx == v.segX_3 and v.hy == v.segY_3) or (v.length >= 4 and v.hx == v.segX_4 and v.hy == v.segY_4) or (v.length >= 5 and v.hx == v.segX_5 and v.hy == v.segY_5)",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "name": "lost",
                    "value": "true"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "v.hx == v.tx and v.hy == v.ty",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "name": "length",
                    "value": "clamp(v.length + 1, 1, 5)"
                  },
                  {
                    "cmd": "SET_VAR",
                    "name": "tx",
                    "value": "(v.hx + 5) % 12"
                  },
                  {
                    "cmd": "SET_VAR",
                    "name": "ty",
                    "value": "(v.hy + 7) % 12"
                  },
                  {
                    "cmd": "SET_VAR",
                    "name": "stepTime",
                    "value": "clamp(v.stepTime * 0.95, 0.1, 1.0)"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "v.dirY == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "dirX",
                "value": 0
              },
              {
                "name": "dirY",
                "value": -1
              }
            ]
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "v.dirY == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "dirX",
                "value": 0
              },
              {
                "name": "dirY",
                "value": 1
              }
            ]
          }
        ]
      }
    ],
    "on_left": [
      {
        "cmd": "IF",
        "condition": "v.dirX == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "dirX",
                "value": -1
              },
              {
                "name": "dirY",
                "value": 0
              }
            ]
          }
        ]
      }
    ],
    "on_right": [
      {
        "cmd": "IF",
        "condition": "v.dirX == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "dirX",
                "value": 1
              },
              {
                "name": "dirY",
                "value": 0
              }
            ]
          }
        ]
      }
    ],
