# Continuous Surface Gauntlet — explicit coarse collision fixture
# Authored separately from the beauty mesh. No material/UV data: this is semantic geometry.
o archive_antechamber_collision

# room perimeter wall strips, 0.20 thick, y = height
v -4.00 0.00 -3.00
v  4.00 0.00 -3.00
v  4.00 2.20 -3.00
v -4.00 2.20 -3.00
v -4.00 0.00  3.00
v  4.00 0.00  3.00
v  4.00 2.20  3.00
v -4.00 2.20  3.00
v -4.00 0.00 -3.00
v -4.00 0.00  3.00
v -4.00 2.20  3.00
v -4.00 2.20 -3.00
v  4.00 0.00 -3.00
v  4.00 0.00  3.00
v  4.00 2.20  3.00
v  4.00 2.20 -3.00

# central archive plinth matching the walk blocker footprint
v -0.65 0.00 -0.70
v  0.65 0.00 -0.70
v  0.65 0.00  0.70
v -0.65 0.00  0.70
v -0.65 1.25 -0.70
