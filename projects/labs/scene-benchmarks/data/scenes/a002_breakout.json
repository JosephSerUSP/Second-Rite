    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v.gameOver == 0 and v.gameWon == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "padX",
                "value": "clamp(v.padX + v.moveInput * 18.0 * v.time.dt, 0, v.fieldW - v.padW)"
              },
              {
                "name": "moveInput",
                "value": 0
              },
              {
                "name": "ballX",
                "value": "v.ballX + v.ballVX * v.time.dt"
              },
              {
                "name": "ballY",
                "value": "v.ballY + v.ballVY * v.time.dt"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ballX <= 0 or v.ballX >= v.fieldW - 1",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "ballX",
                    "value": "clamp(v.ballX, 0, v.fieldW - 1)"
                  },
                  {
                    "name": "ballVX",
                    "value": "-v.ballVX"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ballY <= 0",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": 0
                  },
                  {
                    "name": "ballVY",
                    "value": "-v.ballVY"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ballY >= v.fieldH",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "gameOver",
                    "value": 1
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.ballY >= v.padY - 0.5 and v.ballY <= v.padY + 0.5 and v.ballVY > 0 and v.ballX >= v.padX - 0.5 and v.ballX <= v.padX + v.padW - 0.5",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": "v.padY - 0.5"
                  },
                  {
                    "name": "ballVY",
                    "value": "-v.ballVY"
                  },
                  {
                    "name": "ballVX",
                    "value": "v.ballVX + ((v.ballX - (v.padX + v.padW / 2)) / (v.padW / 2)) * 6.0"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "hit_b1",
                "value": "(v.b1 == 1 and v.ballX >= 3.0 and v.ballX <= 8.0 and v.ballY >= 2.0 and v.ballY <= 4.0) and 1 or 0"
              },
              {
                "name": "hit_b2",
                "value": "(v.b2 == 1 and v.ballX >= 9.0 and v.ballX <= 14.0 and v.ballY >= 2.0 and v.ballY <= 4.0) and 1 or 0"
              },
              {
                "name": "hit_b3",
                "value": "(v.b3 == 1 and v.ballX >= 15.0 and v.ballX <= 20.0 and v.ballY >= 2.0 and v.ballY <= 4.0) and 1 or 0"
              },
              {
                "name": "hit_b4",
                "value": "(v.b4 == 1 and v.ballX >= 21.0 and v.ballX <= 26.0 and v.ballY >= 2.0 and v.ballY <= 4.0) and 1 or 0"
              },
              {
                "name": "hit_b5",
                "value": "(v.b5 == 1 and v.ballX >= 3.0 and v.ballX <= 8.0 and v.ballY >= 4.0 and v.ballY <= 6.0) and 1 or 0"
              },
              {
                "name": "hit_b6",
                "value": "(v.b6 == 1 and v.ballX >= 9.0 and v.ballX <= 14.0 and v.ballY >= 4.0 and v.ballY <= 6.0) and 1 or 0"
              },
              {
                "name": "hit_b7",
                "value": "(v.b7 == 1 and v.ballX >= 15.0 and v.ballX <= 20.0 and v.ballY >= 4.0 and v.ballY <= 6.0) and 1 or 0"
              },
              {
                "name": "hit_b8",
                "value": "(v.b8 == 1 and v.ballX >= 21.0 and v.ballX <= 26.0 and v.ballY >= 4.0 and v.ballY <= 6.0) and 1 or 0"
              },
              {
                "name": "hit_b9",
                "value": "(v.b9 == 1 and v.ballX >= 3.0 and v.ballX <= 8.0 and v.ballY >= 6.0 and v.ballY <= 8.0) and 1 or 0"
              },
              {
                "name": "hit_b10",
                "value": "(v.b10 == 1 and v.ballX >= 9.0 and v.ballX <= 14.0 and v.ballY >= 6.0 and v.ballY <= 8.0) and 1 or 0"
              },
              {
                "name": "hit_b11",
                "value": "(v.b11 == 1 and v.ballX >= 15.0 and v.ballX <= 20.0 and v.ballY >= 6.0 and v.ballY <= 8.0) and 1 or 0"
              },
              {
                "name": "hit_b12",
                "value": "(v.b12 == 1 and v.ballX >= 21.0 and v.ballX <= 26.0 and v.ballY >= 6.0 and v.ballY <= 8.0) and 1 or 0"
              },
              {
                "name": "any_hit",
                "value": "(v.hit_b1 == 1 or v.hit_b2 == 1 or v.hit_b3 == 1 or v.hit_b4 == 1 or v.hit_b5 == 1 or v.hit_b6 == 1 or v.hit_b7 == 1 or v.hit_b8 == 1 or v.hit_b9 == 1 or v.hit_b10 == 1 or v.hit_b11 == 1 or v.hit_b12 == 1) and 1 or 0"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.any_hit == 1",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "b1",
                    "value": "(v.b1 == 1 and v.hit_b1 == 0) and 1 or 0"
                  },
                  {
                    "name": "b2",
                    "value": "(v.b2 == 1 and v.hit_b2 == 0) and 1 or 0"
                  },
                  {
                    "name": "b3",
                    "value": "(v.b3 == 1 and v.hit_b3 == 0) and 1 or 0"
                  },
                  {
                    "name": "b4",
                    "value": "(v.b4 == 1 and v.hit_b4 == 0) and 1 or 0"
                  },
                  {
                    "name": "b5",
                    "value": "(v.b5 == 1 and v.hit_b5 == 0) and 1 or 0"
                  },
                  {
                    "name": "b6",
                    "value": "(v.b6 == 1 and v.hit_b6 == 0) and 1 or 0"
                  },
                  {
                    "name": "b7",
                    "value": "(v.b7 == 1 and v.hit_b7 == 0) and 1 or 0"
                  },
                  {
                    "name": "b8",
                    "value": "(v.b8 == 1 and v.hit_b8 == 0) and 1 or 0"
                  },
                  {
                    "name": "b9",
                    "value": "(v.b9 == 1 and v.hit_b9 == 0) and 1 or 0"
                  },
                  {
                    "name": "b10",
                    "value": "(v.b10 == 1 and v.hit_b10 == 0) and 1 or 0"
                  },
                  {
                    "name": "b11",
                    "value": "(v.b11 == 1 and v.hit_b11 == 0) and 1 or 0"
                  },
                  {
                    "name": "b12",
                    "value": "(v.b12 == 1 and v.hit_b12 == 0) and 1 or 0"
                  },
                  {
                    "name": "ballVY",
                    "value": "-v.ballVY"
                  },
                  {
                    "name": "score",
                    "value": "v.score + 10"
                  },
                  {
                    "name": "gameWon",
                    "value": "not (v.b1 == 1 or v.b2 == 1 or v.b3 == 1 or v.b4 == 1 or v.b5 == 1 or v.b6 == 1 or v.b7 == 1 or v.b8 == 1 or v.b9 == 1 or v.b10 == 1 or v.b11 == 1 or v.b12 == 1) and 1 or 0"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_left": [
      {
        "cmd": "SET_VAR",
