{
  "id": "c002_splitting_pong",
  "terminal": {
    "none": "spec requires scoring, reset after score and a restartable lifecycle, but no match-win threshold: an endless rally is the authored contract, and reset is a mid-game transition rather than a terminal state"
  },
  "name": "C002 \u2014 Splitting Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 5,
        "y": 1,
        "w": 22,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "C002 \u2014 Splitting Pong   Score: {v.score1} - {v.score2}"
        }
      ]
    },
    {
      "id": "board_outline",
      "rect": {
        "x": 5,
        "y": 5,
        "w": 22,
        "h": 15
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "paddle1",
      "rect": {
        "x": "5 + 1",
        "y": "5 + 1 + v.paddle1Y",
        "w": 1,
        "h": "v.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle2",
      "rect": {
        "x": "5 + v.gridW",
        "y": "5 + 1 + v.paddle2Y",
        "w": 1,
        "h": "v.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball1",
      "rect": {
        "x": "5 + 1 + v.ball1X",
        "y": "5 + 1 + v.ball1Y",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "ball2",
      "rect": {
        "x": "5 + 1 + v.ball2X",
        "y": "5 + 1 + v.ball2Y",
        "w": "v.ball2Active > 0 and 1 or 0",
        "h": "v.ball2Active > 0 and 1 or 0"
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "ball3",
      "rect": {
        "x": "5 + 1 + v.ball3X",
        "y": "5 + 1 + v.ball3Y",
        "w": "v.ball3Active > 0 and 1 or 0",
        "h": "v.ball3Active > 0 and 1 or 0"
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 4,
        "y": 21,
        "w": 24,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "UP/DOWN move   Enter restart   B back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "gridW",
            "value": 20
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddle1Y",
            "value": 6
          },
          {
            "name": "paddle2Y",
            "value": 6
          },
          {
            "name": "paddleH",
            "value": 3
          },
          {
            "name": "ball1X",
            "value": 10.0
          },
          {
            "name": "ball1Y",
            "value": 6.0
          },
          {
            "name": "ball1VX",
            "value": 10.0
          },
          {
            "name": "ball1VY",
            "value": 6.0
          },
          {
            "name": "ball2X",
            "value": 10.0
          },
          {
            "name": "ball2Y",
            "value": 6.0
          },
          {
            "name": "ball2VX",
            "value": 10.0
          },
          {
            "name": "ball2VY",
            "value": 6.0
          },
          {
            "name": "ball3X",
            "value": 10.0
          },
          {
            "name": "ball3Y",
            "value": 6.0
          },
          {
            "name": "ball3VX",
            "value": 10.0
          },
          {
            "name": "ball3VY",
            "value": 6.0
          },
          {
            "name": "ball2Active",
            "value": 0
          },
          {
            "name": "ball3Active",
            "value": 0
          },
          {
            "name": "hits",
            "value": 0
          },
          {
            "name": "score1",
            "value": "v.score1 or 0"
          },
          {
            "name": "score2",
            "value": "v.score2 or 0"
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "init_state": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "gridW",
            "value": 20
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddle1Y",
            "value": 6
          },
          {
            "name": "paddle2Y",
            "value": 6
          },
          {
            "name": "paddleH",
            "value": 3
          },
          {
            "name": "ball1X",
            "value": 10.0
          },
          {
            "name": "ball1Y",
            "value": 6.0
          },
          {
            "name": "ball1VX",
            "value": 10.0
          },
          {
            "name": "ball1VY",
            "value": 6.0
          },
          {
            "name": "ball2X",
            "value": 10.0
          },
          {
            "name": "ball2Y",
            "value": 6.0
          },
          {
            "name": "ball2VX",
            "value": 10.0
          },
          {
            "name": "ball2VY",
            "value": 6.0
          },
          {
            "name": "ball3X",
            "value": 10.0
          },
          {
            "name": "ball3Y",
            "value": 6.0
          },
          {
            "name": "ball3VX",
            "value": 10.0
          },
          {
            "name": "ball3VY",
            "value": 6.0
          },
          {
            "name": "ball2Active",
            "value": 0
          },
          {
            "name": "ball3Active",
            "value": 0
          },
          {
            "name": "hits",
            "value": 0
          },
          {
            "name": "score1",
            "value": "v.score1 or 0"
          },
          {
            "name": "score2",
            "value": "v.score2 or 0"
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "paddle1Y",
            "value": "max(0, min(v.gridH - v.paddleH, v.paddle1Y + v.inputY * 15.0 * time.dt))"
          },
          {
            "name": "inputY",
            "value": 0
          },
          {
            "name": "targetBallY",
            "value": "v.ball3Active > 0 and v.ball3Y or (v.ball2Active > 0 and v.ball2Y or v.ball1Y)"
          },
          {
            "name": "center2",
            "value": "v.paddle2Y + v.paddleH / 2"
          },
          {
            "name": "paddle2Y",
            "value": "v.center2 < v.targetBallY - 0.5 and v.paddle2Y + 8.0 * time.dt or (v.center2 > v.targetBallY + 0.5 and v.paddle2Y - 8.0 * time.dt or v.paddle2Y)"
          },
          {
            "name": "paddle2Y",
            "value": "max(0, min(v.gridH - v.paddleH, v.paddle2Y))"
          },
          {
            "name": "ball1X",
            "value": "v.ball1X + v.ball1VX * time.dt"
          },
          {
            "name": "ball1Y",
            "value": "v.ball1Y + v.ball1VY * time.dt"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball2Active > 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball2X",
                "value": "v.ball2X + v.ball2VX * time.dt"
              },
              {
                "name": "ball2Y",
                "value": "v.ball2Y + v.ball2VY * time.dt"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball3Active > 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball3X",
                "value": "v.ball3X + v.ball3VX * time.dt"
              },
              {
                "name": "ball3Y",
                "value": "v.ball3Y + v.ball3VY * time.dt"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball1Y <= 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball1Y",
                "value": 0
              },
              {
                "name": "ball1VY",
                "value": "-v.ball1VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball1Y >= v.gridH - 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball1Y",
                "value": "v.gridH - 1"
              },
              {
                "name": "ball1VY",
                "value": "-v.ball1VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball2Active > 0 and v.ball2Y <= 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball2Y",
                "value": 0
              },
              {
                "name": "ball2VY",
                "value": "-v.ball2VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball2Active > 0 and v.ball2Y >= v.gridH - 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball2Y",
                "value": "v.gridH - 1"
              },
              {
                "name": "ball2VY",
                "value": "-v.ball2VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball3Active > 0 and v.ball3Y <= 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball3Y",
                "value": 0
              },
              {
                "name": "ball3VY",
                "value": "-v.ball3VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball3Active > 0 and v.ball3Y >= v.gridH - 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball3Y",
                "value": "v.gridH - 1"
              },
              {
                "name": "ball3VY",
                "value": "-v.ball3VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball1X <= 1 and v.ball1X >= 0 and v.ball1VX < 0 and v.ball1Y >= v.paddle1Y and v.ball1Y <= v.paddle1Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball1X",
                "value": 1
              },
              {
                "name": "ball1VX",
                "value": "-v.ball1VX * 1.1"
              },
              {
                "name": "ball1VY",
                "value": "v.ball1VY + (v.ball1Y - (v.paddle1Y + v.paddleH/2)) * 2"
              },
              {
                "name": "hits",
                "value": "v.hits + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball2Active > 0 and v.ball2X <= 1 and v.ball2X >= 0 and v.ball2VX < 0 and v.ball2Y >= v.paddle1Y and v.ball2Y <= v.paddle1Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball2X",
                "value": 1
              },
              {
                "name": "ball2VX",
                "value": "-v.ball2VX * 1.1"
              },
              {
                "name": "ball2VY",
                "value": "v.ball2VY + (v.ball2Y - (v.paddle1Y + v.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball3Active > 0 and v.ball3X <= 1 and v.ball3X >= 0 and v.ball3VX < 0 and v.ball3Y >= v.paddle1Y and v.ball3Y <= v.paddle1Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball3X",
                "value": 1
              },
              {
                "name": "ball3VX",
                "value": "-v.ball3VX * 1.1"
              },
              {
                "name": "ball3VY",
                "value": "v.ball3VY + (v.ball3Y - (v.paddle1Y + v.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball1X >= v.gridW - 2 and v.ball1X <= v.gridW - 1 and v.ball1VX > 0 and v.ball1Y >= v.paddle2Y and v.ball1Y <= v.paddle2Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball1X",
                "value": "v.gridW - 2"
              },
              {
                "name": "ball1VX",
                "value": "-v.ball1VX * 1.1"
              },
              {
                "name": "ball1VY",
                "value": "v.ball1VY + (v.ball1Y - (v.paddle2Y + v.paddleH/2)) * 2"
              },
              {
                "name": "hits",
                "value": "v.hits + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball2Active > 0 and v.ball2X >= v.gridW - 2 and v.ball2X <= v.gridW - 1 and v.ball2VX > 0 and v.ball2Y >= v.paddle2Y and v.ball2Y <= v.paddle2Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball2X",
                "value": "v.gridW - 2"
              },
              {
                "name": "ball2VX",
                "value": "-v.ball2VX * 1.1"
              },
              {
                "name": "ball2VY",
                "value": "v.ball2VY + (v.ball2Y - (v.paddle2Y + v.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball3Active > 0 and v.ball3X >= v.gridW - 2 and v.ball3X <= v.gridW - 1 and v.ball3VX > 0 and v.ball3Y >= v.paddle2Y and v.ball3Y <= v.paddle2Y + v.paddleH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball3X",
                "value": "v.gridW - 2"
              },
              {
                "name": "ball3VX",
                "value": "-v.ball3VX * 1.1"
              },
              {
                "name": "ball3VY",
                "value": "v.ball3VY + (v.ball3Y - (v.paddle2Y + v.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hits == 2 and v.ball2Active == 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ball2Active",
                "value": 1
              },
              {
                "name": "ball3Active",
                "value": 1
              },
              {
                "name": "ball2X",
                "value": "v.ball1X"
              },
              {
                "name": "ball2Y",
                "value": "v.ball1Y"
              },
              {
                "name": "ball2VX",
                "value": "v.ball1VX"
              },
              {
                "name": "ball2VY",
                "value": "v.ball1VY - 5.0"
              },
              {
                "name": "ball3X",
                "value": "v.ball1X"
              },
              {
                "name": "ball3Y",
                "value": "v.ball1Y"
              },
              {
                "name": "ball3VX",
                "value": "v.ball1VX"
              },
              {
                "name": "ball3VY",
                "value": "v.ball1VY + 5.0"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball1X < 0 or (v.ball2Active > 0 and v.ball2X < 0) or (v.ball3Active > 0 and v.ball3X < 0)",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "score2",
                "value": "v.score2 + 1"
              },
              {
                "name": "ball1X",
                "value": 10.0
              },
              {
                "name": "ball1Y",
                "value": 6.0
              },
              {
                "name": "ball1VX",
                "value": 10.0
              },
              {
                "name": "ball1VY",
                "value": 6.0
              },
              {
                "name": "ball2Active",
                "value": 0
              },
              {
                "name": "ball3Active",
                "value": 0
              },
              {
                "name": "hits",
                "value": 0
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ball1X >= v.gridW or (v.ball2Active > 0 and v.ball2X >= v.gridW) or (v.ball3Active > 0 and v.ball3X >= v.gridW)",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "score1",
                "value": "v.score1 + 1"
              },
              {
                "name": "ball1X",
                "value": 10.0
              },
              {
                "name": "ball1Y",
                "value": 6.0
              },
              {
                "name": "ball1VX",
                "value": -10.0
              },
              {
                "name": "ball1VY",
                "value": 6.0
              },
              {
                "name": "ball2Active",
                "value": 0
              },
              {
                "name": "ball3Active",
                "value": 0
              },
              {
                "name": "hits",
                "value": 0
              }
            ]
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "run_hook",
        "hook": "init_state"
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {}
}
