{
  "id": "b002_argument",
  "terminal": {
    "none": "conversation specimen, not a scored loop (#920 names this as the legitimate case)"
  },
  "name": "B002 — Argument as Combat",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 1,
        "y": 1,
        "w": 30,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Argument with the King"
        }
      ]
    },
    {
      "id": "opponent_stats",
      "rect": {
        "x": 1,
        "y": 4,
        "w": 14,
        "h": 6
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "y": 0,
          "text": "King's Patience:"
        },
        {
          "type": "text",
          "y": 1,
          "text": "{sceneState.opp_patience} / 100"
        },
        {
          "type": "text",
          "y": 3,
          "text": "Conv. Position:"
        },
        {
          "type": "text",
          "y": 4,
          "text": "{sceneState.position}"
        }
      ]
    },
    {
      "id": "player_stats",
      "rect": {
        "x": 16,
        "y": 4,
        "w": 15,
        "h": 6
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "y": 0,
          "text": "Your Patience:"
        },
        {
          "type": "text",
          "y": 1,
          "text": "{sceneState.player_patience} / 100"
        },
        {
          "type": "text",
          "y": 2,
          "text": "Trust: {sceneState.trust}"
        },
        {
          "type": "text",
          "y": 3,
          "text": "Embarrassment: {sceneState.embarrassment}"
        }
      ]
    },
    {
      "id": "feedback_box",
      "rect": {
        "x": 1,
        "y": 10,
        "w": 30,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.feedback_1}"
        },
        {
          "type": "text",
          "y": 1,
          "text": "{sceneState.feedback_2}"
        }
      ]
    },
    {
      "id": "action_menu",
      "rect": {
        "x": 1,
        "y": 14,
        "w": 30,
        "h": 7
      },
      "style": "list",
      "visibleRows": 4,
      "content": [
        {
          "type": "list",
          "listId": "term:b002.options",
          "cursor": "sceneState.idx"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "player_patience",
            "value": 100
          },
          {
            "name": "opp_patience",
            "value": 100
          },
          {
            "name": "trust",
            "value": 50
          },
          {
            "name": "embarrassment",
            "value": 0
          },
          {
            "name": "position",
            "value": 0
          },
          {
            "name": "idx",
            "value": 1
          },
          {
            "name": "feedback_1",
            "value": "'The King glares at you.'"
          },
          {
            "name": "feedback_2",
            "value": "'What is your argument?'"
          },
          {
            "name": "state",
            "value": "'active'"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.state == 'active'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "idx",
            "value": "sceneState.idx == 1 and 4 or sceneState.idx - 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.state == 'active'",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "idx",
            "value": "sceneState.idx == 4 and 1 or sceneState.idx + 1"
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.state == 'active'",
        "then": [
          {
            "cmd": "IF",
            "condition": "sceneState.idx == 1",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "player_patience",
                "value": "sceneState.player_patience - 10"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "position",
                "value": "sceneState.position + 2"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "feedback_1",
                "value": "'You pressed logic.'"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.idx == 2",
            "then": [
              {
                "cmd": "IF",
                "condition": "sceneState.trust >= 20",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "trust",
                    "value": "sceneState.trust - 20"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "opp_patience",
                    "value": "sceneState.opp_patience - 30"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "feedback_1",
                    "value": "'You appealed to trust.'"
                  }
                ],
                "else": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "feedback_1",
                    "value": "'Not enough trust!'"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.idx == 3",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "embarrassment",
                "value": "sceneState.embarrassment + 15"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "trust",
                "value": "sceneState.trust + 10"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "feedback_1",
                "value": "'You conceded a point.'"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.idx == 4",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "embarrassment",
                "value": "sceneState.embarrassment > 20 and sceneState.embarrassment - 20 or 0"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "feedback_1",
                "value": "'You deflected.'"
              }
            ]
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "feedback_2",
            "value": "'The King reacts...'"
          },
          {
            "cmd": "IF",
            "condition": "sceneState.position >= 10",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "opp_patience",
                "value": "sceneState.opp_patience - 20"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "feedback_2",
                "value": "'Your position weakens him.'"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.opp_patience <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "state",
                "value": "'win'"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "feedback_1",
                "value": "'You won the argument!'"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "name": "feedback_2",
                "value": "'The King yields.'"
              }
            ],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.player_patience <= 0",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "state",
                    "value": "'lose'"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "feedback_1",
                    "value": "'You lost your patience.'"
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "name": "feedback_2",
                    "value": "'The argument is over.'"
                  }
                ],
                "else": [
                  {
                    "cmd": "IF",
                    "condition": "sceneState.embarrassment >= 100",
                    "then": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "name": "state",
                        "value": "'lose'"
                      },
                      {
                        "cmd": "SET_SCENE_STATE",
                        "name": "feedback_1",
                        "value": "'You are too embarrassed.'"
                      },
                      {
                        "cmd": "SET_SCENE_STATE",
                        "name": "feedback_2",
                        "value": "'You retreat.'"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
