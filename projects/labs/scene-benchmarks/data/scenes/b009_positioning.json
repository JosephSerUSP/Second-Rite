{
  "id": "b009_positioning",
  "name": "B009 - Carnegie Hall encounter",
  "kind": "menu",
  "draw": "windows",
  "terminal": {
    "reached": "sceneState.mode == 2"
  },
  "update": {
    "mode": "fixed",
    "step": 0.016666666666666666,
    "maxCatchUp": 60
  },
  "windows": [
    {
      "id": "world",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 32,
        "h": 22
      },
      "style": "modelScene",
      "chrome": "none",
      "viewport": {
        "camera": {
          "position": [
            0,
            -8,
            7
          ],
          "target": [
            0,
            5,
            1
          ],
          "fov": 43
        },
        "background": [
          0.035,
          0.028,
          0.035
        ],
        "models": [
          {
            "id": "hall",
            "model": "assets/models/b009/hall.obj",
            "position": [
              0,
              0,
              0
            ]
          },
          {
            "id": "range",
            "model": "assets/models/b009/range.obj",
            "position": [
              "sceneState.px",
              "sceneState.py",
              0.05
            ],
            "scale": [
              "sceneState.range",
              "sceneState.range",
              1
            ],
            "visible": "sceneState.mode < 2"
          },
          {
            "id": "danger",
            "model": "assets/models/b009/danger.obj",
            "position": [
              "sceneState.tx",
              "sceneState.ty",
              0.07
            ],
            "scale": [
              1.3,
              1.3,
              1
            ],
            "visible": "sceneState.enemyMode == 1 and sceneState.mode < 2"
          },
          {
            "id": "aya",
            "model": "assets/models/b009/aya.obj",
            "position": [
              "sceneState.px",
              "sceneState.py",
              "sceneState.mode < 2 and sceneState.input and (sceneState.input.UP or sceneState.input.DOWN or sceneState.input.LEFT or sceneState.input.RIGHT) and abs(sin(sceneState.gait))*.035 or 0"
            ],
            "yaw": "sceneState.aim"
          },
          {
            "id": "rat",
            "model": "assets/models/b009/rat.obj",
            "position": [
              "sceneState.ex",
              "sceneState.ey",
              0
            ],
            "yaw": "sceneState.ratAim",
            "scale": [
              1.3,
              1.3,
              "sceneState.mode == 2 and .12 or 1.3"
            ],
            "tint": [
              1,
              "sceneState.flash > 0 and .35 or 1",
              "sceneState.flash > 0 and .35 or 1"
            ]
          },
          {
            "id": "muzzle",
            "model": "assets/models/b009/spark.obj",
            "position": [
              "sceneState.px+sin(sceneState.aim)*.72",
              "sceneState.py-cos(sceneState.aim)*.72",
              1.47
            ],
            "visible": "sceneState.flash > 0"
          }
        ]
      },
      "content": []
    },
    {
      "id": "location",
      "rect": {
        "x": 1,
        "y": 0.5,
        "w": 30,
        "h": 2.5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "CARNEGIE HALL - CHRISTMAS EVE"
        }
      ]
    },
    {
      "id": "aya_hp",
      "rect": {
        "x": 0,
        "y": 22,
        "w": 11,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 0.7,
          "y": 0.7,
          "width": 9.6,
          "label": "AYA HP",
          "value": "sceneState.hp",
          "max": "100",
          "fill": [
            0.2,
            0.65,
            0.6
          ],
          "color": [
            0.05,
            0.05,
            0.07
          ]
        }
      ]
    },
    {
      "id": "rat_hp",
      "rect": {
        "x": 11,
        "y": 22,
        "w": 11,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 0.7,
          "y": 0.7,
          "width": 9.6,
          "label": "RAT HP",
          "value": "sceneState.ehp",
          "max": "100",
          "fill": [
            0.7,
            0.16,
            0.12
          ],
          "color": [
            0.05,
            0.05,
            0.07
          ]
        }
      ]
    },
    {
      "id": "atb",
      "rect": {
        "x": 22,
        "y": 22,
        "w": 10,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 0.7,
          "y": 0.7,
          "width": 8.6,
          "label": "ATB",
          "value": "sceneState.atb",
          "max": "100",
          "fill": [
            0.7,
            0.62,
            0.18
          ],
          "color": [
            0.05,
            0.05,
            0.07
          ]
        }
      ]
    },
    {
      "id": "feedback",
      "rect": {
        "x": 0,
        "y": 25,
        "w": 32,
        "h": 2.5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.status}"
        }
      ]
    },
    {
      "id": "controls",
      "rect": {
        "x": 0,
        "y": 27.5,
        "w": 32,
        "h": 2.5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Arrows move   Enter fire   Esc back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "px",
            "value": 0
          },
          {
            "name": "py",
            "value": 1
          },
          {
            "name": "ex",
            "value": 1
          },
          {
            "name": "ey",
            "value": 6
          },
          {
            "name": "atb",
            "value": 0
          },
          {
            "name": "hp",
            "value": 100
          },
          {
            "name": "ehp",
            "value": 100
          },
          {
            "name": "mode",
            "value": 0
          },
          {
            "name": "actionTimer",
            "value": 0
          },
          {
            "name": "enemyMode",
            "value": 0
          },
          {
            "name": "enemyTimer",
            "value": 2
          },
          {
            "name": "tx",
            "value": 0
          },
          {
            "name": "ty",
            "value": 0
          },
          {
            "name": "flash",
            "value": 0
          },
          {
            "name": "range",
            "value": 4
          },
          {
            "name": "aim",
            "value": 0
          },
          {
            "name": "ratAim",
            "value": 0
          },
          {
            "name": "status",
            "value": "'Move closer. Enter fires at full ATB.'"
          },
          {
            "name": "gait",
            "value": 0
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "READ_INPUT",
        "name": "input"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "name": "flash",
        "value": "max(0,sceneState.flash-time.dt)"
      },
      {
        "cmd": "IF",
        "condition": "sceneState.mode < 2",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "dx",
                "value": "(sceneState.input.RIGHT and 1 or 0)-(sceneState.input.LEFT and 1 or 0)"
              },
              {
                "name": "dy",
                "value": "(sceneState.input.UP and 1 or 0)-(sceneState.input.DOWN and 1 or 0)"
              },
              {
                "name": "actionTimer",
                "value": "max(0,sceneState.actionTimer-time.dt)"
              },
              {
                "name": "atb",
                "value": "min(100,sceneState.atb+30*time.dt)"
              },
              {
                "name": "gait",
                "value": "sceneState.gait+time.dt*12"
              }
            ]
          },
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "norm",
                "value": "max(1,sqrt(sceneState.dx^2+sceneState.dy^2))"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.actionTimer <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "px",
                    "value": "clamp(sceneState.px+sceneState.dx/sceneState.norm*3*time.dt,-2.8,2.8)"
                  },
                  {
                    "name": "py",
                    "value": "clamp(sceneState.py+sceneState.dy/sceneState.norm*3*time.dt,-1,9.5)"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "distance",
                "value": "sqrt((sceneState.px-sceneState.ex)^2+(sceneState.py-sceneState.ey)^2)"
              },
              {
                "name": "aim",
                "value": "atan2(sceneState.ex-sceneState.px,sceneState.py-sceneState.ey)"
              },
              {
                "name": "ratAim",
                "value": "atan2(sceneState.px-sceneState.ex,sceneState.ey-sceneState.py)"
              },
              {
                "name": "enemyTimer",
                "value": "sceneState.enemyTimer-time.dt"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.enemyMode == 0",
            "then": [
              {
                "cmd": "IF",
                "condition": "sceneState.distance > 1.4",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "ex",
                        "value": "sceneState.ex+(sceneState.px-sceneState.ex)/max(.01,sceneState.distance)*1.2*time.dt"
                      },
                      {
                        "name": "ey",
                        "value": "sceneState.ey+(sceneState.py-sceneState.ey)/max(.01,sceneState.distance)*1.2*time.dt"
                      }
                    ]
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "sceneState.enemyTimer <= 0",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "enemyMode",
                        "value": 1
                      },
                      {
                        "name": "enemyTimer",
                        "value": 1
                      },
                      {
                        "name": "tx",
                        "value": "sceneState.px"
                      },
                      {
                        "name": "ty",
                        "value": "sceneState.py"
                      },
                      {
                        "name": "status",
                        "value": "'WIND-UP! Leave the red ring.'"
                      }
                    ]
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.enemyTimer <= 0",
                "then": [
                  {
                    "cmd": "IF",
                    "condition": "(sceneState.px-sceneState.tx)^2+(sceneState.py-sceneState.ty)^2 <= 1.3^2",
                    "then": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "assignments": [
                          {
                            "name": "hp",
                            "value": "max(0,sceneState.hp-18)"
                          },
                          {
                            "name": "status",
                            "value": "'Clawed! Move during the wind-up.'"
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "assignments": [
                          {
                            "name": "status",
                            "value": "'Evaded. Reposition and fire.'"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "enemyMode",
                        "value": 0
                      },
                      {
                        "name": "enemyTimer",
                        "value": 2.2
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.hp <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "mode",
                    "value": 3
                  },
                  {
                    "name": "atb",
                    "value": 0
                  },
                  {
                    "name": "status",
                    "value": "'AYA DOWN. Enter retry / Esc back.'"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.mode >= 2",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "px",
                "value": 0
              },
              {
                "name": "py",
                "value": 1
              },
              {
                "name": "ex",
                "value": 1
              },
              {
                "name": "ey",
                "value": 6
              },
              {
                "name": "atb",
                "value": 0
              },
              {
                "name": "hp",
                "value": 100
              },
              {
                "name": "ehp",
                "value": 100
              },
              {
                "name": "mode",
                "value": 0
              },
              {
                "name": "actionTimer",
                "value": 0
              },
              {
                "name": "enemyMode",
                "value": 0
              },
              {
                "name": "enemyTimer",
                "value": 2
              },
              {
                "name": "tx",
                "value": 0
              },
              {
                "name": "ty",
                "value": 0
              },
              {
                "name": "flash",
                "value": 0
              },
              {
                "name": "range",
                "value": 4
              },
              {
                "name": "aim",
                "value": 0
              },
              {
                "name": "ratAim",
                "value": 0
              },
              {
                "name": "status",
                "value": "'Move closer. Enter fires at full ATB.'"
              },
              {
                "name": "gait",
                "value": 0
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.atb >= 100 and sceneState.actionTimer <= 0",
            "then": [
              {
                "cmd": "IF",
                "condition": "(sceneState.px-sceneState.ex)^2+(sceneState.py-sceneState.ey)^2 <= sceneState.range^2",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "ehp",
                        "value": "max(0,sceneState.ehp-25)"
                      },
                      {
                        "name": "atb",
                        "value": 0
                      },
                      {
                        "name": "actionTimer",
                        "value": 0.35
                      },
                      {
                        "name": "flash",
                        "value": 0.2
                      },
                      {
                        "name": "status",
                        "value": "'Pistol hit - 25 damage.'"
                      }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "sceneState.ehp <= 0",
                    "then": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "assignments": [
                          {
                            "name": "mode",
                            "value": 2
                          },
                          {
                            "name": "atb",
                            "value": 0
                          },
                          {
                            "name": "enemyMode",
                            "value": 0
                          },
                          {
                            "name": "status",
                            "value": "'VICTORY! Enter replay / Esc back.'"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "status",
                        "value": "'Out of range. Move closer; ATB kept.'"
                      }
                    ]
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "status",
                    "value": "'ATB charging. Keep moving.'"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
