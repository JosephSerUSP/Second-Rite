{
  "id": "a002_breakout",
  "name": "A002 Breakout Benchmark",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "terminal": {
    "reached": "sceneState.gameOver == true or sceneState.gameWon == true"
  },
  "windows": [
    {
      "id": "header",
      "rect": { "x": 0, "y": 0, "w": 30, "h": 3 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "BREAKOUT - Score: {sceneState.score}" }
      ]
    },
    {
      "id": "field",
      "rect": { "x": 0, "y": 4, "w": 30, "h": 15 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "{sceneState.gridString}" }
      ]
    },
    {
      "id": "paddle",
      "rect": {
        "x": "sceneState.paddleX + 1",
        "y": "sceneState.paddleY + 4 + 1",
        "w": "sceneState.paddleW",
        "h": 1
      },
      "style": "panel",
      "content": [
        { "type": "text", "text": "=====" }
      ]
    },
    {
      "id": "ball",
      "rect": {
        "x": "sceneState.ballX + 1",
        "y": "sceneState.ballY + 4 + 1",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        { "type": "text", "text": "O" }
      ]
    },
    {
      "id": "footer",
      "rect": { "x": 0, "y": 20, "w": 30, "h": 3 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "LEFT/RIGHT move | ENTER restart | B exit" }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          { "name": "_guard", "value": 0 }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          { "name": "score", "value": 0 },
          { "name": "gameOver", "value": "false" },
          { "name": "gameWon", "value": "false" },
          { "name": "paddleX", "value": 12 },
          { "name": "paddleY", "value": 12 },
          { "name": "paddleW", "value": 5 },
          { "name": "paddleSpeed", "value": 20 },
          { "name": "inputDir", "value": 0 },
          { "name": "ballX", "value": 14 },
          { "name": "ballY", "value": 11 },
          { "name": "ballVX", "value": 8 },
          { "name": "ballVY", "value": -10 },
          { "name": "gridString", "value": "''" }
        ]
      },
      {
        "cmd": "SCRIPT",
        "ref": "init_bricks"
      }
    ],
    "on_select": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          { "name": "score", "value": 0 },
          { "name": "gameOver", "value": "false" },
          { "name": "gameWon", "value": "false" },
          { "name": "paddleX", "value": 12 },
          { "name": "paddleY", "value": 12 },
          { "name": "paddleW", "value": 5 },
          { "name": "paddleSpeed", "value": 20 },
          { "name": "inputDir", "value": 0 },
          { "name": "ballX", "value": 14 },
          { "name": "ballY", "value": 11 },
          { "name": "ballVX", "value": 8 },
          { "name": "ballVY", "value": -10 },
          { "name": "gridString", "value": "''" }
        ]
      },
      {
        "cmd": "SCRIPT",
        "ref": "init_bricks"
      }
    ],
    "on_left": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputDir",
        "value": -1
      }
    ],
    "on_right": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "inputDir",
        "value": 1
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "sceneState.gameOver == false and sceneState.gameWon == false",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "paddleX",
                "value": "clamp(sceneState.paddleX + sceneState.inputDir * sceneState.paddleSpeed * sceneState.time.dt, 0, 28 - sceneState.paddleW)"
              },
              {
                "name": "inputDir",
                "value": 0
              },
              {
                "name": "ballX",
                "value": "sceneState.ballX + sceneState.ballVX * sceneState.time.dt"
              },
              {
                "name": "ballY",
                "value": "sceneState.ballY + sceneState.ballVY * sceneState.time.dt"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballX <= 0 or sceneState.ballX >= 27",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballX",
                    "value": "clamp(sceneState.ballX, 0, 27)"
                  },
                  {
                    "name": "ballVX",
                    "value": "-sceneState.ballVX"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": 0
                  },
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= 13",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "gameOver",
                "value": "true"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.paddleY - 0.5 and sceneState.ballY <= sceneState.paddleY + 0.5 and sceneState.ballVY > 0 and sceneState.ballX >= sceneState.paddleX - 0.5 and sceneState.ballX <= sceneState.paddleX + sceneState.paddleW",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": "sceneState.paddleY - 0.5"
                  },
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  },
                  {
                    "name": "ballVX",
                    "value": "sceneState.ballVX + ((sceneState.ballX - (sceneState.paddleX + sceneState.paddleW / 2)) / (sceneState.paddleW / 2)) * 5.0"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SCRIPT",
            "ref": "update_bricks"
          }
        ]
      }
    ]
  },
  "scripts": {
    "init_bricks": "\nlocal s = ctx.sceneState\ns.bricks = {}\nfor row = 1, 4 do\n  for col = 2, 25 do\n    table.insert(s.bricks, {x = col, y = row, active = true})\n  end\nend\n",
    "update_bricks": "\nlocal s = ctx.sceneState\nlocal bx = math.floor(s.ballX + 0.5)\nlocal by = math.floor(s.ballY + 0.5)\n\nlocal activeBricks = 0\nfor _, b in ipairs(s.bricks) do\n  if b.active then\n    activeBricks = activeBricks + 1\n    if b.x == bx and b.y == by then\n      b.active = false\n      s.score = s.score + 10\n      s.ballVY = -s.ballVY\n      break\n    end\n  end\nend\n\nif activeBricks == 0 then\n  s.gameWon = true\nend\n\nlocal out = \"\"\nfor y = 0, 12 do\n  for x = 0, 27 do\n    local char = \" \"\n    for _, b in ipairs(s.bricks) do\n      if b.active and b.x == x and b.y == y then\n        char = \"#\"\n        break\n      end\n    end\n    out = out .. char\n  end\n  out = out .. \"\\n\"\nend\n\nif s.gameOver then\n  out = out .. \"\\nGAME OVER\"\nelseif s.gameWon then\n  out = out .. \"\\nYOU WIN!\"\nend\ns.gridString = out\n"
  },
  "goldenScript": [
    "wait 1",
    "wait 2"
  ]
}
