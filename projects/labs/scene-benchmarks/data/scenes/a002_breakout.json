    "on_frame": [
      {
        "cmd": "IF",
        "condition": "sceneState.gameOver == false and sceneState.gameWon == false",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "padX",
                "value": "clamp(sceneState.padX + sceneState.moveInput * 18.0 * sceneState.time.dt, 0, sceneState.fieldW - sceneState.padW)"
              },
              {
                "name": "moveInput",
                "value": 0
              },
              {
                "name": "ballX",
                "value": "sceneState.ballX + sceneState.ballVX * sceneState.time.dt"
              },
              {
                "name": "ballY",
                "value": "sceneState.ballY + sceneState.ballVY * sceneState.time.dt"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballX <= 0 or sceneState.ballX >= sceneState.fieldW - 1",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballX",
                    "value": "clamp(sceneState.ballX, 0, sceneState.fieldW - 1)"
                  },
                  {
                    "name": "ballVX",
                    "value": "-sceneState.ballVX"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY <= 0",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": 0
                  },
                  {
                    "name": "ballVY",
                    "value": "abs(sceneState.ballVY)"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.fieldH",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "name": "gameOver",
                "value": "true"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.ballY >= sceneState.padY - 0.5 and sceneState.ballY <= sceneState.padY + 0.5 and sceneState.ballVY > 0 and sceneState.ballX >= sceneState.padX - 0.5 and sceneState.ballX <= sceneState.padX + sceneState.padW - 0.5",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballY",
                    "value": "sceneState.padY - 0.5"
                  },
                  {
                    "name": "ballVY",
                    "value": "-abs(sceneState.ballVY)"
                  },
                  {
                    "name": "ballVX",
                    "value": "sceneState.ballVX + ((sceneState.ballX - (sceneState.padX + sceneState.padW / 2)) / (sceneState.padW / 2)) * 6.0"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.b0_0 and sceneState.ballX >= 1.5 and sceneState.ballX <= 4.5 and sceneState.ballY >= 1.5 and sceneState.ballY <= 2.5",
            "then": [
              {
                "cmd": "SET_LOCAL",
                "assignments": [
                  {
                    "name": "b0_0",
                    "value": "false"
                  },
                  {
                    "name": "bricksLeft",
                    "value": "v.bricksLeft - 1"
                  }
                ]
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ballVY",
                    "value": "-sceneState.ballVY"
                  },
                  {
                    "name": "score",
                    "value": "sceneState.score + 10"
                  }
                ]
              }
            ]
          },
          {
