mtllib transition_arrow.mtl
o st_maria_transition_arrow_ground_chevron
# Flat ground-plane chevron. The standard Y-up OBJ axis becomes local +Z in
# the runtime parser; the tiny local radial thickness is only a non-degenerate
# mesh stand-off. The shared marker mapper places the cue on the floor for
# every direction.
v -0.180000 0.000000 -0.010000
v 0.180000 0.000000 -0.010000
v 0.180000 0.620000 -0.010000
v 0.450000 0.620000 -0.010000
v 0.000000 1.040000 -0.010000
v -0.450000 0.620000 -0.010000
v -0.180000 0.620000 -0.010000
v -0.180000 0.000000 0.010000
v 0.180000 0.000000 0.010000
v 0.180000 0.620000 0.010000
v 0.450000 0.620000 0.010000
v 0.000000 1.040000 0.010000
v -0.450000 0.620000 0.010000
v -0.180000 0.620000 0.010000
usemtl transition_arrow
f 1 2 3
