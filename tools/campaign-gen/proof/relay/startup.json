{
  "system.json": {
    "ui": {
      "activeFont": "monogram-extended",
      "fontSize": 16,
      "fontOffsetY": -4,
      "fontNormalize": true
    },
    "spawn": { "mapId": 1, "x": 3, "y": 2, "dir": "N" },
