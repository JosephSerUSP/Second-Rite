        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.hits == 2 and sceneState.ball2Active == 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball2Active",
                "value": 1
              },
              {
                "name": "ball3Active",
                "value": 1
              },
              {
                "name": "ball2X",
                "value": "sceneState.ball1X"
              },
              {
                "name": "ball2Y",
                "value": "sceneState.ball1Y"
              },
              {
                "name": "ball2VX",
                "value": "sceneState.ball1VX"
              },
              {
                "name": "ball2VY",
                "value": "sceneState.ball1VY - 5.0"
              },
              {
                "name": "ball3X",
                "value": "sceneState.ball1X"
              },
              {
                "name": "ball3Y",
                "value": "sceneState.ball1Y"
              },
              {
                "name": "ball3VX",
                "value": "sceneState.ball1VX"
              },
              {
                "name": "ball3VY",
                "value": "sceneState.ball1VY + 5.0"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball1X < 0 or (sceneState.ball2Active > 0 and sceneState.ball2X < 0) or (sceneState.ball3Active > 0 and sceneState.ball3X < 0)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "score2",
                "value": "sceneState.score2 + 1"
              },
              {
                "name": "ball1X",
                "value": 10
              },
              {
                "name": "ball1Y",
                "value": 6
              },
              {
                "name": "ball1VX",
                "value": 10
              },
              {
                "name": "ball1VY",
                "value": 6
              },
              {
                "name": "ball2Active",
                "value": 0
              },
              {
                "name": "ball3Active",
                "value": 0
              },
              {
                "name": "hits",
                "value": 0
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball1X >= sceneState.gridW or (sceneState.ball2Active > 0 and sceneState.ball2X >= sceneState.gridW) or (sceneState.ball3Active > 0 and sceneState.ball3X >= sceneState.gridW)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "score1",
                "value": "sceneState.score1 + 1"
              },
              {
                "name": "ball1X",
                "value": 10
              },
              {
                "name": "ball1Y",
                "value": 6
              },
              {
                "name": "ball1VX",
                "value": -10
              },
              {
                "name": "ball1VY",
                "value": 6
              },
              {
                "name": "ball2Active",
                "value": 0
              },
              {
                "name": "ball3Active",
                "value": 0
              },
              {
                "name": "hits",
                "value": 0
              }
            ]
