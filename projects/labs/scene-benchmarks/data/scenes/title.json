{
  "id": "title",
  "name": "Benchmark Launcher",
  "kind": "menu",
  "draw": "windows",
  "windows": [
    {
      "id": "heading",
      "rect": { "x": 4, "y": 2, "w": 24, "h": 5 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "THESTRA SCENE LAB\\nPlayable specimens" }
      ]
    },
    {
      "id": "benchmarks",
      "rect": { "x": 6, "y": 8, "w": 20, "h": 8 },
      "style": "list",
      "visibleRows": 3,
      "content": [
        { "type": "list", "listId": "term:title.options", "cursor": "v.idx" }
      ]
    },
    {
      "id": "help",
      "rect": { "x": 4, "y": 18, "w": 24, "h": 5 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "Arrows: choose   Enter: play\\nB: return from a specimen" }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "idx", "value": 1 },
          { "name": "_guard", "value": 0 }
        ]
      }
    ],
    "on_up": [
      { "cmd": "SET_VAR", "name": "idx", "value": "v.idx == 1 and 3 or v.idx - 1" }
    ],
    "on_down": [
      { "cmd": "SET_VAR", "name": "idx", "value": "v.idx == 3 and 1 or v.idx + 1" }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 1",
        "then": [
          { "cmd": "SET_VAR", "name": "_guard", "value": 1 },
          { "cmd": "RESET_SESSION" },
          { "cmd": "SCENE_EVENT", "kind": "push", "scene": "a003_snake" }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 2",
        "then": [
          { "cmd": "SET_VAR", "name": "_guard", "value": 1 },
          { "cmd": "RESET_SESSION" },
          { "cmd": "SCENE_EVENT", "kind": "push", "scene": "d002_sokoban" }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v._guard == 0 and v.idx == 3",
        "then": [
          { "cmd": "SET_VAR", "name": "_guard", "value": 1 },
          { "cmd": "QUIT_GAME" }
        ]
      },
      { "cmd": "SET_VAR", "name": "_guard", "value": 0 }
    ]
  },
  "config": {}
}
