{
  "id": "shop",
  "name": "Shop",
  "kind": "menu",
  "goldenScript": [
    {
      "key": "down"
    },
    {
      "key": "up"
    },
    {
      "key": "escape"
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "idx",
            "value": 1
          },
          {
            "name": "qty",
            "value": 1
          },
          {
            "name": "state",
            "value": 1
          },
          {
            "name": "confirmIdx",
            "value": 1
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.state == 1 and sceneState.idx > 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "idx",
                "value": "sceneState.idx - 1"
              },
              {
                "name": "qty",
                "value": 1
              }
            ]
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.state == 1 and sceneState.count and sceneState.idx < sceneState.count",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "idx",
                "value": "sceneState.idx + 1"
              },
              {
                "name": "qty",
                "value": 1
              }
            ]
          }
        ]
      }
    ],
    "on_right": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.state == 2 and sceneState.items[sceneState.idx] ~= nil",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "qty",
            "value": "min((sceneState.qty or 1) + 1, min(sceneState.items[sceneState.idx].cost > 0 and floor(session.gold / sceneState.items[sceneState.idx].cost) or (sceneState.items[sceneState.idx].stock or 99), sceneState.items[sceneState.idx].stock or 99))"
          }
        ]
      }
    ],
    "on_left": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.state == 2 and (sceneState.qty or 1) > 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "qty",
            "value": "(sceneState.qty or 1) - 1"
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.state == 2",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "state",
                "value": 1
              },
              {
                "name": "qty",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.state == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.state == 1 and sceneState.count > 0 and sceneState.items[sceneState.idx] and session.gold >= sceneState.items[sceneState.idx].cost",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "state",
                "value": 2
              },
              {
                "name": "confirmIdx",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.state == 2",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "IF",
            "condition": "sceneState.confirmIdx == 1",
            "then": [
              {
                "cmd": "GAIN_GOLD",
                "amount": "-(sceneState.items[sceneState.idx].cost * (sceneState.qty or 1))"
              },
              {
                "cmd": "CHANGE_ITEM",
                "item": "sceneState.items[sceneState.idx].id",
                "count": "(sceneState.qty or 1)"
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "state",
                    "value": 1
                  },
                  {
                    "name": "qty",
                    "value": 1
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "state",
                    "value": 1
                  },
                  {
                    "name": "qty",
                    "value": 1
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "scripts": {},
  "config": {
    "dock": {
      "variant": "item_inspect",
      "visible": "sceneState.state == 1 or sceneState.state == 2",
      "cursor": "sceneState.idx",
      "windows": {
        "dock_item_info": {
          "content": [
            {
              "type": "list",
              "listId": "sceneState:items",
              "cursor": "sceneState.idx"
            }
          ]
        }
      }
    }
  },
  "draw": "windows",
  "backdrop": "map",
  "windows": [
    {
      "id": "shop_header",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 32,
        "h": 4
      },
      "visible": "sceneState.state == 1 or sceneState.state == 2",
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.shopName}   Gold: {session.gold} G\n{sel('shop_list').description}"
        }
      ]
    },
    {
      "id": "shop_list",
      "rect": {
        "x": 0.5,
        "y": 4.5,
        "w": 20,
        "h": 13
      },
      "style": "list",
      "emptyText": "No items available.",
      "visible": "sceneState.state == 1 or sceneState.state == 2",
      "content": [
        {
          "type": "list",
          "listId": "sceneState:items",
          "format": "{name}",
          "formatRight": "{formatPrice(cost, sceneState.maxPrice)}",
          "cursor": "sceneState.idx"
        }
      ]
    },
    {
      "id": "shop_key_art",
      "rect": {
        "x": 20.5,
        "y": 4.5,
        "w": 11,
        "h": 13
      },
      "style": "itemModel",
      "title": null,
      "visible": "sceneState.state == 1 or sceneState.state == 2",
      "content": [
        {
          "type": "list",
          "listId": "sceneState:items",
          "cursor": "sceneState.idx"
        }
      ]
    },
    {
      "id": "shop_confirm",
      "rect": {
        "x": 4,
        "y": 7,
        "w": 24,
        "h": 19
      },
      "visible": "sceneState.state == 2",
      "style": "confirm",
      "title": "Confirm Purchase",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.qty}x {sel('shop_list').name}\nTotal: {formatPrice(sceneState.items[sceneState.idx].cost * sceneState.qty, sceneState.maxTotalPrice)}"
        },
        {
          "type": "list",
          "listId": "static:Buy,Cancel",
          "cursor": "sceneState.confirmIdx"
        }
      ]
    }
  ]
}
