{
  "id": "day1_dressing",
  "name": "Carnegie Hall - dressing rooms",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.016666666666666666,
    "maxCatchUp": 60
  },
  "windows": [
    {
      "id": "world",
      "rect": {
        "x": "-surface.originX",
        "y": "-surface.originY",
        "w": "surface.width",
        "h": "surface.height"
      },
      "style": "modelScene",
      "chrome": "none",
      "viewport": {
        "camera": {
          "position": [
            0,
            -4.800000000000001,
            7.699999999999999
          ],
          "target": [
            0,
            2.88,
            0.4
          ],
          "fov": 44
        },
        "background": [
          0.025,
          0.025,
          0.018
        ],
        "models": [
          {
            "id": "room",
            "model": "assets/models/blockout/dressing.obj",
            "position": [
              0,
              0,
              0
            ],
            "yaw": 0,
            "visible": "true"
          },
          {
            "id": "door_to_backstage",
            "model": "assets/models/blockout/door_marker.obj",
            "position": [
              -4.6,
              2.5,
              0
            ],
            "yaw": 0,
            "visible": "sceneState.near == 'to_backstage'"
          },
          {
            "id": "door_to_rehearsal",
            "model": "assets/models/blockout/door_marker.obj",
            "position": [
              4.6,
              3,
              0
            ],
            "yaw": 0,
            "visible": "sceneState.near == 'to_rehearsal'"
          },
          {
            "id": "pickup_rehearsal_key",
            "model": "assets/models/blockout/pickup.obj",
            "position": [
              -3.5,
              4.5,
              0
            ],
            "yaw": "sceneState.gait * 0.25",
            "visible": "sceneState.f_got_rehearsal_key == 0"
          },
          {
            "id": "pickup_diary",
            "model": "assets/models/blockout/pickup.obj",
            "position": [
              3.5,
              4.5,
              0
            ],
            "yaw": "sceneState.gait * 0.25",
            "visible": "sceneState.f_got_diary == 0"
          },
          {
            "id": "pickup_dressing_ammo",
            "model": "assets/models/blockout/pickup.obj",
            "position": [
              0,
              5,
              0
            ],
            "yaw": "sceneState.gait * 0.25",
            "visible": "sceneState.f_got_dressing_ammo == 0"
          },
          {
            "id": "aya_shadow",
            "model": "assets/models/backstage/contact_shadow.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": 0,
            "visible": "true"
          },
          {
            "id": "aya",
            "model": "assets/models/backstage/aya.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "(sceneState.fight == 1 and rt.outcome ~= 'defeat' and rt.actAge >= 12 and (sceneState.moving == 0 or sceneState.ui > 0 or rt.outcome ~= '')) or (sceneState.fight == 0 and (not sceneState.moving == 1 or sceneState.ui > 0))"
          },
          {
            "id": "aya_walk_a",
            "model": "assets/models/backstage/aya_walk_a.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and sin(sceneState.gait) >= 0 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_b",
            "model": "assets/models/backstage/aya_walk_b.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and sin(sceneState.gait) < 0 and (sceneState.fight == 0 or rt.outcome == '')"
          }
        ]
      },
      "content": []
    },
    {
      "id": "card",
      "rect": {
        "x": "4 - surface.originX",
        "y": 7,
        "w": "surface.width - 8",
        "h": 14
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui == 9",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.card}"
        }
      ]
    },
    {
      "id": "weapon",
      "rect": {
        "x": "surface.width - surface.originX - 15",
        "y": 1,
        "w": 14,
        "h": 2
      },
      "style": "panel",
      "chrome": "none",
      "visible": "sceneState.ui ~= 9",
      "content": [
        {
          "type": "text",
          "text": "{(variables.weapon or 'handgun') == 'baton' and 'Baton' or 'Handgun'}{sceneState.fight == 0 and '  [X]' or ''}"
        }
      ]
    },
    {
      "id": "feedback",
      "rect": {
        "x": "1 - surface.originX",
        "y": 27.5,
        "w": 34,
        "h": 2
      },
      "style": "panel",
      "chrome": "none",
      "visible": "sceneState.ui ~= 9",
      "content": [
        {
          "type": "text",
          "text": "{(sceneState.fight == 1 and (rt.refusalAge < 90 and rt.refusal or sceneState.status) or sceneState.status)}"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "COMMENT",
        "text": "Generated from tools/chapter/rooms.json by build_chapter.py; edit the table, not this file."
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ui",
            "value": 0
          },
          {
            "name": "choice",
            "value": 0
          },
          {
            "name": "menuHeld",
            "value": "false"
          },
          {
            "name": "gait",
            "value": 0
          },
          {
            "name": "moving",
            "value": 0
          },
          {
            "name": "dx",
            "value": 0
          },
          {
            "name": "dy",
            "value": 0
          },
          {
            "name": "range",
            "value": 4
          },
          {
            "name": "aim",
            "value": 0
          },
          {
            "name": "ratAim",
            "value": 0
          },
          {
            "name": "fight",
            "value": 0
          },
          {
            "name": "near",
            "value": "''"
          },
          {
            "name": "card",
            "value": "''"
          },
          {
            "name": "status",
            "value": "'Carnegie Hall - dressing rooms'"
          },
          {
            "name": "walkX",
            "value": "sceneState.walkX or 0"
          },
          {
            "name": "walkY",
            "value": "sceneState.walkY or 1"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "entryX",
            "value": "sceneState.walkX"
          },
          {
            "name": "entryY",
            "value": "sceneState.walkY"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "f_got_diary",
            "value": 0
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:got_diary",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "f_got_diary",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "f_got_dressing_ammo",
            "value": 0
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:got_dressing_ammo",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "f_got_dressing_ammo",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "f_got_rehearsal_key",
            "value": 0
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:got_rehearsal_key",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "f_got_rehearsal_key",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "f_has_rehearsal_key",
            "value": 0
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:has_rehearsal_key",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "f_has_rehearsal_key",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:seen_clown",
        "then": [],
        "else": [
          {
            "cmd": "SET_FLAG",
            "flag": "seen_clown",
            "value": true
          },
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "card",
                "value": "'A dying clown mutters about\\nthe singer, then goes still.\\nA parrot repeats his words.'"
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ui",
            "value": "sceneState.card ~= '' and 9 or 0"
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "READ_INPUT",
        "name": "input"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "dx",
            "value": "sceneState.ui == 0 and ((sceneState.input.RIGHT and 1 or 0) - (sceneState.input.LEFT and 1 or 0)) or 0"
          },
          {
            "name": "dy",
            "value": "sceneState.ui == 0 and ((sceneState.input.UP and 1 or 0) - (sceneState.input.DOWN and 1 or 0)) or 0"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "moving",
            "value": "(sceneState.dx ~= 0 or sceneState.dy ~= 0) and 1 or 0"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.moving == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "gait",
                "value": "sceneState.gait + time.dt * 10"
              },
              {
                "name": "aim",
                "value": "atan2(sceneState.dx, -sceneState.dy)"
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "walkX",
            "value": "max(-4.6, min(4.6, sceneState.walkX + sceneState.dx * 0.05))"
          },
          {
            "name": "walkY",
            "value": "max(0.3, min(5.6, sceneState.walkY + sceneState.dy * 0.05))"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.input.X and not sceneState.menuHeld and sceneState.ui == 0",
        "then": [
          {
            "cmd": "SET_GAME_VARIABLE",
            "name": "weapon",
            "value": "((variables.weapon or 'handgun') == 'baton' and 'handgun' or 'baton')"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "menuHeld",
            "value": "sceneState.input.X"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "near",
            "value": "''"
          },
          {
            "name": "status",
            "value": "'Carnegie Hall - dressing rooms'"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "((sceneState.walkX - (-4.6))^2 + (sceneState.walkY - (2.5))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'to_backstage'"
              },
              {
                "name": "status",
                "value": "'Enter: Backstage'"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "((sceneState.walkX - (4.6))^2 + (sceneState.walkY - (3))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'to_rehearsal'"
              },
              {
                "name": "status",
                "value": "'Enter: Rehearsal Room'"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.f_got_rehearsal_key == 0 and ((sceneState.walkX - (-3.5))^2 + (sceneState.walkY - (4.5))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'p:rehearsal_key'"
              },
              {
                "name": "status",
                "value": "'Enter: examine'"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.f_got_diary == 0 and ((sceneState.walkX - (3.5))^2 + (sceneState.walkY - (4.5))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'p:diary'"
              },
              {
                "name": "status",
                "value": "'Enter: examine'"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.f_got_dressing_ammo == 0 and ((sceneState.walkX - (0))^2 + (sceneState.walkY - (5))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'p:dressing_ammo'"
              },
              {
                "name": "status",
                "value": "'Enter: examine'"
              }
            ]
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 9",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "card",
                "value": "''"
              },
              {
                "name": "ui",
                "value": 0
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.near == 'to_backstage'",
            "then": [
              {
                "cmd": "SCENE_EVENT",
                "kind": "goto",
                "scene": "day1_backstage",
                "sceneState": [
                  {
                    "name": "walkX",
                    "value": 3.6
                  },
                  {
                    "name": "walkY",
                    "value": 2.5
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.near == 'to_rehearsal'",
            "then": [
              {
                "cmd": "IF",
                "condition": "flag:has_rehearsal_key",
                "then": [
                  {
                    "cmd": "SCENE_EVENT",
                    "kind": "goto",
                    "scene": "day1_rehearsal",
                    "sceneState": [
                      {
                        "name": "walkX",
                        "value": -4.2
                      },
                      {
                        "name": "walkY",
                        "value": 3
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "card",
                        "value": "'Locked. There must be a key.'"
                      },
                      {
                        "name": "ui",
                        "value": 9
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.near == 'p:rehearsal_key'",
            "then": [
              {
                "cmd": "SET_FLAG",
                "flag": "got_rehearsal_key",
                "value": true
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "f_got_rehearsal_key",
                    "value": 1
                  }
                ]
              },
              {
                "cmd": "SET_FLAG",
                "flag": "has_rehearsal_key",
                "value": true
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "card",
                    "value": "'Found the Rehearsal Room key.'"
                  },
                  {
                    "name": "ui",
                    "value": 9
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.near == 'p:diary'",
            "then": [
              {
                "cmd": "SET_FLAG",
                "flag": "got_diary",
                "value": true
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "f_got_diary",
                    "value": 1
                  }
                ]
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "card",
                    "value": "'Melissa\\'s diary:\\n\\'Tonight I play the part\\nalone... I can feel it.\\''"
                  },
                  {
                    "name": "ui",
                    "value": 9
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "sceneState.near == 'p:dressing_ammo'",
            "then": [
              {
                "cmd": "SET_FLAG",
                "flag": "got_dressing_ammo",
                "value": true
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "f_got_dressing_ammo",
                    "value": 1
                  }
                ]
              },
              {
                "cmd": "CHANGE_ITEM",
                "item": "handgun_ammo",
                "count": 12
              },
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "card",
                    "value": "'Found handgun rounds. Ammo +12'"
                  },
                  {
                    "name": "ui",
                    "value": 9
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "choice",
                "value": "(sceneState.choice+3)%4"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 4",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "choice",
                "value": "(sceneState.choice+1)%2"
              }
            ]
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "choice",
                "value": "(sceneState.choice+1)%4"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 4",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "choice",
                "value": "(sceneState.choice+1)%2"
              }
            ]
          }
        ]
      }
    ],
    "on_left": [],
    "on_right": []
  }
}
