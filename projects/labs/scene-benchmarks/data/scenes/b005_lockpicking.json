{
  "id": "b005_lockpicking",
  "terminal": {
    "reached": "v.state == 'won' or v.state == 'failed'",
    "script": [
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"wait": 0.2},
      {"key": "return"}
    ]
  },
  "name": "B005 — Lockpicking",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": { "x": 4, "y": 2, "w": 24, "h": 4 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "B005 — Lockpicking" }
      ]
    },
    {
      "id": "board",
      "rect": { "x": 2, "y": 7, "w": 28, "h": 8 },
      "style": "frame",
      "content": [
        { "type": "text", "y": 2, "text": "Pins Picked: {v.pins_picked} / {v.total_pins}" },
        { "type": "text", "y": 4, "text": "{v.status_text}" }
      ]
    },
    {
      "id": "bar_bg",
      "rect": { "x": 4, "y": 8, "w": 24, "h": 1 },
      "style": "panel",
      "content": [
        { "type": "text", "text": "------------------------" }
      ]
    },
    {
      "id": "sweet_spot",
      "rect": { "x": "4 + math.floor((v.sweet_spot_start / 100) * 24)", "y": 8, "w": "math.max(1, math.floor((v.sweet_spot_width / 100) * 24))", "h": 1 },
      "style": "panel",
      "content": [
        { "type": "text", "text": "========================" }
      ]
    },
    {
      "id": "cursor",
      "rect": { "x": "4 + math.floor((v.cursor_pos / 100) * 24)", "y": 8, "w": 1, "h": 1 },
      "style": "panel",
      "content": [
        { "type": "text", "text": "O" }
      ]
    },
    {
      "id": "help",
      "rect": { "x": 4, "y": 17, "w": 24, "h": 3 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "A (Enter) pick   B (Escape) back" }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "state", "value": "'picking'" },
          { "name": "pins_picked", "value": "0" },
          { "name": "total_pins", "value": "3" },
          { "name": "cursor_pos", "value": "0" },
          { "name": "cursor_dir", "value": "1" },
          { "name": "cursor_speed", "value": "30" },
          { "name": "sweet_spot_start", "value": "20" },
          { "name": "sweet_spot_width", "value": "15" },
          { "name": "status_text", "value": "'Press ENTER in the sweet spot!'" }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v.state == 'picking'",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "cursor_pos", "value": "v.cursor_pos + (v.cursor_speed * v.cursor_dir * v.time.dt)" },
              { "name": "cursor_dir", "value": "v.cursor_pos > 100 and -1 or (v.cursor_pos < 0 and 1 or v.cursor_dir)" },
              { "name": "cursor_pos", "value": "math.max(0, math.min(100, v.cursor_pos))" }
            ]
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "v.state ~= 'picking'",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "state", "value": "'picking'" },
              { "name": "pins_picked", "value": "0" },
              { "name": "cursor_speed", "value": "30" },
              { "name": "sweet_spot_start", "value": "20" },
              { "name": "status_text", "value": "'Press ENTER in the sweet spot!'" }
            ]
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "v.cursor_pos >= v.sweet_spot_start and v.cursor_pos <= v.sweet_spot_start + v.sweet_spot_width",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  { "name": "pins_picked", "value": "v.pins_picked + 1" },
                  { "name": "state", "value": "v.pins_picked >= v.total_pins and 'won' or 'picking'" },
                  { "name": "status_text", "value": "v.pins_picked >= v.total_pins and 'LOCK PICKED! Press ENTER to replay.' or 'Pin set!'" },
                  { "name": "cursor_speed", "value": "v.cursor_speed + 15" },
                  { "name": "sweet_spot_start", "value": "math.random(10, 70)" }
                ]
              }
            ],
            "else": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  { "name": "state", "value": "'failed'" },
                  { "name": "status_text", "value": "'FAILED! Pick broke. Press ENTER to retry.'" }
                ]
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  }
}
