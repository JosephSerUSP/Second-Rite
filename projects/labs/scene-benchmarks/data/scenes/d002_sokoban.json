    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "_guard",
        "value": 0
      },
      {
        "cmd": "IF",
        "condition": "not v.win",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "nx",
                "value": "v.px + (0)"
              },
              {
                "name": "ny",
                "value": "v.py + (-1)"
              },
              {
                "name": "dx",
                "value": 0
              },
              {
                "name": "dy",
                "value": -1
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "nWall",
                "value": "v.nx <= 0 or v.nx >= 6 or v.ny <= 0 or v.ny >= 4 or (v.nx == 5 and v.ny == 1) or (v.nx == 1 and v.ny == 2) or (v.nx == 2 and v.ny == 2)"
              },
              {
                "name": "nCrate1",
                "value": "v.nx == v.c1x and v.ny == v.c1y"
              },
              {
                "name": "nCrate2",
                "value": "v.nx == v.c2x and v.ny == v.c2y"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "not v.nWall and (v.nCrate1 or v.nCrate2)",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "nnx",
                    "value": "v.nx + v.dx"
                  },
                  {
                    "name": "nny",
                    "value": "v.ny + v.dy"
                  },
                  {
                    "name": "nnWall",
                    "value": "v.nnx <= 0 or v.nnx >= 6 or v.nny <= 0 or v.nny >= 4 or (v.nnx == 5 and v.nny == 1) or (v.nnx == 1 and v.nny == 2) or (v.nnx == 2 and v.nny == 2)"
                  },
                  {
                    "name": "nnCrate1",
                    "value": "v.nnx == v.c1x and v.nny == v.c1y"
                  },
                  {
                    "name": "nnCrate2",
                    "value": "v.nnx == v.c2x and v.nny == v.c2y"
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "not v.nnWall and not v.nnCrate1 and not v.nnCrate2",
                "then": [
                  {
                    "cmd": "SET_VAR",
                    "assignments": [
                      {
                        "name": "px",
                        "value": "v.nx"
                      },
                      {
                        "name": "py",
                        "value": "v.ny"
                      }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "v.nCrate1",
                    "then": [
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          {
                            "name": "c1x",
                            "value": "v.nnx"
                          },
                          {
                            "name": "c1y",
                            "value": "v.nny"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "v.nCrate2",
                    "then": [
                      {
                        "cmd": "SET_VAR",
                        "assignments": [
                          {
                            "name": "c2x",
                            "value": "v.nnx"
                          },
                          {
                            "name": "c2y",
                            "value": "v.nny"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "not v.nWall and not v.nCrate1 and not v.nCrate2",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "px",
                    "value": "v.nx"
                  },
                  {
                    "name": "py",
                    "value": "v.ny"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "c1OnGoal",
                "value": "(v.c1x == 1 and v.c1y == 1) or (v.c1x == 2 and v.c1y == 1)"
              },
              {
                "name": "c2OnGoal",
                "value": "(v.c2x == 1 and v.c2y == 1) or (v.c2x == 2 and v.c2y == 1)"
              },
              {
                "name": "win",
                "value": "v.c1OnGoal and v.c2OnGoal"
              }
            ]
          }
        ]
      }
