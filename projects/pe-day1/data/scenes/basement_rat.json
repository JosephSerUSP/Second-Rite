    "on_cancel": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui > 0 and rt.outcome == ''",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ui",
                "value": 0
              },
              {
                "name": "status",
                "value": "''"
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "REALTIME_BATTLE_END"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
