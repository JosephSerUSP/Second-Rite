{
  "id": "picture_formula_probe",
  "kind": "fixture",
  "hooks": {
    "on_enter": [
      { "cmd": "SET_VAR", "name": "ballX", "value": "32" },
      { "cmd": "SET_VAR", "name": "ballY", "value": "16" },
      {
        "cmd": "SHOW_IMAGE_PICTURE",
        "id": 1,
        "path": "assets/system/Cursor.png",
        "x": "v.ballX",
        "y": "v.ballY",
        "anchor": "center",
        "opacity": "1",
        "scale": "1",
        "rotation": "0",
        "layer": "screen"
      }
    ],
    "on_right": [
      { "cmd": "SET_VAR", "name": "ballX", "value": "clamp(v.ballX + 80, 0, 112)" },
      { "cmd": "SET_VAR", "name": "ballY", "value": "v.ballY * 2 + 15" },
      {
        "cmd": "MOVE_IMAGE_PICTURE",
        "id": 1,
        "x": "v.ballX",
        "y": "clamp(v.ballY, 0, 47)",
        "duration": 0,
        "easing": "linear"
      }
    ]
  }
}
