{
  "id": "b009_positioning",
  "name": "B009 — Parasite-Eve-Like Positioning Proof",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B009 — Positioning Proof   State: {v.stateText}"
        }
      ]
    },
    {
      "id": "arena",
      "rect": {
        "x": 2,
        "y": 4,
        "w": 28,
        "h": 16
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "player",
      "rect": {
        "x": "2 + 1 + v.px",
        "y": "4 + 1 + v.py",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        { "type": "text", "text": "@" }
      ]
    },
    {
      "id": "enemy",
      "rect": {
        "x": "2 + 1 + v.ex",
        "y": "4 + 1 + v.ey",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        { "type": "text", "text": "E" }
      ]
    },
    {
      "id": "target_area",
      "rect": {
        "x": "2 + 1 + v.px - v.range",
        "y": "4 + 1 + v.py - v.range",
        "w": "v.range * 2 + 1",
        "h": "v.range * 2 + 1"
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "atb_gauge",
      "rect": {
        "x": 2,
        "y": 20,
        "w": 14,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 12,
          "label": "ATB",
          "value": "v.atb",
          "max": "100",
          "color": [0.2, 0.2, 0.2],
          "fill": [0.0, 1.0, 0.0]
        }
      ]
    },
    {
      "id": "hp_gauge",
      "rect": {
        "x": 16,
        "y": 20,
        "w": 14,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 12,
          "label": "Enemy HP",
          "value": "v.ehp",
          "max": "100",
          "color": [0.2, 0.2, 0.2],
          "fill": [1.0, 0.0, 0.0]
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SCRIPT",
        "ref": "init"
      }
    ],
    "on_frame": [
      {
        "cmd": "SCRIPT",
        "ref": "update"
      },
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "inputX", "value": 0 },
          { "name": "inputY", "value": 0 }
        ]
      }
    ],
    "on_up": [
      { "cmd": "SET_VAR", "name": "inputY", "value": -1 }
    ],
    "on_down": [
      { "cmd": "SET_VAR", "name": "inputY", "value": 1 }
    ],
    "on_left": [
      { "cmd": "SET_VAR", "name": "inputX", "value": -1 }
    ],
    "on_right": [
      { "cmd": "SET_VAR", "name": "inputX", "value": 1 }
    ],
    "on_select": [
      { "cmd": "SCRIPT", "ref": "action" }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {
    "init": "local v = ctx.v; v.px = 10; v.py = 10; v.ex = 20; v.ey = 5; v.atb = 0; v.ehp = 100; v.stateText = 'Moving'; v.range = 5; v.speed = 10.0; v.mode = 'move'; v.actionTimer = 0; v.inputX = 0; v.inputY = 0;",
    "update": "local v = ctx.v; local dt = time.dt; if v.mode == 'move' then v.atb = math.min(100, v.atb + 20 * dt); v.px = math.max(0, math.min(25, v.px + v.inputX * v.speed * dt)); v.py = math.max(0, math.min(13, v.py + v.inputY * v.speed * dt)); else v.actionTimer = v.actionTimer - dt; if v.actionTimer <= 0 then v.mode = 'move'; v.stateText = 'Moving' end end; if v.ehp <= 0 then v.stateText = 'VICTORY!' end",
    "action": "local v = ctx.v; if v.mode == 'move' and v.atb >= 100 then v.mode = 'action'; v.atb = 0; v.actionTimer = 1.0; v.stateText = 'Action Phase!'; local dist = math.abs(v.px - v.ex) + math.abs(v.py - v.ey); if dist <= v.range then v.ehp = math.max(0, v.ehp - 30); v.stateText = 'HIT!' else v.stateText = 'MISSED! (Out of range)' end end"
  },
  "goldenScript": [
    { "key": "right" },
    { "key": "right" },
    { "key": "return" },
    { "key": "left" },
    { "key": "b" }
  ]
}
