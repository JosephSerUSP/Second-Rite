  "geometry": {
    "topologies": [
      {
        "id": "plane",
        "label": "Plane",
        "description": "A displaced rectangular surface: walls, floors, ceilings, doors, shallow fixtures."
      },
      {
        "id": "shell",
        "label": "Shell",
        "description": "One or two displaced surfaces joined around a shared silhouette."
      },
      {
        "id": "radial",
        "label": "Radial",
        "description": "A surface storing radius over angle and height."
      }
    ],
    "roles": [
      {
        "id": "surfaceFixture",
        "label": "Surface fixture",
        "description": "Composited into architectural albedo and height before meshing."
      },
      {
        "id": "objectFixture",
        "label": "Object fixture",
        "description": "A separately placed mesh."
      }
    ],
    "planeSurfaces": [
      {
        "id": "wall",
        "label": "Wall",
        "description": "Stands on a wall face; local +X is depth out of the wall."
      },
      {
        "id": "floor",
        "label": "Floor",
        "description": "Lies on the cell floor; displacement is upward."
      },
      {
        "id": "ceiling",
        "label": "Ceiling",
        "description": "Hangs from the cell ceiling; displacement is downward."
      },
      {
        "id": "wallTop",
        "label": "Wall Top",
        "description": "Upward-facing cap of a solid wall cell; local +Z is outward."
      }
    ],
    "heightOperations": [
      {
        "id": "none",
        "label": "None",
        "description": "Ignore height; composite albedo only."
      },
      {
        "id": "add",
        "label": "Add",
        "description": "base + signedOverlay * alpha."
      },
      {
        "id": "replace",
        "label": "Replace",
        "description": "mix(base, overlay, alpha)."
      }
    ],
    "shellModes": [
      {
        "id": "frontOnly",
        "label": "Front only",
        "description": "One surface; a one-sided or compiler-thickened object."
      },
      {
        "id": "mirrorDepth",
        "label": "Mirrored depth",
        "description": "One depth field reflected through the central plane."
      },
      {
        "id": "frontBack",
        "label": "Front / back",
        "description": "Independent front and rear depth fields sharing one silhouette."
      }
    ],
    "layouts": [
      {
        "id": "single",
        "label": "Single",
        "description": "One region covering the whole image."
      },
      {
        "id": "frontBackHorizontal",
        "label": "Front/back horizontal",
        "description": "Front in the left half, back in the right half."
      }
    ],
    "edgeModes": [
      {
        "id": "stitch",
        "label": "Stitch",
        "description": "Bridge front and rear contours with explicit side faces."
      },
      {
        "id": "pinch",
        "label": "Pinch",
        "description": "Converge both depths near the silhouette into a thin edge."
      }
    ],
    "edgeColors": [
      {
        "id": "blend",
        "label": "Blend",
        "description": "Average the front and rear boundary colours."
      },
      {
        "id": "front",
        "label": "Front",
        "description": "Sample the front boundary colour."
      },
      {
        "id": "back",
        "label": "Back",
        "description": "Sample the rear boundary colour."
      },
      {
        "id": "darkenedBlend",
        "label": "Darkened blend",
        "description": "Darkened average; reinforces volume and separates the painted faces."
      }
    ],
    "quality": {
      "densityScale": 1,
      "maxError": 0.0001
    },
    "materialBlendOps": [
      {
        "id": "add",
        "label": "Add",
        "description": "base + layer. PS1 semi-transparency mode B+F: sheen, glow, gem sparkle."
      },
      {
        "id": "subtract",
        "label": "Subtract",
        "description": "base - layer. PS1 mode B-F: soot, tarnish, shadowing."
      },
      {
        "id": "multiply",
        "label": "Multiply",
        "description": "base * layer: grime, staining, printed detail."
      },
      {
        "id": "screen",
        "label": "Screen",
        "description": "1-(1-base)(1-layer): frost, bloom, dusting."
      },
      {
        "id": "mix",
        "label": "Mix",
        "description": "Interpolate toward the layer: a plain overlay decal."
      }
    ],
    "materialUvSources": [
      {
        "id": "uv",
        "label": "Model UVs",
        "description": "The model's authored texture coordinates, as the albedo uses."
      },
      {
        "id": "sphere",
        "label": "Sphere map",
        "description": "Sphere-mapped from the screen-space normal: a matcap."
      }
    ]
