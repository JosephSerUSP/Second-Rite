{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-rite.local/authoring-census.schema.json",
  "title": "Second Rite Authoring Surface Census",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": [
        "Dungeons",
        "Formations",
        "Actors",
        "Monsters",
        "Items",
        "Encounters",
        "Camera / Viewport",
        "Visual Layers",
        "Event / Interaction Data",
        "Skills / States",
        "Animations",
        "Flows / Scenes"
      ]
    },
    "dimensionState": {
      "type": "string",
      "enum": [
        "covered",
        "missing",
        "not-applicable"
      ]
    },
    "dimensionName": {
      "type": "string",
      "enum": [
        "runtimeExists",
        "persisted",
        "authorable",
        "livePreview",
        "goldenFixture",
        "parityCovered",
        "roundTripCovered",
        "hardeningCovered"
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "domain",
        "runtimeExists",
        "persisted",
        "authorable",
        "livePreview",
        "goldenFixture",
        "parityCovered",
        "roundTripCovered",
        "hardeningCovered",
        "deferredDebt",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "runtimeExists": {
          "$ref": "#/$defs/dimensionState"
        },
        "persisted": {
          "$ref": "#/$defs/dimensionState"
        },
        "authorable": {
          "$ref": "#/$defs/dimensionState"
        },
        "livePreview": {
          "$ref": "#/$defs/dimensionState"
        },
        "goldenFixture": {
          "$ref": "#/$defs/dimensionState"
        },
        "parityCovered": {
          "$ref": "#/$defs/dimensionState"
        },
        "roundTripCovered": {
          "$ref": "#/$defs/dimensionState"
        },
        "hardeningCovered": {
          "$ref": "#/$defs/dimensionState"
        },
        "deferredDebt": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dimensionName"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
