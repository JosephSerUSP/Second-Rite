        "x": 5,
        "y": 1,
        "w": 22,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "C002 — Splitting Pong   Score: {sceneState.score1} - {sceneState.score2}"
