        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball3Y",
                "value": "sceneState.gridH - 1"
              },
              {
                "name": "ball3VY",
                "value": "-sceneState.ball3VY"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball1X <= 1 and sceneState.ball1X >= 0 and sceneState.ball1VX < 0 and sceneState.ball1Y >= sceneState.paddle1Y and sceneState.ball1Y <= sceneState.paddle1Y + sceneState.paddleH",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball1X",
                "value": 1
              },
              {
                "name": "ball1VX",
                "value": "-sceneState.ball1VX * 1.1"
              },
              {
                "name": "ball1VY",
                "value": "sceneState.ball1VY + (sceneState.ball1Y - (sceneState.paddle1Y + sceneState.paddleH/2)) * 2"
              },
              {
                "name": "hits",
                "value": "sceneState.hits + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball2Active > 0 and sceneState.ball2X <= 1 and sceneState.ball2X >= 0 and sceneState.ball2VX < 0 and sceneState.ball2Y >= sceneState.paddle1Y and sceneState.ball2Y <= sceneState.paddle1Y + sceneState.paddleH",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ball2X",
                "value": 1
              },
              {
                "name": "ball2VX",
                "value": "-sceneState.ball2VX * 1.1"
              },
              {
                "name": "ball2VY",
                "value": "sceneState.ball2VY + (sceneState.ball2Y - (sceneState.paddle1Y + sceneState.paddleH/2)) * 2"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.ball3Active > 0 and sceneState.ball3X <= 1 and sceneState.ball3X >= 0 and sceneState.ball3VX < 0 and sceneState.ball3Y >= sceneState.paddle1Y and sceneState.ball3Y <= sceneState.paddle1Y + sceneState.paddleH",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
