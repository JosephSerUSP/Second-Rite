{
  "id": "a001_pong",
  "terminal": {
    "none": "spec requires scoring, reset after score and a restartable lifecycle, but no match-win threshold: an endless rally is the authored contract, and reset is a mid-game transition rather than a terminal state"
  },
  "name": "A001 \u2014 Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": { "x": 5, "y": 1, "w": 22, "h": 3 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "A001 \u2014 Pong   Score: {v.score1} - {v.score2}" }
      ]
    },
    {
      "id": "board_outline",
      "rect": { "x": 5, "y": 5, "w": 22, "h": 15 },
      "style": "frame",
      "content": []
    },
    {
      "id": "paddle1",
      "rect": { "x": 6, "y": "6 + v.paddle1Y", "w": 1, "h": "v.paddleH" },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle2",
      "rect": { "x": "5 + v.gridW", "y": "6 + v.paddle2Y", "w": 1, "h": "v.paddleH" },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball",
      "rect": { "x": "6 + v.ballX", "y": "6 + v.ballY", "w": 1, "h": 1 },
      "style": "panel",
      "content": [
        { "type": "text", "text": "O" }
      ]
    },
    {
      "id": "help",
      "rect": { "x": 4, "y": 21, "w": 24, "h": 3 },
      "style": "frame",
      "content": [
        { "type": "text", "text": "UP/DOWN move   Enter restart   B back" }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "_guard", "value": 0 },
          { "name": "gridW", "value": 20 },
          { "name": "gridH", "value": 13 },
          { "name": "paddle1Y", "value": 6 },
          { "name": "paddle2Y", "value": 6 },
          { "name": "paddleH", "value": 3 },
          { "name": "ballX", "value": 10.0 },
          { "name": "ballY", "value": 6.0 },
          { "name": "ballVX", "value": 10.0 },
          { "name": "ballVY", "value": 6.0 },
          { "name": "score1", "value": "v.score1 or 0" },
          { "name": "score2", "value": "v.score2 or 0" },
          { "name": "inputY", "value": 0 }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "paddle1Y", "value": 6 },
          { "name": "paddle2Y", "value": 6 },
          { "name": "ballX", "value": 10.0 },
          { "name": "ballY", "value": 6.0 },
          { "name": "ballVX", "value": 10.0 },
          { "name": "ballVY", "value": 6.0 },
          { "name": "score1", "value": 0 },
          { "name": "score2", "value": 0 },
          { "name": "inputY", "value": 0 }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          { "name": "paddle1Y", "value": "clamp(v.paddle1Y + v.inputY * 15.0 * v.time.dt, 0, v.gridH - v.paddleH)" },
          { "name": "inputY", "value": 0 },
          { "name": "center2", "value": "v.paddle2Y + v.paddleH / 2" },
          { "name": "paddle2Y", "value": "clamp(v.paddle2Y + (v.center2 < v.ballY - 0.5 and 8.0 or (v.center2 > v.ballY + 0.5 and -8.0 or 0)) * v.time.dt, 0, v.gridH - v.paddleH)" },
          { "name": "ballX", "value": "v.ballX + v.ballVX * v.time.dt" },
          { "name": "ballY", "value": "v.ballY + v.ballVY * v.time.dt" },
          { "name": "hitP1", "value": "v.ballX <= 1 and v.ballX >= 0 and v.ballVX < 0 and v.ballY >= v.paddle1Y and v.ballY <= v.paddle1Y + v.paddleH" },
          { "name": "hitP2", "value": "v.ballX >= v.gridW - 2 and v.ballX <= v.gridW - 1 and v.ballVX > 0 and v.ballY >= v.paddle2Y and v.ballY <= v.paddle2Y + v.paddleH" }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballY <= 0 or v.ballY >= v.gridH - 1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "ballY", "value": "clamp(v.ballY, 0, v.gridH - 1)" },
              { "name": "ballVY", "value": "-v.ballVY" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hitP1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "ballX", "value": 1 },
              { "name": "ballVX", "value": "abs(v.ballVX) * 1.1" },
              { "name": "ballVY", "value": "v.ballVY + (v.ballY - (v.paddle1Y + v.paddleH/2)) * 2" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hitP2",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "ballX", "value": "v.gridW - 2" },
              { "name": "ballVX", "value": "-abs(v.ballVX) * 1.1" },
              { "name": "ballVY", "value": "v.ballVY + (v.ballY - (v.paddle2Y + v.paddleH/2)) * 2" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX < 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "score2", "value": "v.score2 + 1" },
              { "name": "ballX", "value": 10.0 },
              { "name": "ballY", "value": 6.0 },
              { "name": "ballVX", "value": 10.0 },
              { "name": "ballVY", "value": 6.0 }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX >= v.gridW",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              { "name": "score1", "value": "v.score1 + 1" },
              { "name": "ballX", "value": 10.0 },
              { "name": "ballY", "value": 6.0 },
              { "name": "ballVX", "value": -10.0 },
              { "name": "ballVY", "value": 6.0 }
            ]
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {},
  "goldenScript": [
    {
      "key": "down"
    },
    {
      "key": "down"
    },
    {
      "key": "up"
    },
    {
      "key": "return"
    },
    {
      "key": "escape"
    }
  ]
}
