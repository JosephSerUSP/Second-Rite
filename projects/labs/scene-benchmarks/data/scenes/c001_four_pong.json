{
  "id": "c001_four_pong",
  "terminal": {
    "none": "spec requires an endless rally"
  },
  "name": "C001 \u2014 Four-Paddle Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "C001 \u2014 Four-Paddle Pong   Rallies: {v.rallies}"
        }
      ]
    },
    {
      "id": "board_outline",
      "rect": {
        "x": 6,
        "y": 5,
        "w": 20,
        "h": 15
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "paddle1",
      "rect": {
        "x": "6 + 1",
        "y": "5 + 1 + v.paddle1Y",
        "w": 1,
        "h": "v.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle2",
      "rect": {
        "x": "6 + v.gridW",
        "y": "5 + 1 + v.paddle2Y",
        "w": 1,
        "h": "v.paddleH"
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle3",
      "rect": {
        "x": "6 + 1 + v.paddle3X",
        "y": "5 + 1",
        "w": "v.paddleW",
        "h": 1
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle4",
      "rect": {
        "x": "6 + 1 + v.paddle4X",
        "y": "5 + v.gridH",
        "w": "v.paddleW",
        "h": 1
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball",
      "rect": {
        "x": "6 + 1 + v.ballX",
        "y": "5 + 1 + v.ballY",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 2,
        "y": 21,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Arrows move   Enter restart   B back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "_guard",
            "value": 0
          },
          {
            "name": "gridW",
            "value": 18
          },
          {
            "name": "gridH",
            "value": 13
          },
          {
            "name": "paddle1Y",
            "value": 5
          },
          {
            "name": "paddle2Y",
            "value": 5
          },
          {
            "name": "paddle3X",
            "value": 7
          },
          {
            "name": "paddle4X",
            "value": 7
          },
          {
            "name": "paddleH",
            "value": 3
          },
          {
            "name": "paddleW",
            "value": 4
          },
          {
            "name": "ballX",
            "value": 9.0
          },
          {
            "name": "ballY",
            "value": 6.0
          },
          {
            "name": "ballVX",
            "value": 7.0
          },
          {
            "name": "ballVY",
            "value": 7.0
          },
          {
            "name": "rallies",
            "value": "v.rallies or 0"
          },
          {
            "name": "inputY",
            "value": 0
          },
          {
            "name": "inputX",
            "value": 0
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "paddle1Y",
            "value": "max(1, min(v.gridH - v.paddleH - 1, v.paddle1Y + v.inputY * 15.0 * v.time.dt))"
          },
          {
            "name": "paddle3X",
            "value": "max(1, min(v.gridW - v.paddleW - 1, v.paddle3X + v.inputX * 15.0 * v.time.dt))"
          },
          {
            "name": "inputY",
            "value": 0
          },
          {
            "name": "inputX",
            "value": 0
          },
          {
            "name": "center2",
            "value": "v.paddle2Y + v.paddleH / 2"
          },
          {
            "name": "paddle2Y",
            "value": "v.center2 < v.ballY - 0.5 and v.paddle2Y + 8.0 * v.time.dt or (v.center2 > v.ballY + 0.5 and v.paddle2Y - 8.0 * v.time.dt or v.paddle2Y)"
          },
          {
            "name": "paddle2Y",
            "value": "max(1, min(v.gridH - v.paddleH - 1, v.paddle2Y))"
          },
          {
            "name": "center4",
            "value": "v.paddle4X + v.paddleW / 2"
          },
          {
            "name": "paddle4X",
            "value": "v.center4 < v.ballX - 0.5 and v.paddle4X + 8.0 * v.time.dt or (v.center4 > v.ballX + 0.5 and v.paddle4X - 8.0 * v.time.dt or v.paddle4X)"
          },
          {
            "name": "paddle4X",
            "value": "max(1, min(v.gridW - v.paddleW - 1, v.paddle4X))"
          },
          {
            "name": "ballX",
            "value": "v.ballX + v.ballVX * v.time.dt"
          },
          {
            "name": "ballY",
            "value": "v.ballY + v.ballVY * v.time.dt"
          },
          {
            "name": "hitPaddle1",
            "value": "v.ballX <= 1 and v.ballX >= 0 and v.ballVX < 0 and v.ballY >= v.paddle1Y and v.ballY <= v.paddle1Y + v.paddleH"
          },
          {
            "name": "hitPaddle2",
            "value": "v.ballX >= v.gridW - 2 and v.ballX <= v.gridW - 1 and v.ballVX > 0 and v.ballY >= v.paddle2Y and v.ballY <= v.paddle2Y + v.paddleH"
          },
          {
            "name": "hitPaddle3",
            "value": "v.ballY <= 1 and v.ballY >= 0 and v.ballVY < 0 and v.ballX >= v.paddle3X and v.ballX <= v.paddle3X + v.paddleW"
          },
          {
            "name": "hitPaddle4",
            "value": "v.ballY >= v.gridH - 2 and v.ballY <= v.gridH - 1 and v.ballVY > 0 and v.ballX >= v.paddle4X and v.ballX <= v.paddle4X + v.paddleW"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hitPaddle1",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballX",
                "value": 1
              },
              {
                "name": "ballVX",
                "value": "-v.ballVX * 1.1"
              },
              {
                "name": "ballVY",
                "value": "v.ballVY + (v.ballY - (v.paddle1Y + v.paddleH/2)) * 2"
              },
              {
                "name": "rallies",
                "value": "v.rallies + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hitPaddle2",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballX",
                "value": "v.gridW - 2"
              },
              {
                "name": "ballVX",
                "value": "-v.ballVX * 1.1"
              },
              {
                "name": "ballVY",
                "value": "v.ballVY + (v.ballY - (v.paddle2Y + v.paddleH/2)) * 2"
              },
              {
                "name": "rallies",
                "value": "v.rallies + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hitPaddle3",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballY",
                "value": 1
              },
              {
                "name": "ballVY",
                "value": "-v.ballVY * 1.1"
              },
              {
                "name": "ballVX",
                "value": "v.ballVX + (v.ballX - (v.paddle3X + v.paddleW/2)) * 2"
              },
              {
                "name": "rallies",
                "value": "v.rallies + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.hitPaddle4",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballY",
                "value": "v.gridH - 2"
              },
              {
                "name": "ballVY",
                "value": "-v.ballVY * 1.1"
              },
              {
                "name": "ballVX",
                "value": "v.ballVX + (v.ballX - (v.paddle4X + v.paddleW/2)) * 2"
              },
              {
                "name": "rallies",
                "value": "v.rallies + 1"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ballX < 0 or v.ballX >= v.gridW or v.ballY < 0 or v.ballY >= v.gridH",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "ballX",
                "value": 9.0
              },
              {
                "name": "ballY",
                "value": 6.0
              },
              {
                "name": "ballVX",
                "value": "v.ballX < 0 and 7.0 or (v.ballX >= v.gridW and -7.0 or 0.0)"
              },
              {
                "name": "ballVY",
                "value": "v.ballY < 0 and 7.0 or (v.ballY >= v.gridH and -7.0 or (v.ballVX == 0.0 and 7.0 or v.ballVY))"
              },
              {
                "name": "ballVX",
                "value": "v.ballVX == 0.0 and 7.0 or v.ballVX"
              }
            ]
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_left": [
      {
        "cmd": "SET_VAR",
        "name": "inputX",
        "value": -1
      }
    ],
    "on_right": [
      {
        "cmd": "SET_VAR",
        "name": "inputX",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "ballX",
            "value": 9.0
          },
          {
            "name": "ballY",
            "value": 6.0
          },
          {
            "name": "ballVX",
            "value": 7.0
          },
          {
            "name": "ballVY",
            "value": 7.0
          },
          {
            "name": "rallies",
            "value": 0
          },
          {
            "name": "paddle1Y",
            "value": 5
          },
          {
            "name": "paddle2Y",
            "value": 5
          },
          {
            "name": "paddle3X",
            "value": 7
          },
          {
            "name": "paddle4X",
            "value": 7
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "scripts": {},
  "goldenScript": [
    {
      "key": "down"
    },
    {
      "key": "right"
    },
    {
      "key": "up"
    },
    {
      "key": "return"
    },
    {
      "key": "escape"
    }
  ]
}
