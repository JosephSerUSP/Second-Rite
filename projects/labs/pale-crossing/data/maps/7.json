      "commands": [
        {
          "cmd": "TEXT",
          "text": "In the center of the pale stone sits a single pedestal bearing an unwritten contract seal."
        },
        {
          "cmd": "TEXT",
          "text": "The voices of Ines, of St. Maria, and of the underground transit lines converge into a quiet, breathless clarity."
        },
        {
          "cmd": "TEXT",
          "text": "You have reached the edge of the known Labyrinth. Two irrevocable choices lie before you:"
        },
        {
          "cmd": "CHOICE",
          "options": [
            {
              "label": "Return with Saban \u2014 Seal the Pale Gate",
              "commands": [
                {
                  "cmd": "SET_FLAG",
                  "flag": "ending_return_with_saban",
                  "value": true
                },
                {
                  "cmd": "TEXT",
                  "text": "You drive your summoner's seal into the pedestal, locking the deep rupture shut."
                },
                {
                  "cmd": "TEXT",
                  "text": "Saban rests his head upon your shoulder as the white stone begins to warm with morning light..."
                },
                {
                  "cmd": "LOAD_MAP",
                  "mapId": 8
                }
              ]
            },
            {
              "label": "Cross the Boundary \u2014 Awaken the Second Rite",
              "commands": [
