{
  "id": "a001_pong",
  "terminal": {
    "none": "pong"
  },
  "name": "A001 — Pong",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 26,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "A001 PONG | {sceneState.score1} - {sceneState.score2}"
        }
      ]
    },
    {
      "id": "paddle1",
      "rect": {
        "x": 3,
        "y": "sceneState.p1y",
        "w": 1,
        "h": 4
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "paddle2",
      "rect": {
        "x": 26,
        "y": "sceneState.p2y",
        "w": 1,
        "h": 4
      },
      "style": "panel",
      "content": []
    },
    {
      "id": "ball",
      "rect": {
        "x": "sceneState.bx",
        "y": "sceneState.by",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "O"
        }
      ]
    },
    {
      "id": "help",
      "rect": {
        "x": 2,
        "y": 20,
        "w": 26,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "UP/DOWN: Move | Enter: Restart | B: Back"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          { "name": "score1", "value": 0 },
          { "name": "score2", "value": 0 },
          { "name": "p1y", "value": 10 },
          { "name": "p2y", "value": 10 },
          { "name": "bx", "value": 15 },
          { "name": "by", "value": 12 },
          { "name": "bvx", "value": 15 },
          { "name": "bvy", "value": 8 },
          { "name": "input_y", "value": 0 }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          { "name": "score1", "value": 0 },
          { "name": "score2", "value": 0 },
          { "name": "p1y", "value": 10 },
          { "name": "p2y", "value": 10 },
          { "name": "bx", "value": 15 },
          { "name": "by", "value": 12 },
          { "name": "bvx", "value": 15 },
          { "name": "bvy", "value": 8 },
          { "name": "input_y", "value": 0 }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "input_y",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "input_y",
        "value": 1
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ],
    "on_frame": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          { "name": "p1y", "value": "max(4, min(16, sceneState.p1y + sceneState.input_y * 20.0 * sceneState.time.dt))" },
          { "name": "input_y", "value": 0 },
          { "name": "p2y", "value": "max(4, min(16, sceneState.p2y + (sceneState.by > sceneState.p2y + 2 and 15.0 or (sceneState.by < sceneState.p2y + 1 and -15.0 or 0)) * sceneState.time.dt))" },
          { "name": "bx", "value": "sceneState.bx + sceneState.bvx * sceneState.time.dt" },
          { "name": "by", "value": "sceneState.by + sceneState.bvy * sceneState.time.dt" },
          { "name": "hit1", "value": "sceneState.bx <= 4 and sceneState.bx >= 2 and sceneState.bvx < 0 and sceneState.by >= sceneState.p1y - 1 and sceneState.by <= sceneState.p1y + 4" },
          { "name": "hit2", "value": "sceneState.bx >= 25 and sceneState.bx <= 27 and sceneState.bvx > 0 and sceneState.by >= sceneState.p2y - 1 and sceneState.by <= sceneState.p2y + 4" }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.hit1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              { "name": "bx", "value": 4 },
              { "name": "bvx", "value": "-sceneState.bvx + 1" },
              { "name": "bvy", "value": "sceneState.bvy + (sceneState.by - (sceneState.p1y + 2)) * 2" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.hit2",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              { "name": "bx", "value": 25 },
              { "name": "bvx", "value": "-sceneState.bvx - 1" },
              { "name": "bvy", "value": "sceneState.bvy + (sceneState.by - (sceneState.p2y + 2)) * 2" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.by <= 4",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              { "name": "by", "value": 4 },
              { "name": "bvy", "value": "-sceneState.bvy" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.by >= 19",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              { "name": "by", "value": 19 },
              { "name": "bvy", "value": "-sceneState.bvy" }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.bx < 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              { "name": "score2", "value": "sceneState.score2 + 1" },
              { "name": "bx", "value": 15 },
              { "name": "by", "value": 12 },
              { "name": "bvx", "value": 15 },
              { "name": "bvy", "value": 8 }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.bx > 30",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              { "name": "score1", "value": "sceneState.score1 + 1" },
              { "name": "bx", "value": 15 },
              { "name": "by", "value": 12 },
              { "name": "bvx", "value": -15 },
              { "name": "bvy", "value": 8 }
            ]
          }
        ]
      }
    ]
  },
  "goldenScript": [
    { "key": "down" },
    { "key": "down" },
    { "key": "up" },
    { "key": "return" },
    { "key": "escape" }
  ]
}
