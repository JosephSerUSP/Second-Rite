dist/

# Player save files (per-machine; written by engine/savegame.lua)
saves/
screenshots/
node_modules/

# Browser 3D backend modules are copied from node_modules at editor launch.
tools/editor/vendor/three/

# Local image-generation working files. Runtime art belongs in assets/ at its
# native game dimensions; high-resolution sources stay outside the repository.
assets/**/*_master.png
assets/portraits/source/
tools/image/*preview*.png
tmp/imagegen/
tmp/art-reference/
# Transient unsaved map snapshots passed from Studio to the LÖVE renderable
# bridge. Every request is deleted by the host after the subprocess exits; this
# ignore keeps a crash/interrupted process from dirtying authored source.
tmp/editor-renderable/

# Structured map exports are generated authoring output, not Project source.
exports/maps/*.blend

# Per-item .blend files under assets/authoring/items are authoritative source.
# Blender's numbered safety backups are workstation state, never source assets.
assets/authoring/items/*.blend[0-9]*

# Staged art from tools/asset-gen (raw model output + candidates; promote what you keep)
tools/asset-gen/out/

# Python bytecode from tools/asset-gen
__pycache__/
*.pyc

# G5 diff output: the frames a failing check-screens run actually produced,
# written next to their references for eyeballing. Disposable -- the
# references in tools/golden/screens/ are the tracked artifact.
tools/golden/screens-actual/
# Same, per non-canonical surface (#199): screens-actual-wide/ etc. The tracked
# artifact is tools/golden/screens-<surface>/.
tools/golden/screens-actual-*/

# G5 gallery output
tools/golden/gallery/
# Side-by-side galleries, including the canonical surface and per-surface
# variants (#199). Regenerated by every check-screens run, so tracking them
# would dirty the tree on each local G5.
tools/golden/screens-comparison*.html

# G6 diff output: same deal for the editor gate. The tracked artifact is
# tools/golden/editor-screens/.
tools/golden/editor-screens-actual/

# Effekseer shim build artifact (6.1MB) and its machine-local provenance.
# Rebuild both with tools/effekseer/build.ps1. A present DLL whose sidecar does
# not match tools/effekseer/efk_shim.cpp is rejected by the provenance guard.
tools/effekseer/**/*.dll
effekseer_shim.dll
effekseer_shim.dll.*
effekseer_shim.provenance.json

# Local ML venv for the depth tooling (multi-GB torch); see docs/design/image-authored-geometry.md
tools/asset-gen/.venv/

# Model census generated products. Authored source inputs and the
# checksum-pinned .census-bootstrap remain tracked.
assets/models/second_rite_census/
out/model-census-review/
docs/reports/second-rite-model-census/evaluation.json
docs/reports/second-rite-model-census/evaluation.csv
docs/reports/second-rite-model-census/all-models.md
docs/reports/second-rite-model-census/failed-models.md
docs/reports/second-rite-model-census/contact-sheet-*.png
docs/reports/second-rite-model-census/failed-models-contact-sheet.png
docs/reports/second-rite-model-census/material-swatches.png

# Local Codex review worktrees, never part of the repository.
.codex-work-*/
