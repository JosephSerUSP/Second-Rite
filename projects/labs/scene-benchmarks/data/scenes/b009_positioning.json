{
  "id": "b009_positioning",
  "terminal": {
    "reached": "v.ehp <= 0"
  },
  "name": "B009 \u2014 Parasite-Eve-Like Positioning Proof",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.0166666666666667,
    "maxCatchUp": 8
  },
  "windows": [
    {
      "id": "title",
      "rect": {
        "x": 2,
        "y": 1,
        "w": 28,
        "h": 3
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "B009 \u2014 Positioning Proof   State: {v.stateText}"
        }
      ]
    },
    {
      "id": "arena",
      "rect": {
        "x": 2,
        "y": 4,
        "w": 28,
        "h": 16
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "player",
      "rect": {
        "x": "2 + 1 + v.px",
        "y": "4 + 1 + v.py",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "@"
        }
      ]
    },
    {
      "id": "enemy",
      "rect": {
        "x": "2 + 1 + v.ex",
        "y": "4 + 1 + v.ey",
        "w": 1,
        "h": 1
      },
      "style": "panel",
      "content": [
        {
          "type": "text",
          "text": "E"
        }
      ]
    },
    {
      "id": "target_area",
      "rect": {
        "x": "2 + 1 + v.px - v.range",
        "y": "4 + 1 + v.py - v.range",
        "w": "v.range * 2 + 1",
        "h": "v.range * 2 + 1"
      },
      "style": "frame",
      "content": []
    },
    {
      "id": "atb_gauge",
      "rect": {
        "x": 2,
        "y": 20,
        "w": 14,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 12,
          "label": "ATB",
          "value": "v.atb",
          "max": "100",
          "color": [
            0.2,
            0.2,
            0.2
          ],
          "fill": [
            0.0,
            1.0,
            0.0
          ]
        }
      ]
    },
    {
      "id": "hp_gauge",
      "rect": {
        "x": 16,
        "y": 20,
        "w": 14,
        "h": 4
      },
      "style": "frame",
      "content": [
        {
          "type": "gauge",
          "x": 1,
          "y": 1,
          "width": 12,
          "label": "Enemy HP",
          "value": "v.ehp",
          "max": "100",
          "color": [
            0.2,
            0.2,
            0.2
          ],
          "fill": [
            1.0,
            0.0,
            0.0
          ]
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "px",
            "value": 10
          },
          {
            "name": "py",
            "value": 10
          },
          {
            "name": "ex",
            "value": 20
          },
          {
            "name": "ey",
            "value": 5
          },
          {
            "name": "atb",
            "value": 0
          },
          {
            "name": "ehp",
            "value": 100
          },
          {
            "name": "stateText",
            "value": "'Moving'"
          },
          {
            "name": "range",
            "value": 5
          },
          {
            "name": "speed",
            "value": 10.0
          },
          {
            "name": "mode",
            "value": "'move'"
          },
          {
            "name": "actionTimer",
            "value": 0
          },
          {
            "name": "inputX",
            "value": 0
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "IF",
        "condition": "v.mode == 'move'",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "atb",
                "value": "min(100, v.atb + 20 * time.dt)"
              },
              {
                "name": "px",
                "value": "max(0, min(25, v.px + v.inputX * v.speed * time.dt))"
              },
              {
                "name": "py",
                "value": "max(0, min(13, v.py + v.inputY * v.speed * time.dt))"
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "SET_VAR",
            "name": "actionTimer",
            "value": "v.actionTimer - time.dt"
          },
          {
            "cmd": "IF",
            "condition": "v.actionTimer <= 0",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "mode",
                    "value": "'move'"
                  },
                  {
                    "name": "stateText",
                    "value": "'Moving'"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "v.ehp <= 0",
        "then": [
          {
            "cmd": "SET_VAR",
            "name": "stateText",
            "value": "'VICTORY!'"
          }
        ]
      },
      {
        "cmd": "SET_VAR",
        "assignments": [
          {
            "name": "inputX",
            "value": 0
          },
          {
            "name": "inputY",
            "value": 0
          }
        ]
      }
    ],
    "on_up": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": -1
      }
    ],
    "on_down": [
      {
        "cmd": "SET_VAR",
        "name": "inputY",
        "value": 1
      }
    ],
    "on_left": [
      {
        "cmd": "SET_VAR",
        "name": "inputX",
        "value": -1
      }
    ],
    "on_right": [
      {
        "cmd": "SET_VAR",
        "name": "inputX",
        "value": 1
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "v.mode == 'move' and v.atb >= 100",
        "then": [
          {
            "cmd": "SET_VAR",
            "assignments": [
              {
                "name": "mode",
                "value": "'action'"
              },
              {
                "name": "atb",
                "value": 0
              },
              {
                "name": "actionTimer",
                "value": 1.0
              },
              {
                "name": "dist",
                "value": "abs(v.px - v.ex) + abs(v.py - v.ey)"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "v.dist <= v.range",
            "then": [
              {
                "cmd": "SET_VAR",
                "assignments": [
                  {
                    "name": "ehp",
                    "value": "max(0, v.ehp - 30)"
                  },
                  {
                    "name": "stateText",
                    "value": "'HIT!'"
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "SET_VAR",
                "name": "stateText",
                "value": "'MISSED! (Out of range)'"
              }
            ]
          }
        ]
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "goldenScript": [
    {
      "key": "right"
    },
    {
      "key": "right"
    },
    {
      "key": "return"
    },
    {
      "key": "left"
    },
    {
      "key": "b"
    }
  ]
}