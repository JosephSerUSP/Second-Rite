{
  "id": "title",
  "name": "Title Screen",
  "kind": "menu",
  "draw": "windows",
  "terminal": {
    "none": "title screen: a menu into the game, with no loop of its own to finish"
  },
  "windows": [
    {
      "id": "project_title",
      "rect": {
        "x": 6,
        "y": 7,
        "w": 20,
        "h": 5
      },
      "style": "frame",
      "content": [
        {
          "type": "text",
          "text": "Parasite Eve - Day 1"
        }
      ]
    },
    {
      "id": "title_menu",
      "rect": {
        "x": 9,
        "y": 14,
        "w": 14,
        "h": 5
      },
      "style": "list",
      "visibleRows": 2,
      "content": [
        {
          "type": "list",
          "listId": "term:title.options",
          "cursor": "sceneState.idx"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "idx",
        "value": 1
      }
    ],
    "on_up": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "idx",
        "value": "sceneState.idx == 1 and 2 or 1"
      }
    ],
    "on_down": [
      {
        "cmd": "SET_SCENE_STATE",
        "name": "idx",
        "value": "sceneState.idx == 1 and 2 or 1"
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.idx == 1",
        "then": [
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "day1_entrance"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.idx == 2",
        "then": [
          {
            "cmd": "QUIT_GAME"
          }
        ]
      }
    ]
  },
  "config": {}
}
