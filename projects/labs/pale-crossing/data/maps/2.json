            {
              "cmd": "CHANGE_ITEM",
              "item": "2",
              "count": 1
            },
            {
              "cmd": "TEXT",
              "text": "Opened chest! Found HP Tonic x2 and Sigil Ink x1!"
            }
          ],
          "cmd": "CONDITIONAL_BRANCH"
        }
      ]
    },
