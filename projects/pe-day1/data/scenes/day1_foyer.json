{
  "id": "day1_foyer",
  "name": "Carnegie Hall - lobby",
  "kind": "menu",
  "draw": "windows",
  "update": {
    "mode": "fixed",
    "step": 0.016666666666666666,
    "maxCatchUp": 60
  },
  "windows": [
    {
      "id": "world",
      "rect": {
        "x": "-surface.originX",
        "y": "-surface.originY",
        "w": "surface.width",
        "h": "surface.height"
      },
      "style": "modelScene",
      "chrome": "none",
      "viewport": {
        "camera": {
          "position": [
            "0",
            "-2.2",
            "5.6"
          ],
          "target": [
            "0",
            "3.2",
            "0.3"
          ],
          "fov": 78,
          "frame": {
            "size": [
              1,
              2.1
            ],
            "follow": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              1.0
            ]
          }
        },
        "background": [
          0.025,
          0.025,
          0.018
        ],
        "models": [
          {
            "id": "room",
            "model": "assets/models/rooms/foyer/environment.obj",
            "position": [
              0,
              0,
              0
            ],
            "yaw": 0,
            "visible": "true",
            "bakedLighting": true
          },
          {
            "id": "door_to_entrance",
            "model": "assets/models/blockout/door_marker.obj",
            "position": [
              0,
              0.3,
              0
            ],
            "yaw": 0,
            "visible": "sceneState.near == 'to_entrance'"
          },
          {
            "id": "door_to_auditorium",
            "model": "assets/models/blockout/door_marker.obj",
            "position": [
              0,
              5.6,
              0
            ],
            "yaw": 0,
            "visible": "sceneState.near == 'to_auditorium'"
          },
          {
            "id": "aya_shadow",
            "model": "assets/models/backstage/contact_shadow.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": 0,
            "visible": "true",
            "scale": [
              0.55,
              0.55,
              1
            ]
          },
          {
            "id": "aya",
            "model": "assets/models/aya/aya_idle.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "(sceneState.fight == 1 and rt.outcome ~= 'defeat' and rt.actAge >= 12 and (sceneState.moving == 0 or sceneState.ui > 0 or rt.outcome ~= '')) or (sceneState.fight == 0 and (sceneState.moving == 0 or sceneState.ui > 0))"
          },
          {
            "id": "aya_walk_0",
            "model": "assets/models/aya/aya_walk_0.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 0 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_1",
            "model": "assets/models/aya/aya_walk_1.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 1 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_2",
            "model": "assets/models/aya/aya_walk_2.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 2 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_3",
            "model": "assets/models/aya/aya_walk_3.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 3 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_4",
            "model": "assets/models/aya/aya_walk_4.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 4 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_5",
            "model": "assets/models/aya/aya_walk_5.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 5 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_6",
            "model": "assets/models/aya/aya_walk_6.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 6 and (sceneState.fight == 0 or rt.outcome == '')"
          },
          {
            "id": "aya_walk_7",
            "model": "assets/models/aya/aya_walk_7.obj",
            "position": [
              "(sceneState.fight == 1 and rt.player.x or sceneState.walkX)",
              "(sceneState.fight == 1 and rt.player.y or sceneState.walkY)",
              0
            ],
            "yaw": "sceneState.aim",
            "visible": "sceneState.ui == 0 and sceneState.moving == 1 and floor(sceneState.gait / 6.283185 * 8) % 8 == 7 and (sceneState.fight == 0 or rt.outcome == '')"
          }
        ]
      },
      "content": []
    },
    {
      "id": "menu_root",
      "rect": {
        "x": "1 - surface.originX",
        "y": 1,
        "w": 14,
        "h": 6
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui == 20",
      "content": [
        {
          "type": "text",
          "text": "MENU\n{sceneState.choice == 0 and '> ' or '  '}Item\n{sceneState.choice == 1 and '> ' or '  '}Equip\n{sceneState.choice == 2 and '> ' or '  '}Close"
        }
      ]
    },
    {
      "id": "menu_items",
      "rect": {
        "x": "1 - surface.originX",
        "y": 1,
        "w": 20,
        "h": 5
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui == 21",
      "content": [
        {
          "type": "text",
          "text": "ITEM\n{sceneState.choice == 0 and '> ' or '  '}Medicine    x{session.items.medicine}\n{sceneState.choice == 1 and '> ' or '  '}M84F rounds x{session.items.handgun_ammo}"
        }
      ]
    },
    {
      "id": "menu_equip",
      "rect": {
        "x": "1 - surface.originX",
        "y": 1,
        "w": 20,
        "h": 5
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui == 22",
      "content": [
        {
          "type": "text",
          "text": "EQUIP\n{sceneState.choice == 0 and '> ' or '  '}Weapon  {(variables.weapon or 'handgun') == 'baton' and 'Baton' or 'M84F'}\n{sceneState.choice == 1 and '> ' or '  '}Armor   {(sceneState.mArmor == 'kevlar_vest' and 'Kevlar Vest' or (sceneState.mArmor == 'police_vest' and 'Police Vest' or 'None'))}"
        }
      ]
    },
    {
      "id": "menu_status",
      "rect": {
        "x": "surface.width - surface.originX - 21",
        "y": 1,
        "w": 20,
        "h": 8
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui >= 20 and sceneState.ui <= 22",
      "content": [
        {
          "type": "text",
          "text": "AYA BREA\nHP  {sceneState.mHp}/{sceneState.mMax}\nPE  {sceneState.mPe}\nDEF {sceneState.mDef}\nWPN {(variables.weapon or 'handgun') == 'baton' and 'Baton' or 'M84F'}\nARM {(sceneState.mArmor == 'kevlar_vest' and 'Kevlar Vest' or (sceneState.mArmor == 'police_vest' and 'Police Vest' or 'None'))}"
        }
      ]
    },
    {
      "id": "menu_help",
      "rect": {
        "x": "1 - surface.originX",
        "y": "surface.height - surface.originY - 4",
        "w": "surface.width - 2",
        "h": 3
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui >= 20 and sceneState.ui <= 22",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.menuNote ~= '' and sceneState.menuNote or (sceneState.ui == 20 and (sceneState.choice == 0 and 'Use or inspect items.' or (sceneState.choice == 1 and 'Change weapon and armor.' or 'Back to the game.')) or (sceneState.ui == 21 and (sceneState.choice == 0 and 'Restores 30 HP.' or 'Ammunition for the M84F. The Baton needs none.') or (sceneState.choice == 0 and 'M84F: range 4, uses rounds.  Baton: range 1.5, unlimited.' or (sceneState.mArmor == 'kevlar_vest' and 'Kevlar Vest: DEF +6.' or 'Police Vest: DEF +2.'))))}"
        }
      ]
    },
    {
      "id": "card",
      "rect": {
        "x": "4 - surface.originX",
        "y": "surface.height - surface.originY - 4 - sceneState.cardLines",
        "w": "surface.width - 8",
        "h": "3 + sceneState.cardLines"
      },
      "style": "panel",
      "chrome": "overlay",
      "visible": "sceneState.ui == 9",
      "content": [
        {
          "type": "text",
          "text": "{sceneState.card}"
        }
      ]
    },
    {
      "id": "feedback",
      "rect": {
        "x": "1 - surface.originX",
        "y": "surface.height - surface.originY - 2.5",
        "w": 34,
        "h": 2
      },
      "style": "panel",
      "chrome": "none",
      "visible": "sceneState.ui ~= 9 and sceneState.fight == 1",
      "content": [
        {
          "type": "text",
          "text": "{(sceneState.fight == 1 and (rt.refusalAge < 90 and rt.refusal or sceneState.status) or '')}"
        }
      ]
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "COMMENT",
        "text": "Generated from tools/chapter/rooms.json by build_chapter.py; edit the table, not this file."
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ui",
            "value": 0
          },
          {
            "name": "choice",
            "value": 0
          },
          {
            "name": "menuHeld",
            "value": "false"
          },
          {
            "name": "gait",
            "value": 0
          },
          {
            "name": "moving",
            "value": 0
          },
          {
            "name": "dx",
            "value": 0
          },
          {
            "name": "dy",
            "value": 0
          },
          {
            "name": "ix",
            "value": 0
          },
          {
            "name": "iy",
            "value": 0
          },
          {
            "name": "held",
            "value": 0
          },
          {
            "name": "camYaw",
            "value": 0
          },
          {
            "name": "ilen",
            "value": 1
          },
          {
            "name": "range",
            "value": 4
          },
          {
            "name": "aim",
            "value": 0
          },
          {
            "name": "ratAim",
            "value": 0
          },
          {
            "name": "fight",
            "value": 0
          },
          {
            "name": "near",
            "value": "''"
          },
          {
            "name": "card",
            "value": "''"
          },
          {
            "name": "cardLines",
            "value": 1
          },
          {
            "name": "status",
            "value": "''"
          },
          {
            "name": "menuNote",
            "value": "''"
          },
          {
            "name": "mHp",
            "value": 0
          },
          {
            "name": "mMax",
            "value": 1
          },
          {
            "name": "mPe",
            "value": 0
          },
          {
            "name": "mDef",
            "value": 0
          },
          {
            "name": "mArmor",
            "value": "''"
          },
          {
            "name": "walkX",
            "value": "sceneState.walkX or 0"
          },
          {
            "name": "walkY",
            "value": "sceneState.walkY or 1"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "entryX",
            "value": "sceneState.walkX"
          },
          {
            "name": "entryY",
            "value": "sceneState.walkY"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:kit_issued",
        "then": [],
        "else": [
          {
            "cmd": "SET_FLAG",
            "flag": "kit_issued",
            "value": true
          },
          {
            "cmd": "CHANGE_ITEM",
            "item": "police_vest",
            "count": 1
          },
          {
            "cmd": "EQUIP_ITEM",
            "slot": 2,
            "target": 1,
            "itemIndex": 2
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "flag:melissa_defeated",
        "then": [
          {
            "cmd": "IF",
            "condition": "flag:visited_foyer_melissa_defeated",
            "then": [],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.card == ''",
                "then": [
                  {
                    "cmd": "SET_FLAG",
                    "flag": "visited_foyer_melissa_defeated",
                    "value": true
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "card",
                        "value": "'A paramedic patches you up\\nand hands you spare rounds.\\nHP restored. Ammo +6'"
                      },
                      {
                        "name": "cardLines",
                        "value": 3
                      }
                    ]
                  },
                  {
                    "cmd": "RECOVER_PARTY"
                  },
                  {
                    "cmd": "CHANGE_ITEM",
                    "item": "handgun_ammo",
                    "count": 6
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ui",
            "value": "sceneState.card ~= '' and 9 or 0"
          }
        ]
      }
    ],
    "on_frame": [
      {
        "cmd": "READ_INPUT",
        "name": "input"
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "ix",
            "value": "sceneState.ui == 0 and ((sceneState.input.RIGHT and 1 or 0) - (sceneState.input.LEFT and 1 or 0)) or 0"
          },
          {
            "name": "iy",
            "value": "sceneState.ui == 0 and ((sceneState.input.UP and 1 or 0) - (sceneState.input.DOWN and 1 or 0)) or 0"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.held == 0",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "camYaw",
                "value": "0"
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "held",
            "value": "(sceneState.ix ~= 0 or sceneState.iy ~= 0) and 1 or 0"
          },
          {
            "name": "ilen",
            "value": "max(1, sqrt(sceneState.ix * sceneState.ix + sceneState.iy * sceneState.iy))"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "dx",
            "value": "(sceneState.ix * cos(sceneState.camYaw) + sceneState.iy * sin(sceneState.camYaw)) / sceneState.ilen"
          },
          {
            "name": "dy",
            "value": "(sceneState.iy * cos(sceneState.camYaw) - sceneState.ix * sin(sceneState.camYaw)) / sceneState.ilen"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "moving",
            "value": "sceneState.held"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.moving == 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "gait",
                "value": "sceneState.gait + time.dt * 10"
              },
              {
                "name": "aim",
                "value": "atan2(sceneState.dx, -sceneState.dy)"
              }
            ]
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "walkX",
            "value": "max(-4.6, min(4.6, sceneState.walkX + sceneState.dx * 0.05))"
          },
          {
            "name": "walkY",
            "value": "max(0.3, min(5.6, sceneState.walkY + sceneState.dy * 0.05))"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "sceneState.input.X and not sceneState.menuHeld and sceneState.ui == 0",
        "then": [
          {
            "cmd": "SET_GAME_VARIABLE",
            "name": "weapon",
            "value": "((variables.weapon or 'handgun') == 'baton' and 'handgun' or 'baton')"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "menuHeld",
            "value": "sceneState.input.X"
          }
        ]
      },
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "near",
            "value": "''"
          },
          {
            "name": "status",
            "value": "''"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "((sceneState.walkX - (0))^2 + (sceneState.walkY - (0.3))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'to_entrance'"
              },
              {
                "name": "status",
                "value": "'Enter: Outside'"
              }
            ]
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "((sceneState.walkX - (0))^2 + (sceneState.walkY - (5.6))^2 < 0.81)",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "near",
                "value": "'to_auditorium'"
              },
              {
                "name": "status",
                "value": "'Enter: Auditorium'"
              }
            ]
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 9",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "card",
                "value": "''"
              },
              {
                "name": "ui",
                "value": 0
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.ui >= 20 and sceneState.ui <= 22",
            "then": [
              {
                "cmd": "FOR_EACH",
                "scope": "party",
                "as": "aya",
                "do": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "mHp",
                        "value": "aya.hp"
                      },
                      {
                        "name": "mMax",
                        "value": "aya.maxHp"
                      },
                      {
                        "name": "mPe",
                        "value": "aya.res.pe"
                      },
                      {
                        "name": "mDef",
                        "value": "aya.def"
                      },
                      {
                        "name": "mArmor",
                        "value": "aya.equip.armor"
                      }
                    ]
                  }
                ]
              },
              {
                "cmd": "IF",
                "condition": "sceneState.ui == 20",
                "then": [
                  {
                    "cmd": "IF",
                    "condition": "sceneState.choice == 0",
                    "then": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "assignments": [
                          {
                            "name": "ui",
                            "value": 21
                          },
                          {
                            "name": "choice",
                            "value": 0
                          },
                          {
                            "name": "menuNote",
                            "value": "''"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "sceneState.choice == 1",
                    "then": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "assignments": [
                          {
                            "name": "ui",
                            "value": 22
                          },
                          {
                            "name": "choice",
                            "value": 0
                          },
                          {
                            "name": "menuNote",
                            "value": "''"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "cmd": "IF",
                    "condition": "sceneState.choice == 2",
                    "then": [
                      {
                        "cmd": "SET_SCENE_STATE",
                        "assignments": [
                          {
                            "name": "ui",
                            "value": 0
                          },
                          {
                            "name": "menuNote",
                            "value": "''"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "cmd": "IF",
                    "condition": "sceneState.ui == 21",
                    "then": [
                      {
                        "cmd": "IF",
                        "condition": "sceneState.choice == 0",
                        "then": [
                          {
                            "cmd": "IF",
                            "condition": "session.items.medicine > 0",
                            "then": [
                              {
                                "cmd": "IF",
                                "condition": "sceneState.mHp >= sceneState.mMax",
                                "then": [
                                  {
                                    "cmd": "SET_SCENE_STATE",
                                    "assignments": [
                                      {
                                        "name": "menuNote",
                                        "value": "'HP is already full.'"
