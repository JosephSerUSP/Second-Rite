                  "flag": "ending_second_rite",
                  "value": true
                },
                {
                  "cmd": "TEXT",
                  "text": "You step past the pedestal, out across the starlit void where countless worlds intersect."
                },
                {
                  "cmd": "TEXT",
                  "text": "Your name dissolves into the foundational grammar of the Gate..."
                },
                {
