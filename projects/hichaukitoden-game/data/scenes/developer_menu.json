{
  "id": "developer_menu",
  "name": "Developer",
  "kind": "menu",
  "draw": "windows",
  "backdrop": "map",
  "windows": [
    {
      "id": "help",
      "content": [
        {
          "type": "text",
          "text": "{sel('developer_list').help}"
        }
      ]
    },
    {
      "id": "developer_list",
      "rect": {
        "x": 4,
        "y": 3,
        "w": 24,
        "h": 16.5
      },
      "style": "list",
      "visibleRows": 12,
      "title": "Developer",
      "content": [
        {
          "type": "list",
          "listId": "config:developerCommands",
          "formatRight": "{(id == 'wireframe' and (sceneState.wireframe and 'ON' or 'OFF')) or (id == 'fps' and (sceneState.fps and 'ON' or 'OFF')) or (id == 'perf' and (sceneState.perf and 'ON' or 'OFF')) or (id == 'bounds' and (sceneState.bounds and 'ON' or 'OFF')) or (id == 'server' and (sceneState.server and 'ON' or 'OFF')) or (id == 'phase' and (sceneState.phase and 'ON' or 'OFF')) or ''}",
          "cursor": "sceneState.idx"
        }
      ]
    }
  ],
  "goldenScript": [
    {
      "key": "down"
    },
    {
      "key": "up"
    },
    {
      "key": "escape"
    }
  ],
  "hooks": {
    "on_enter": [
      {
        "cmd": "SET_SCENE_STATE",
        "assignments": [
          {
            "name": "idx",
            "value": 1
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "assignments": [
          {
            "name": "_guard",
            "value": 0
          }
        ]
      },
      {
        "cmd": "SCRIPT",
        "code": "ctx.sceneState.wireframe = api.getWireframe()\nctx.sceneState.fps = api.getFpsToggle()\nctx.sceneState.perf = api.getPerfToggle()\nctx.sceneState.bounds = api.getBoundsOverlay()\nctx.sceneState.server = api.developerServerActive()\nctx.sceneState.phase = api.getPhaseMode()"
      }
    ],
    "on_up": [
      {
        "cmd": "IF",
        "condition": "sceneState.idx > 1",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "idx",
            "value": "sceneState.idx - 1"
          }
        ]
      }
    ],
    "on_down": [
      {
        "cmd": "IF",
        "condition": "sceneState.idx < 14",
        "then": [
          {
            "cmd": "SET_SCENE_STATE",
            "name": "idx",
            "value": "sceneState.idx + 1"
          }
        ]
      }
    ],
    "on_select": [
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 1",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "wireframe",
            "value": "not (sceneState.wireframe or false)"
          },
          {
            "cmd": "SCRIPT",
            "code": "api.setWireframe(ctx.sceneState.wireframe)"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 2",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "fps",
            "value": "not (sceneState.fps or false)"
          },
          {
            "cmd": "SCRIPT",
            "code": "api.setFpsToggle(ctx.sceneState.fps)"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 3",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "perf",
            "value": "not (sceneState.perf or false)"
          },
          {
            "cmd": "SCRIPT",
            "code": "api.setPerfToggle(ctx.sceneState.perf)"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 4",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "bounds",
            "value": "not (sceneState.bounds or false)"
          },
          {
            "cmd": "SCRIPT",
            "code": "api.setBoundsOverlay(ctx.sceneState.bounds)"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 5",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "developer_3d"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 6",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "pop"
          },
          {
            "cmd": "LOAD_MAP",
            "mapId": 8
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 7",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.toggleDeveloperServer()\nctx.sceneState.server = api.developerServerActive()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 8",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SET_SCENE_STATE",
            "name": "phase",
            "value": "not (sceneState.phase or false)"
          },
          {
            "cmd": "SCRIPT",
            "code": "api.setPhaseMode(ctx.sceneState.phase)"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 9",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.recoverParty()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 10",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.recoverMp()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 11",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.giveAllItems()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 12",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCRIPT",
            "code": "api.forceWinBattle()"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 13",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "push",
            "scene": "developer_geometry_export"
          }
        ]
      },
      {
        "cmd": "IF",
        "condition": "locals._guard == 0 and sceneState.idx == 14",
        "then": [
          {
            "cmd": "SET_LOCAL",
            "name": "_guard",
            "value": 1
          },
          {
            "cmd": "RESET_SESSION"
          },
          {
            "cmd": "SCENE_EVENT",
            "kind": "goto",
            "scene": "title"
          }
        ]
      },
      {
        "cmd": "SET_LOCAL",
        "name": "_guard",
        "value": 0
      }
    ],
    "on_cancel": [
      {
        "cmd": "SCENE_EVENT",
        "kind": "pop"
      }
    ]
  },
  "config": {
    "developerCommands": [
      {
        "id": "wireframe",
        "name": "WIREFRAME",
        "help": "Draw the world as triangle edges. Shows what the geometry compiler actually emitted."
      },
      {
        "id": "fps",
        "name": "SHOW FPS",
        "help": "Show the current frames-per-second counter."
      },
      {
        "id": "perf",
        "name": "PERFORMANCE STATS",
        "help": "Show draw calls, frame time, and Lua memory usage."
      },
      {
        "id": "bounds",
        "name": "TOWN NAVMESH & BOUNDS",
        "help": "Draw the 3D walkable navmesh, lane depth, collision blocks, trigger zones, and actor footprints."
      },
      {
        "id": "threed",
        "name": "3D GEOMETRY",
        "help": "Mesh density and decimation quality for image-authored geometry."
      },
      {
        "id": "devroom",
        "name": "DEVELOPER ROOM",
        "help": "Warp to the Developer Room."
      },
      {
        "id": "server",
        "name": "HOT-RELOAD SERVER",
        "help": "Toggle the editor hot-reload server. This was F9 before the developer menu took that key."
      },
      {
        "id": "phase",
        "name": "PHASE THROUGH WALLS",
        "help": "When ON, hold Control while moving to pass through walls and fixtures."
      },
      {
        "id": "recover_hp",
        "name": "RECOVER HP",
        "help": "Restore the party and revive fallen members."
      },
      {
        "id": "recover_mp",
        "name": "RECOVER MP",
        "help": "Restore the shared Summoner MP pool."
      },
      {
        "id": "all_items",
        "name": "ADD EVERY ITEM",
        "help": "Add a full testing stack of every authored item."
      },
      {
        "id": "win_battle",
        "name": "AUTO-WIN BATTLE",
        "help": "Defeat the current battle's enemies and continue through victory."
      },
      {
        "id": "export_map",
        "name": "EXPORT MAP GEOMETRY",
        "help": "Export the complete current runtime 3D world as a portable OBJ + MTL package with resolved albedo textures."
      },
      {
        "id": "title",
        "name": "TITLE SCREEN",
        "help": "Return to the title screen and reboot the session."
      }
    ]
  }
}
