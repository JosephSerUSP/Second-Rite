    "on_cancel": [
      {
        "cmd": "IF",
        "condition": "sceneState.ui == 0",
        "then": [
          {
            "cmd": "FOR_EACH",
            "scope": "party",
            "as": "aya",
            "do": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "mHp",
                    "value": "aya.hp"
                  },
                  {
                    "name": "mMax",
                    "value": "aya.maxHp"
                  },
                  {
                    "name": "mPe",
                    "value": "aya.res.pe"
                  },
                  {
                    "name": "mDef",
                    "value": "aya.def"
                  },
                  {
                    "name": "mArmor",
                    "value": "aya.equip.armor"
                  }
                ]
              }
            ]
          },
          {
            "cmd": "SET_SCENE_STATE",
            "assignments": [
              {
                "name": "ui",
                "value": 20
              },
              {
                "name": "choice",
                "value": 0
              },
              {
                "name": "menuNote",
                "value": "''"
              }
            ]
          }
        ],
        "else": [
          {
            "cmd": "IF",
            "condition": "sceneState.ui == 20",
            "then": [
              {
                "cmd": "SET_SCENE_STATE",
                "assignments": [
                  {
                    "name": "ui",
                    "value": 0
                  }
                ]
              }
            ],
            "else": [
              {
                "cmd": "IF",
                "condition": "sceneState.ui == 21 or sceneState.ui == 22",
                "then": [
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "choice",
                        "value": "sceneState.ui - 21"
                      }
                    ]
                  },
                  {
                    "cmd": "SET_SCENE_STATE",
                    "assignments": [
                      {
                        "name": "ui",
                        "value": 20
                      },
                      {
                        "name": "menuNote",
                        "value": "''"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
